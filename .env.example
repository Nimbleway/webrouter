# Credentials for the providers web-router can route to, for every method.
# A provider serving several methods needs its key set once.
# Copy to .env and fill in the ones you use: cp .env.example .env
#
# Every key is optional. A provider whose key is missing simply cannot be used,
# and its integration tests skip rather than fail.
#
# The MCP server (web-router-mcp) reads this file too, from the path in
# WEB_ROUTER_ENV_FILE, its working directory, or your user config directory:
# ~/.config/web-router/.env on Linux, ~/Library/Application Support/web-router/.env
# on macOS, %APPDATA%\web-router\.env on Windows. Only the provider keys below
# are taken from it, not CHROME_PATH. WEB_ROUTER_ENV_FILE itself belongs in the environment the
# server is started with, never in this file. See docs/mcp.md.

# Nimble - https://nimbleway.com
NIMBLE_API_KEY=

# Tavily - https://tavily.com
TAVILY_API_KEY=

# You.com - https://you.com/platform (search, research and answer)
YOU_API_KEY=

# Brave - https://brave.com/search/api/ (search; answer needs a key on the Answers plan)
BRAVE_SEARCH_API_KEY=
BRAVE_ANSWER_API_KEY=

# Exa - https://exa.ai (search, extract and answer)
EXA_API_KEY=

# Parallel - https://parallel.ai (search, research and answer)
PARALLEL_API_KEY=

# Perplexity - https://docs.perplexity.ai (search, research and answer)
PERPLEXITY_API_KEY=

# Linkup - https://www.linkup.so (search, extract, research and answer)
LINKUP_API_KEY=

# WebIQ - Microsoft AI Web Search API (search)
WEBIQ_API_KEY=

# Keenable - https://app.keenable.ai/console (search and extract)
# Optional for auto, which falls back to Keenable's keyless tier without it.
KEENABLE_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys (search and extract)
DEEPSEEK_API_KEY=

# AWS AgentCore Web Search (search) - your own gateway's URL, from docs/agentcore-setup.md.
# Not a key: requests are signed with your AWS credential (profile, role or AWS_* variables).
# Needs the aws extra.
AGENTCORE_GATEWAY_URL=

# --- extract only ----------------------------------------------------------
# These four fetch a page you name; they do not search.

# Firecrawl - https://firecrawl.dev
FIRECRAWL_API_KEY=

# Oxylabs Web Scraper API - https://oxylabs.io
# Two values, and they are the API credentials created under Web Scraper API in
# the dashboard -- not the ones you sign in with.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Bright Data Web Unlocker - https://brightdata.com
# Also two values: the zone is created in the console and has no default.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=

# Jina Reader - https://jina.ai/reader
# Optional. Reader answers without a key at 20 requests a minute; a key raises
# that rather than unlocking anything.
JINA_API_KEY=

# --- browser only ----------------------------------------------------------
# A cloud browser session, billed for as long as it is open.

# Steel - https://steel.dev
STEEL_API_KEY=

# Browserbase - https://browserbase.com
# The project is inferred from the key, so no project id is needed.
# The same key runs `browse` tasks through Browserbase Agents.
BROWSERBASE_API_KEY=

# Hyperbrowser - https://hyperbrowser.ai
HYPERBROWSER_API_KEY=

# Anchor Browser - https://anchorbrowser.io
ANCHOR_API_KEY=

# Kernel - https://kernel.sh
KERNEL_API_KEY=

# --- browse only -----------------------------------------------------------
# A hosted browser-agent task, billed per run.

# Browser Use Cloud - https://browser-use.com (browse tasks, over the v2 API)
BROWSER_USE_API_KEY=

# Skyvern - https://skyvern.com
SKYVERN_API_KEY=

# Local browser - keyless. Optional: the Chrome or Chromium to launch, when it
# is not in the usual install location or Playwright's cache.
CHROME_PATH=

# No key at all? `WebRouter()` uses `auto`, which tries the providers you do
# have a key for and otherwise falls back to the anonymous tiers: for a search,
# Tavily's keyless mode then the `you-mcp` provider; for an extract, Tavily's
# keyless mode then Jina Reader. Those are rate-limited; set a key above for
# anything beyond trying the package out.

# Optional: point the Nimble SDK at a non-default environment. Read by the
# nimble-python SDK itself, not by web-router.
# NIMBLE_BASE_URL=https://sdk.nimbleway.com

# OpenAIJudge, the default judge for evaluate(): synthesizes an answer from each
# search backend's results and grades it against the dataset's gold answer.
# Needs the `evals` extra. Not used by any search, extract, research or browser
# call, nor by web-router's OpenAI tools, which your own OpenAI client sends.
OPENAI_API_KEY=

# AnthropicJudge, the other built-in judge for evaluate(), on the same terms;
# also what benchmarks/agent/'s Claude agents run on. web-router's Anthropic
# tools never read it -- they are definitions and a local executor, sent by
# your own Anthropic client.
ANTHROPIC_API_KEY=

# --- Vendor data (generated by `make vendors` from src/web_router/data/vendors) ---
# Keys for call_vendor(): each vendor's own API, with your account. All optional.

# Adyntel - https://docs.adyntel.com/
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=

# AI Ark - https://docs.ai-ark.com
AIARK_API_KEY=

# akta.pro - https://docs.akta.pro
AKTA_API_KEY=

