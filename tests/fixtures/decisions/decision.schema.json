{
  "$defs": {
    "CoverageLabel": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": [
            "lookup",
            "synthesis",
            "research"
          ],
          "title": "Choice",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "choice",
        "confidence"
      ],
      "title": "CoverageLabel",
      "type": "object"
    },
    "DecisionLabels": {
      "additionalProperties": false,
      "description": "A decider's answer to every one of ROUTE_QUESTIONS: all four, and nothing else.",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageLabel"
        },
        "recent": {
          "$ref": "#/$defs/RecentLabel"
        },
        "tool": {
          "$ref": "#/$defs/ToolLabel"
        },
        "well_scoped": {
          "$ref": "#/$defs/WellScopedLabel"
        }
      },
      "required": [
        "tool",
        "recent",
        "coverage",
        "well_scoped"
      ],
      "title": "DecisionLabels",
      "type": "object"
    },
    "DecisionRoute": {
      "additionalProperties": false,
      "description": "What the labels turned into: the method, its chain in order, and why it is not the plain reading, if not.",
      "properties": {
        "fallback": {
          "items": {
            "enum": [
              "decider_error",
              "low_confidence",
              "no_url",
              "no_backend_for_method"
            ],
            "type": "string"
          },
          "title": "Fallback",
          "type": "array"
        },
        "method": {
          "enum": [
            "search",
            "extract",
            "research",
            "browse"
          ],
          "title": "Method",
          "type": "string"
        },
        "providers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "urls": {
          "items": {
            "type": "string"
          },
          "title": "Urls",
          "type": "array"
        }
      },
      "required": [
        "method",
        "providers"
      ],
      "title": "DecisionRoute",
      "type": "object"
    },
    "RecentLabel": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "any"
          ],
          "title": "Choice",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "choice",
        "confidence"
      ],
      "title": "RecentLabel",
      "type": "object"
    },
    "ToolLabel": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": [
            "search",
            "extract",
            "research",
            "browse"
          ],
          "title": "Choice",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "choice",
        "confidence"
      ],
      "title": "ToolLabel",
      "type": "object"
    },
    "WellScopedLabel": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": [
            "clear",
            "missing_context"
          ],
          "title": "Choice",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "choice",
        "confidence"
      ],
      "title": "WellScopedLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One routing decision, in the locked shape every decider is compared in.\n\n``labels`` and ``confidence`` are ``None`` when no decider answered: it\nfailed (``route.fallback`` says ``decider_error``), or a given URL or\nschema made asking unnecessary. Otherwise ``confidence`` is the lowest\nlabel confidence, since the route is only as sure as its least sure label.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "The minimum confidence over the four labels.",
      "title": "Confidence"
    },
    "decider_id": {
      "minLength": 1,
      "title": "Decider Id",
      "type": "string"
    },
    "decider_version": {
      "minLength": 1,
      "title": "Decider Version",
      "type": "string"
    },
    "labels": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionLabels"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/DecisionRoute"
    },
    "schema_version": {
      "const": "decision-v1",
      "default": "decision-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "labels",
    "route",
    "confidence",
    "rationale",
    "decider_id",
    "decider_version",
    "latency_ms"
  ],
  "title": "Decision",
  "type": "object"
}
