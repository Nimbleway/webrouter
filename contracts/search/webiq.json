{
  "provider": "webiq",
  "method": "search",
  "class": "web_router.providers.webiq.WebIQProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.microsoft.ai",
    "paths": {
      "search_path": "/v3/search/web"
    },
    "method": "POST",
    "auth_header": "x-apikey"
  },
  "credentials": [
    "WEBIQ_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.contentFormat": "passage",
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.maxResults": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": [
    "https://webiq.microsoft.ai/documentation/api-reference/web/",
    "https://webiq.microsoft.ai/documentation/openapi.json"
  ],
  "verified": {
    "max_results": "live: tests/providers/test_webiq.py::test_live_search_returns_passages"
  },
  "vendor_options": {
    "region": {
      "status": "passthrough",
      "note": "Two-letter country code; a candidate for the shared country option."
    },
    "language": {
      "status": "passthrough",
      "note": "ISO 639-1 code; a candidate for the shared locale option."
    },
    "location": {
      "status": "passthrough",
      "note": "lat:<float>;long:<float>."
    },
    "maxLength": {
      "status": "passthrough",
      "note": "Characters per content or passage field, up to 500000."
    },
    "safeSearch": {
      "status": "passthrough",
      "note": "off | strict."
    }
  }
}
