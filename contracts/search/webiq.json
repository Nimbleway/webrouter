{
  "provider": "webiq",
  "method": "search",
  "class": "web_router.providers.webiq.WebIQProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.microsoft.ai",
    "paths": {
      "search_path": "/v3/search/web"
    },
    "auth_header": "x-apikey"
  },
  "credentials": [
    "WEBIQ_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.contentFormat": "passage",
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.maxResults": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO"
  },
  "vendor_options": "TODO"
}
