{
  "provider": "you",
  "method": "search",
  "class": "web_router.providers.you.YouProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://ydc-index.io",
    "paths": {
      "search_path": "/v1/search"
    },
    "method": "POST",
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "YOU_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.count": 3
      }
    },
    "search_depth": {
      "lite": {
        "unchanged": "no wire change"
      },
      "fast": {
        "body.extraction.extraction_mode": "highlights"
      },
      "deep": {
        "body.extraction.extraction_mode": "full_page"
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO",
    "search_depth": "TODO"
  },
  "vendor_options": "TODO"
}
