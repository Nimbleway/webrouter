{
  "provider": "you",
  "method": "search",
  "class": "web_router.providers.you.YouProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://ydc-index.io",
    "paths": {
      "search_path": "/v1/search"
    },
    "method": "POST",
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "YOU_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.count": 3
      }
    },
    "search_depth": {
      "lite": {
        "unchanged": "no wire change"
      },
      "fast": {
        "body.extraction.extraction_mode": "highlights"
      },
      "deep": {
        "body.extraction.extraction_mode": "full_page"
      }
    },
    "include_domains": {
      "sample": {
        "body.include_domains": [
          "example.com"
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.exclude_domains": [
          "example.org"
        ]
      }
    },
    "country": {
      "sample": {
        "body.country": "US"
      }
    },
    "locale": {
      "sample": {
        "body.language": "EN"
      }
    },
    "recency": {
      "day": {
        "body.freshness": "day"
      },
      "week": {
        "body.freshness": "week"
      },
      "month": {
        "body.freshness": "month"
      },
      "year": {
        "body.freshness": "year"
      }
    }
  },
  "not_mapped": [
    "effort"
  ],
  "source": [
    "https://you.com/docs/api-reference/search/v1-search"
  ],
  "verified": {
    "max_results": "live: tests/test_integration_surface.py::test_max_results_is_an_upper_bound",
    "search_depth": "live: tests/test_integration_surface.py::test_every_depth_returns_content",
    "include_domains": "docs: https://you.com/docs/api-reference/search/v1-search (up to 500; a strict allowlist; 422 with exclude_domains, refused before the call)",
    "exclude_domains": "docs: https://you.com/docs/api-reference/search/v1-search (up to 5000)",
    "country": "docs: https://you.com/docs/api-reference/search/v1-search (36 codes; any other refused before the call)",
    "locale": "docs: https://you.com/docs/api-reference/search/v1-search (51 language tags; a locale reaches one through constants_languages.py, else refused)",
    "recency": "docs: https://you.com/docs/api-reference/search/v1-search (freshness day | week | month | year)"
  },
  "vendor_options": {
    "boost_domains": {
      "status": "passthrough",
      "note": "Up to 500 domains ranked higher without filtering; combines with exclude_domains, not include_domains (422)."
    },
    "offset": {
      "status": "passthrough",
      "note": "0-9, in multiples of count."
    },
    "safesearch": {
      "status": "passthrough",
      "note": "off | moderate (default) | strict."
    },
    "knowledge": {
      "status": "passthrough",
      "note": "core; knowledge results stay in raw."
    },
    "strict_operators": {
      "status": "passthrough",
      "note": "Boolean; enforces quoted phrases and site: exactly. No effect with highlights."
    },
    "crawl_timeout": {
      "status": "passthrough",
      "note": "1-60 seconds; full_page extraction only (422 with highlights)."
    },
    "livecrawl": {
      "status": "passthrough",
      "note": "Deprecated in favour of extraction: web | all."
    },
    "livecrawl_formats": {
      "status": "passthrough",
      "note": "Deprecated in favour of extraction.full_page.extraction_formats: html | markdown."
    }
  }
}
