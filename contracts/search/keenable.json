{
  "provider": "keenable",
  "method": "search",
  "class": "web_router.providers.keenable.KeenableProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.keenable.ai",
    "paths": {
      "public_search_path": "/v1/search/public",
      "search_path": "/v1/search"
    },
    "method": "POST",
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "KEENABLE_API_KEY"
  ],
  "keyless": "through auto, allow_keyless=True",
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.max_results": 3
      }
    },
    "search_depth": {
      "lite": {
        "body.snippet_max_length": 500
      },
      "fast": {
        "body.snippet_max_length": 3000
      },
      "deep": {
        "refused": "UnsupportedParameterError"
      }
    },
    "include_domains": {
      "sample": {
        "body.site": "example.com"
      }
    },
    "recency": {
      "day": {
        "body.published_after": "1d"
      },
      "week": {
        "body.published_after": "7d"
      },
      "month": {
        "body.published_after": "1mo"
      },
      "year": {
        "body.published_after": "1y"
      }
    },
    "effort": {
      "low": {
        "body.mode": "realtime"
      },
      "medium": {
        "unchanged": "no wire change"
      },
      "high": {
        "body.mode": "pro"
      },
      "max": {
        "body.mode": "pro"
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "locale"
  ],
  "source": [
    "https://docs.keenable.ai/api-reference/search"
  ],
  "verified": {
    "max_results": "live: tests/providers/test_keenable.py::test_live_search_returns_results",
    "search_depth": "live: tests/providers/test_keenable.py::test_live_keyless_options_shape_the_results",
    "include_domains": "live: tests/providers/test_keenable.py::test_live_keyless_options_shape_the_results",
    "recency": "live: tests/providers/test_keenable.py::test_live_keyless_effort_and_recency_reach_keenable",
    "effort": "live: tests/providers/test_keenable.py::test_live_keyless_effort_and_recency_reach_keenable"
  },
  "vendor_options": {
    "acquired_after": {
      "status": "passthrough",
      "note": "When Keenable indexed a page, not when it was published, so not recency. Date, ISO 8601 timestamp or relative delta such as 7d."
    },
    "acquired_before": {
      "status": "passthrough",
      "note": "Date, ISO 8601 timestamp or relative delta such as 7d."
    },
    "published_before": {
      "status": "passthrough",
      "note": "Date, ISO 8601 timestamp or relative delta such as 7d."
    },
    "query_time": {
      "status": "passthrough",
      "note": "A date or ISO 8601 timestamp: searches the index as it stood then. Not a recency filter."
    },
    "disable_cards": {
      "status": "passthrough",
      "note": "Boolean, default false."
    },
    "session_id": {
      "status": "passthrough",
      "note": "Up to 128 characters; also settable as the X-Keenable-Session-Id header."
    }
  }
}
