{
  "provider": "brave",
  "method": "search",
  "class": "web_router.providers.brave.BraveProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.search.brave.com",
    "paths": {
      "search_path": "/res/v1/web/search"
    },
    "method": "GET",
    "auth_header": "X-Subscription-Token"
  },
  "credentials": [
    "BRAVE_SEARCH_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "query.q": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "query.count": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO"
  },
  "vendor_options": "TODO"
}
