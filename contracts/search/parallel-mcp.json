{
  "provider": "parallel-mcp",
  "method": "search",
  "class": "web_router.providers.parallel_mcp.ParallelMcpProvider",
  "transport": {
    "kind": "mcp",
    "url": "https://search.parallel.ai",
    "tool": "web_search"
  },
  "credentials": [],
  "keyless": "always",
  "always_sent": {
    "body.id": 1,
    "body.jsonrpc": "2.0",
    "body.method": "tools/call",
    "body.params.arguments.objective": "probe query",
    "body.params.arguments.search_queries": [
      "probe query"
    ],
    "body.params.name": "web_search"
  },
  "options": {
    "max_results": {
      "sample": {
        "unchanged": "no wire change"
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO"
  },
  "vendor_options": "TODO"
}
