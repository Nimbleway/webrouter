{
  "provider": "nimble",
  "method": "search",
  "class": "web_router.providers.nimble.NimbleProvider",
  "transport": {
    "kind": "sdk"
  },
  "credentials": [
    "NIMBLE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.max_results": 3
      }
    },
    "search_depth": {
      "lite": {
        "body.search_depth": "lite"
      },
      "fast": {
        "body.search_depth": "standard"
      },
      "deep": {
        "body.full_content": true,
        "body.search_depth": "standard"
      }
    },
    "include_domains": {
      "sample": {
        "body.include_domains": [
          "example.com"
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.exclude_domains": [
          "example.org"
        ]
      }
    },
    "country": {
      "sample": {
        "body.country": "US"
      }
    },
    "locale": {
      "sample": {
        "body.locale": "en"
      }
    },
    "recency": {
      "day": {
        "body.time_range": "day"
      },
      "week": {
        "body.time_range": "week"
      },
      "month": {
        "body.time_range": "month"
      },
      "year": {
        "body.time_range": "year"
      }
    }
  },
  "not_mapped": [
    "effort"
  ],
  "source": [
    "https://docs.nimbleway.com/api-reference/search/search",
    "nimble-python Nimble.search"
  ],
  "verified": {
    "max_results": "live: tests/test_integration_surface.py::test_max_results_is_an_upper_bound",
    "search_depth": "live: tests/test_integration_surface.py::test_every_depth_returns_content",
    "include_domains": "live: tests/test_integration_surface.py::test_domain_filters_are_honored",
    "exclude_domains": "live: tests/test_integration_surface.py::test_excluded_domains_do_not_come_back",
    "country": "live: tests/test_integration_surface.py::test_country_is_accepted_as_an_iso_code",
    "locale": "live: tests/test_integration_surface.py::test_locale_is_accepted_as_a_language_code"
  },
  "vendor_options": {
    "focus": {
      "status": "passthrough",
      "note": "general | news | shopping | ..., or a list of subagent names."
    },
    "content_type": {
      "status": "passthrough",
      "note": "File types such as pdf or documents; only with focus=general."
    },
    "output_format": {
      "status": "passthrough",
      "note": "plain_text | markdown | simplified_html."
    },
    "start_date": {
      "status": "passthrough",
      "note": "YYYY-MM-DD or YYYY."
    },
    "end_date": {
      "status": "passthrough",
      "note": "YYYY-MM-DD or YYYY."
    },
    "include_answer": {
      "status": "passthrough",
      "note": "Boolean, in the nimble-python signature, not the API reference; the answer lands in SearchResponse.answer."
    },
    "deep_search": {
      "status": "passthrough",
      "note": "Deprecated alias for a depth with full page content, typed in nimble-python but absent from the API reference; web-router sends search_depth and full_content instead (search_depth='deep'). A content setting, not an effort tier."
    },
    "max_subagents": {
      "status": "passthrough",
      "note": "Caps the parallel subagents of the shopping, social and geo focus modes, and is ignored for general (SERP) focus; typed in nimble-python, not in the API reference. A fan-out limit, not an effort tier."
    },
    "safe_search": {
      "status": "passthrough",
      "note": "off | moderate | strict, in the API reference; the response echoes the level applied. nimble-python does not type it, so it goes as provider_options={'extra_body': {'safe_search': ...}}."
    }
  }
}
