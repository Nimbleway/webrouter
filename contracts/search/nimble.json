{
  "provider": "nimble",
  "method": "search",
  "class": "web_router.providers.nimble.NimbleProvider",
  "transport": {
    "kind": "sdk"
  },
  "credentials": [
    "NIMBLE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.max_results": 3
      }
    },
    "search_depth": {
      "lite": {
        "body.search_depth": "lite"
      },
      "fast": {
        "body.search_depth": "standard"
      },
      "deep": {
        "body.full_content": true,
        "body.search_depth": "standard"
      }
    },
    "include_domains": {
      "sample": {
        "body.include_domains": [
          "example.com"
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.exclude_domains": [
          "example.org"
        ]
      }
    },
    "country": {
      "sample": {
        "body.country": "US"
      }
    },
    "locale": {
      "sample": {
        "body.locale": "en"
      }
    },
    "recency": {
      "day": {
        "body.recency": "day"
      },
      "week": {
        "body.recency": "week"
      },
      "month": {
        "body.recency": "month"
      },
      "year": {
        "body.recency": "year"
      }
    },
    "effort": {
      "low": {
        "body.effort": "low"
      },
      "medium": {
        "body.effort": "medium"
      },
      "high": {
        "body.effort": "high"
      },
      "max": {
        "body.effort": "max"
      }
    }
  },
  "not_mapped": [],
  "source": [
    "https://docs.nimbleway.com/api-reference/search/search",
    "nimble-python Nimble.search"
  ],
  "verified": {
    "max_results": "live: tests/test_integration_surface.py::test_max_results_is_an_upper_bound",
    "search_depth": "live: tests/test_integration_surface.py::test_every_depth_returns_content",
    "include_domains": "live: tests/test_integration_surface.py::test_domain_filters_are_honored",
    "exclude_domains": "live: tests/test_integration_surface.py::test_excluded_domains_do_not_come_back",
    "country": "live: tests/test_integration_surface.py::test_country_is_accepted_as_an_iso_code",
    "locale": "live: tests/test_integration_surface.py::test_locale_is_accepted_as_a_language_code"
  },
  "vendor_options": {
    "focus": {
      "status": "passthrough",
      "note": "general | news | shopping | ..., or a list of subagent names."
    },
    "content_type": {
      "status": "passthrough",
      "note": "File types such as pdf or documents; only with focus=general."
    },
    "output_format": {
      "status": "passthrough",
      "note": "plain_text | markdown | simplified_html."
    },
    "time_range": {
      "status": "passthrough",
      "note": "hour | day | week | month | year; not with start_date or end_date."
    },
    "start_date": {
      "status": "passthrough",
      "note": "YYYY-MM-DD or YYYY."
    },
    "end_date": {
      "status": "passthrough",
      "note": "YYYY-MM-DD or YYYY."
    },
    "include_answer": {
      "status": "passthrough",
      "note": "Boolean, in the nimble-python signature, not the API reference; the answer lands in SearchResponse.answer."
    },
    "deep_search": {
      "status": "passthrough",
      "note": "Deprecated: use search_depth with full_content instead (deep_search=true means lite plus full_content). Typed in nimble-python, not in the API reference."
    },
    "max_subagents": {
      "status": "passthrough",
      "note": "Parallel subagents for the shopping, social and geo focus modes only; ignored for SERP focus. Typed in nimble-python, not in the API reference."
    }
  }
}
