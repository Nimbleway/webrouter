{
  "provider": "exa",
  "method": "search",
  "class": "web_router.providers.exa.ExaProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.exa.ai",
    "paths": {
      "search_path": "/search"
    },
    "auth_header": "x-api-key"
  },
  "credentials": [
    "EXA_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.contents.text": true,
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.numResults": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO"
  },
  "vendor_options": "TODO"
}
