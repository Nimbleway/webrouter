{
  "provider": "perplexity",
  "method": "search",
  "class": "web_router.providers.perplexity.PerplexityProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.perplexity.ai",
    "paths": {
      "search_path": "/search"
    },
    "method": "POST",
    "auth_header": "Authorization"
  },
  "credentials": [
    "PERPLEXITY_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.max_results": 3
      }
    },
    "search_depth": {
      "lite": {
        "body.max_tokens_per_page": 128
      },
      "fast": {
        "body.max_tokens_per_page": 1024
      },
      "deep": {
        "refused": "UnsupportedParameterError"
      }
    },
    "include_domains": {
      "sample": {
        "body.search_domain_filter": [
          "example.com"
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.search_domain_filter": [
          "-example.org"
        ]
      }
    },
    "country": {
      "sample": {
        "body.country": "US"
      }
    },
    "locale": {
      "sample": {
        "body.search_language_filter": [
          "en"
        ]
      }
    },
    "recency": {
      "day": {
        "body.search_recency_filter": "day"
      },
      "week": {
        "body.search_recency_filter": "week"
      },
      "month": {
        "body.search_recency_filter": "month"
      },
      "year": {
        "body.search_recency_filter": "year"
      }
    },
    "effort": {
      "low": {
        "body.search_type": "fast"
      },
      "medium": {
        "unchanged": "no wire change"
      },
      "high": {
        "unchanged": "no wire change"
      },
      "max": {
        "unchanged": "no wire change"
      }
    }
  },
  "not_mapped": [],
  "source": [
    "https://docs.perplexity.ai/api-reference/search-post"
  ],
  "verified": {
    "max_results": "live: tests/test_integration_surface.py::test_max_results_is_an_upper_bound",
    "include_domains": "docs: https://docs.perplexity.ai/api-reference/search-post",
    "exclude_domains": "docs: https://docs.perplexity.ai/api-reference/search-post",
    "country": "docs: https://docs.perplexity.ai/api-reference/search-post",
    "locale": "docs: https://docs.perplexity.ai/api-reference/search-post",
    "recency": "docs: https://docs.perplexity.ai/api-reference/search-post",
    "search_depth": "docs: https://docs.perplexity.ai/api-reference/search-post (lite and fast budgets not measured live; deep refused until a live call shows whole pages)",
    "effort": "docs: https://docs.perplexity.ai/api-reference/search-post"
  },
  "vendor_options": {
    "max_tokens": {
      "status": "passthrough",
      "note": "Content token budget across all results; unset, it may cap the per-page budget search_depth sets."
    },
    "search_after_date_filter": {
      "status": "passthrough",
      "note": "MM/DD/YYYY."
    },
    "search_before_date_filter": {
      "status": "passthrough",
      "note": "MM/DD/YYYY."
    },
    "last_updated_after_filter": {
      "status": "passthrough",
      "note": "MM/DD/YYYY."
    },
    "last_updated_before_filter": {
      "status": "passthrough",
      "note": "MM/DD/YYYY."
    },
    "search_type=people": {
      "status": "passthrough",
      "note": "A people vertical, not a tier; allows max_results above 20."
    },
    "search_recency_filter=hour": {
      "status": "passthrough",
      "note": "Narrower than any shared recency window."
    }
  }
}
