{
  "provider": "perplexity",
  "method": "search",
  "class": "web_router.providers.perplexity.PerplexityProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.perplexity.ai",
    "paths": {
      "search_path": "/search"
    },
    "method": "POST",
    "auth_header": "Authorization"
  },
  "credentials": [
    "PERPLEXITY_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.max_results": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ]
}
