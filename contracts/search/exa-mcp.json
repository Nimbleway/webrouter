{
  "provider": "exa-mcp",
  "method": "search",
  "class": "web_router.providers.exa_mcp.ExaMcpProvider",
  "transport": {
    "kind": "mcp",
    "url": "https://mcp.exa.ai",
    "tool": "web_search_exa"
  },
  "credentials": [],
  "keyless": "always",
  "always_sent": {
    "body.id": 1,
    "body.jsonrpc": "2.0",
    "body.method": "tools/call",
    "body.params.arguments.objective": "probe query",
    "body.params.arguments.query": "probe query",
    "body.params.name": "web_search_exa"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.params.arguments.numResults": 3
      }
    }
  },
  "not_mapped": [
    "country",
    "exclude_domains",
    "include_domains",
    "locale",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO"
  },
  "vendor_options": "TODO"
}
