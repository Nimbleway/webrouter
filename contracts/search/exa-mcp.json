{
  "provider": "exa-mcp",
  "method": "search",
  "class": "web_router.providers.exa_mcp.ExaMcpProvider",
  "transport": {
    "kind": "mcp",
    "url": "https://mcp.exa.ai",
    "tool": "web_search_advanced_exa"
  },
  "credentials": [],
  "keyless": "always",
  "always_sent": {
    "body.id": 1,
    "body.jsonrpc": "2.0",
    "body.method": "tools/call",
    "body.params.arguments.enableHighlights": true,
    "body.params.arguments.query": "probe query",
    "body.params.name": "web_search_advanced_exa",
    "query.tools": "web_search_advanced_exa"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.params.arguments.numResults": 3
      }
    },
    "search_depth": {
      "lite": {
        "body.params.arguments.highlightsMaxCharacters": 500
      },
      "fast": {
        "body.params.arguments.enableHighlights": "<removed>",
        "body.params.arguments.textMaxCharacters": 3000
      },
      "deep": {
        "body.params.arguments.enableHighlights": "<removed>"
      }
    },
    "include_domains": {
      "sample": {
        "body.params.arguments.includeDomains": [
          "example.com"
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.params.arguments.excludeDomains": [
          "example.org"
        ]
      }
    },
    "country": {
      "sample": {
        "body.params.arguments.userLocation": "US"
      }
    },
    "recency": {
      "day": {
        "body.params.arguments.startPublishedDate": "2026-01-14"
      },
      "week": {
        "body.params.arguments.startPublishedDate": "2026-01-08"
      },
      "month": {
        "body.params.arguments.startPublishedDate": "2025-12-16"
      },
      "year": {
        "body.params.arguments.startPublishedDate": "2025-01-15"
      }
    },
    "effort": {
      "low": {
        "body.params.arguments.type": "lite"
      },
      "medium": {
        "unchanged": "no wire change"
      },
      "high": {
        "unchanged": "no wire change"
      },
      "max": {
        "unchanged": "no wire change"
      }
    }
  },
  "not_mapped": [
    "locale"
  ],
  "source": [
    "https://exa.ai/docs/reference/exa-mcp",
    "web_search_advanced_exa tool, from tools/list on https://mcp.exa.ai/mcp?tools=web_search_advanced_exa (2026-11-09)"
  ],
  "verified": {
    "max_results": "live: tests/providers/test_exa_mcp.py::test_live_keyless_search_returns_results",
    "search_depth": "docs: tools/list of web_search_advanced_exa; sizes measured keyless 2026-11-09 (highlights ~1,000-4,000 characters uncapped, textMaxCharacters=3000 exactly 3,000, unset text 10,000-14,000); live: tests/providers/test_exa_mcp.py::test_live_each_depth_comes_back_at_its_size",
    "include_domains": "docs: tools/list of web_search_advanced_exa; one keyless call on 2026-11-09 with wikipedia.org returned only wikipedia.org; live: tests/providers/test_exa_mcp.py::test_live_filters_are_honoured_at_low_effort",
    "exclude_domains": "docs: tools/list of web_search_advanced_exa",
    "country": "docs: tools/list of web_search_advanced_exa (accepted keyless 2026-11-09; effect not measured)",
    "recency": "docs: tools/list of web_search_advanced_exa (accepted keyless 2026-11-09; effect not measured)",
    "effort": "docs: tools/list of web_search_advanced_exa (type=lite accepted with every filter keyless 2026-11-09)"
  },
  "vendor_options": {
    "category": {
      "status": "passthrough",
      "note": "company | publication | news | pdf | github | personal site | people | financial report."
    },
    "endPublishedDate": {
      "status": "passthrough",
      "note": "YYYY-MM-DD; recency sets only the start."
    },
    "startCrawlDate": {
      "status": "passthrough",
      "note": "YYYY-MM-DD."
    },
    "endCrawlDate": {
      "status": "passthrough",
      "note": "YYYY-MM-DD."
    },
    "includeText": {
      "status": "passthrough",
      "note": "Strings every result must contain."
    },
    "excludeText": {
      "status": "passthrough",
      "note": "Strings no result may contain."
    },
    "moderation": {
      "status": "passthrough",
      "note": "Boolean."
    },
    "additionalQueries": {
      "status": "passthrough",
      "note": "Extra query variations."
    },
    "contextMaxCharacters": {
      "status": "passthrough",
      "note": "A combined context string; it stays in raw."
    },
    "enableSummary": {
      "status": "passthrough",
      "note": "Boolean; with summaryQuery. A summary becomes the description."
    },
    "summaryQuery": {
      "status": "passthrough",
      "note": "Focus for enableSummary."
    },
    "highlightsQuery": {
      "status": "passthrough",
      "note": "Query the highlights are picked for."
    },
    "highlightsNumSentences": {
      "status": "passthrough",
      "note": "Deprecated in favour of highlightsMaxCharacters."
    },
    "highlightsPerUrl": {
      "status": "passthrough",
      "note": "Deprecated and ignored."
    },
    "maxAgeHours": {
      "status": "passthrough",
      "note": "Maximum age of cached content; 0 always fetches fresh."
    },
    "livecrawlTimeout": {
      "status": "passthrough",
      "note": "Milliseconds, with maxAgeHours."
    },
    "subpages": {
      "status": "passthrough",
      "note": "1-10 subpages per result."
    },
    "subpageTarget": {
      "status": "passthrough",
      "note": "Keywords for picking subpages."
    },
    "objective": {
      "status": "not_supported",
      "note": "Only on web_search_exa; web_search_advanced_exa refuses arguments its schema does not declare."
    }
  }
}
