{
  "provider": "deepseek",
  "method": "search",
  "class": "web_router.providers.deepseek.DeepSeekProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.deepseek.com",
    "paths": {
      "search_path": "/v1/tools/search"
    },
    "method": "POST",
    "auth_header": "Authorization"
  },
  "credentials": [
    "DEEPSEEK_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.count": 3
      }
    },
    "include_domains": {
      "sample": {
        "body.query": "probe query site:example.com"
      }
    },
    "exclude_domains": {
      "sample": {
        "body.query": "probe query -site:example.org"
      }
    },
    "locale": {
      "sample": {
        "body.query": "probe query lang:en"
      }
    }
  },
  "not_mapped": [
    "country",
    "search_depth"
  ],
  "source": "TODO",
  "verified": {
    "max_results": "TODO",
    "include_domains": "TODO",
    "exclude_domains": "TODO",
    "locale": "TODO"
  },
  "vendor_options": "TODO"
}
