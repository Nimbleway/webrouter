{
  "provider": "deepseek",
  "method": "search",
  "class": "web_router.providers.deepseek.DeepSeekProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.deepseek.com",
    "paths": {
      "search_path": "/v1/tools/search"
    },
    "method": "POST",
    "auth_header": "Authorization"
  },
  "credentials": [
    "DEEPSEEK_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.query": "probe query"
  },
  "options": {
    "max_results": {
      "sample": {
        "body.count": 3
      }
    },
    "include_domains": {
      "sample": {
        "body.query": "probe query site:example.com"
      }
    },
    "exclude_domains": {
      "sample": {
        "body.query": "probe query -site:example.org"
      }
    },
    "locale": {
      "sample": {
        "body.query": "probe query lang:en"
      }
    }
  },
  "not_mapped": [
    "country",
    "effort",
    "recency",
    "search_depth"
  ],
  "source": [
    "https://api-docs.deepseek.com/api/search",
    "https://api-docs.deepseek.com/guides/search"
  ],
  "verified": {
    "max_results": "live: tests/providers/test_deepseek.py::test_live_search_returns_results",
    "include_domains": "live: tests/providers/test_deepseek.py::test_live_site_operators_joined_by_or_keep_every_result_on_those_sites",
    "exclude_domains": "live: tests/test_integration_surface.py::test_excluded_domains_do_not_come_back",
    "locale": "live: tests/providers/test_deepseek.py::test_live_lang_operator_changes_the_language_of_the_results"
  },
  "vendor_options": {
    "need_content": {
      "status": "passthrough",
      "note": "Boolean; without it each result's content is empty."
    },
    "ori_question": {
      "status": "passthrough",
      "note": "The user's original question, up to 128 characters."
    },
    "localization": {
      "status": "passthrough",
      "note": "An IP address to localize results by."
    }
  }
}
