{
  "provider": "you",
  "method": "research",
  "class": "web_router.providers.you_research.YouResearchProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.you.com",
    "paths": {
      "research_path": "/v1/research",
      "status_path": "/v1/research/{job_id}"
    },
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "YOU_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.background": true,
    "body.input": "probe query"
  },
  "options": {
    "effort": {
      "low": {
        "body.research_effort": "lite"
      },
      "medium": {
        "body.research_effort": "standard"
      },
      "high": {
        "body.research_effort": "deep"
      },
      "max": {
        "body.research_effort": "exhaustive"
      }
    }
  },
  "not_mapped": [
    "exclude_domains",
    "include_domains",
    "output_schema",
    "records"
  ],
  "source": [
    "https://you.com/docs/api-reference/research/v1-research"
  ],
  "verified": {
    "effort": "live: tests/providers/test_you_research.py::test_live_research_answers_with_citations"
  },
  "vendor_options": {
    "source_control": {
      "status": "passthrough",
      "note": "Object of include_domains, exclude_domains, boost_domains, freshness and country; a candidate for the shared include_domains and exclude_domains."
    },
    "output_schema": {
      "status": "passthrough",
      "note": "JSON Schema subset, not with lite; the structured result stays in raw, as the shared output_schema is not mapped yet."
    }
  }
}
