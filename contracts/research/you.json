{
  "provider": "you",
  "method": "research",
  "class": "web_router.providers.you.YouResearchProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.you.com",
    "paths": {
      "research_path": "/v1/research",
      "status_path": "/v1/research/{job_id}"
    },
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "YOU_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.background": true,
    "body.input": "probe query"
  },
  "options": {
    "effort": {
      "low": {
        "body.research_effort": "lite"
      },
      "medium": {
        "body.research_effort": "standard"
      },
      "high": {
        "body.research_effort": "deep"
      },
      "max": {
        "body.research_effort": "exhaustive"
      }
    }
  },
  "not_mapped": [
    "exclude_domains",
    "include_domains",
    "output_schema",
    "records"
  ],
  "source": "TODO",
  "verified": {
    "effort": "TODO"
  },
  "vendor_options": "TODO"
}
