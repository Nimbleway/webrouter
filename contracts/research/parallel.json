{
  "provider": "parallel",
  "method": "research",
  "class": "web_router.providers.parallel.ParallelResearchProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.parallel.ai",
    "paths": {},
    "auth_header": "x-api-key"
  },
  "credentials": [
    "PARALLEL_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.input": "probe query",
    "body.processor": "core",
    "body.task_spec.output_schema.type": "text"
  },
  "options": {
    "output_schema": {
      "sample": {
        "body.task_spec.output_schema.json_schema.properties.answer.type": "string",
        "body.task_spec.output_schema.json_schema.type": "object",
        "body.task_spec.output_schema.type": "json"
      }
    },
    "effort": {
      "low": {
        "body.processor": "lite"
      },
      "medium": {
        "unchanged": "already in always_sent"
      },
      "high": {
        "body.processor": "pro"
      },
      "max": {
        "body.processor": "ultra"
      }
    }
  },
  "not_mapped": [
    "exclude_domains",
    "include_domains",
    "records"
  ],
  "source": "TODO",
  "verified": {
    "output_schema": "TODO",
    "effort": "TODO"
  },
  "vendor_options": "TODO"
}
