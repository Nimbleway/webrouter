{
  "provider": "linkup",
  "method": "research",
  "class": "web_router.providers.linkup.LinkupResearchProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.linkup.so",
    "paths": {
      "research_path": "/v1/research",
      "status_path": "/v1/research/{research_id}"
    },
    "auth_header": "Authorization"
  },
  "credentials": [
    "LINKUP_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.outputType": "sourcedAnswer",
    "body.q": "probe query"
  },
  "options": {
    "output_schema": {
      "sample": {
        "body.outputType": "structured",
        "body.structuredOutputSchema": "{\"type\": \"object\", \"properties\": {\"answer\": {\"type\": \"string\"}}}"
      }
    },
    "effort": {
      "low": {
        "body.reasoningDepth": "S"
      },
      "medium": {
        "body.reasoningDepth": "M"
      },
      "high": {
        "body.reasoningDepth": "L"
      },
      "max": {
        "body.reasoningDepth": "XL"
      }
    }
  },
  "not_mapped": [
    "exclude_domains",
    "include_domains",
    "records"
  ],
  "source": [
    "https://docs.linkup.so/pages/documentation/endpoints/research/post",
    "https://docs.linkup.so/pages/documentation/endpoints/research/get"
  ],
  "verified": {
    "output_schema": "docs: https://docs.linkup.so/pages/documentation/endpoints/research/post",
    "effort": "live: tests/providers/test_linkup_research.py::test_live_research_answers_with_citations"
  },
  "vendor_options": {
    "includeDomains": {
      "status": "passthrough",
      "note": "Same meaning as the shared include_domains; not mapped until a live run checks it."
    },
    "excludeDomains": {
      "status": "passthrough",
      "note": "Same meaning as the shared exclude_domains; not mapped until a live run checks it."
    },
    "fromDate": {
      "status": "passthrough",
      "note": "YYYY-MM-DD."
    },
    "toDate": {
      "status": "passthrough",
      "note": "YYYY-MM-DD."
    },
    "mode": {
      "status": "passthrough",
      "note": "answer | auto | investigate | research."
    }
  }
}
