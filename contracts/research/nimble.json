{
  "provider": "nimble",
  "method": "research",
  "class": "web_router.providers.nimble.NimbleResearchProvider",
  "transport": {
    "kind": "sdk"
  },
  "credentials": [
    "NIMBLE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.agent_name": "web-router-research",
    "body.input": "probe query",
    "body.use_case": "research"
  },
  "options": {
    "output_schema": {
      "sample": {
        "body.output_schema.properties.answer.type": "string",
        "body.output_schema.type": "object"
      }
    },
    "records": {
      "sample": {
        "body.agent_name": "web-router-enrichment",
        "body.input_data": [
          {
            "name": "Example"
          }
        ],
        "body.use_case": "enrichment"
      }
    },
    "effort": {
      "low": {
        "body.effort": "low"
      },
      "medium": {
        "body.effort": "medium"
      },
      "high": {
        "body.effort": "high"
      },
      "max": {
        "body.effort": "max"
      }
    },
    "include_domains": {
      "sample": {
        "body.sources.allow": [
          {
            "domains": [
              "example.com"
            ],
            "title": "web-router"
          }
        ]
      }
    },
    "exclude_domains": {
      "sample": {
        "body.sources.block": [
          {
            "domains": [
              "example.org"
            ],
            "title": "web-router"
          }
        ]
      }
    }
  },
  "not_mapped": []
}
