{
  "provider": "deepseek",
  "method": "extract",
  "class": "web_router.providers.deepseek.DeepSeekExtractProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.deepseek.com",
    "paths": {
      "extract_path": "/v1/tools/fetch"
    },
    "auth_header": "Authorization"
  },
  "credentials": [
    "DEEPSEEK_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.url": "https://example.com"
  },
  "options": {
    "format": {
      "markdown": {
        "unchanged": "already in always_sent"
      },
      "html": {
        "refused": "UnsupportedFormatError"
      },
      "text": {
        "refused": "UnsupportedFormatError"
      }
    }
  },
  "not_mapped": [],
  "default_format": "markdown",
  "batches_urls": false,
  "source": "TODO",
  "verified": {
    "format": "TODO"
  },
  "vendor_options": "TODO"
}
