{
  "provider": "oxylabs",
  "method": "extract",
  "class": "web_router.providers.oxylabs.OxylabsExtractProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://realtime.oxylabs.io",
    "paths": {
      "extract_path": "/v1/queries"
    },
    "auth_header": "Authorization"
  },
  "credentials": [
    "OXYLABS_USERNAME",
    "OXYLABS_PASSWORD"
  ],
  "keyless": null,
  "always_sent": {
    "body.markdown": true,
    "body.source": "universal",
    "body.url": "https://example.com"
  },
  "options": {
    "format": {
      "markdown": {
        "unchanged": "already in always_sent"
      },
      "html": {
        "body.markdown": "<removed>"
      },
      "text": {
        "refused": "UnsupportedFormatError"
      }
    }
  },
  "not_mapped": [],
  "default_format": "html",
  "batches_urls": false,
  "source": "TODO",
  "verified": {
    "format": "TODO"
  },
  "vendor_options": "TODO"
}
