{
  "provider": "keenable",
  "method": "extract",
  "class": "web_router.providers.keenable.KeenableExtractProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.keenable.ai",
    "paths": {
      "extract_path": "/v1/fetch",
      "public_extract_path": "/v1/fetch/public"
    },
    "method": "GET",
    "auth_header": "X-API-Key"
  },
  "credentials": [
    "KEENABLE_API_KEY"
  ],
  "keyless": "through auto, allow_keyless=True",
  "always_sent": {
    "query.max_chars": 500000,
    "query.url": "https://example.com"
  },
  "options": {
    "format": {
      "markdown": {
        "unchanged": "no wire change"
      },
      "html": {
        "refused": "UnsupportedFormatError"
      },
      "text": {
        "refused": "UnsupportedFormatError"
      }
    }
  },
  "not_mapped": [],
  "default_format": "markdown",
  "batches_urls": false
}
