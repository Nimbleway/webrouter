{
  "provider": "browser-use",
  "method": "browse",
  "class": "web_router.providers.browser_use.BrowserUseBrowseProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.browser-use.com",
    "paths": {
      "status_path": "/api/v2/tasks/{job_id}/status",
      "task_path": "/api/v2/tasks/{job_id}",
      "tasks_path": "/api/v2/tasks"
    },
    "auth_header": "X-Browser-Use-API-Key"
  },
  "credentials": [
    "BROWSER_USE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.task": "probe task"
  },
  "options": {
    "start_url": {
      "sample": {
        "body.startUrl": "https://example.com"
      }
    },
    "output_schema": {
      "sample": {
        "body.structuredOutput": "{\"type\": \"object\", \"properties\": {\"answer\": {\"type\": \"string\"}}}"
      }
    },
    "max_steps": {
      "sample": {
        "body.maxSteps": 10
      }
    },
    "allowed_domains": {
      "sample": {
        "body.allowedDomains": [
          "example.com"
        ]
      }
    },
    "mode": {
      "browser-use-gpt-5.6-luna": {
        "body.llm": "gpt-5.6-luna"
      },
      "browser-use-gemini-flash-lite-latest": {
        "body.llm": "gemini-flash-lite-latest"
      },
      "browser-use-gemini-flash-latest": {
        "body.llm": "gemini-flash-latest"
      },
      "browser-use-gemini-3-flash-preview": {
        "body.llm": "gemini-3-flash-preview"
      },
      "browser-use-o3": {
        "body.llm": "o3"
      },
      "browser-use-claude-sonnet-5": {
        "body.llm": "claude-sonnet-5"
      },
      "browser-use-claude-sonnet-4-5-20250929": {
        "body.llm": "claude-sonnet-4-5-20250929"
      },
      "browser-use-claude-opus-4-8": {
        "body.llm": "claude-opus-4-8"
      }
    }
  },
  "not_mapped": [],
  "offers": [
    "browser-use-gpt-5.6-luna",
    "browser-use-gemini-flash-lite-latest",
    "browser-use-gemini-flash-latest",
    "browser-use-gemini-3-flash-preview",
    "browser-use-o3",
    "browser-use-claude-sonnet-5",
    "browser-use-claude-sonnet-4-5-20250929",
    "browser-use-claude-opus-4-8"
  ],
  "source": [
    "https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "https://docs.browser-use.com/cloud/api-v2/tasks/get-task-status",
    "https://docs.browser-use.com/cloud/api-v2/tasks/get-task",
    "https://docs.browser-use.com/cloud/api-v2/tasks/update-task"
  ],
  "verified": {
    "start_url": "live: tests/providers/test_browser_use_browse.py::test_live_browse_answers_a_simple_task",
    "output_schema": "live: tests/providers/test_browser_use_browse.py::test_live_browse_answers_in_the_schema_within_the_step_limit",
    "max_steps": "live: tests/providers/test_browser_use_browse.py::test_live_browse_answers_in_the_schema_within_the_step_limit",
    "allowed_domains": "live: tests/providers/test_browser_use_browse.py::test_live_browse_answers_in_the_schema_within_the_step_limit",
    "mode.browser-use-gpt-5.6-luna": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-gemini-flash-lite-latest": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-gemini-flash-latest": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-gemini-3-flash-preview": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-o3": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-claude-sonnet-5": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-claude-sonnet-4-5-20250929": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task",
    "mode.browser-use-claude-opus-4-8": "docs: https://docs.browser-use.com/cloud/api-v2/tasks/create-task"
  },
  "vendor_options": {
    "sessionId": {
      "status": "passthrough",
      "note": "Runs the task in a session the caller owns; cancelling then stops the task and leaves the session running."
    },
    "metadata": {
      "status": "passthrough",
      "note": "Up to 10 key-value pairs."
    },
    "secrets": {
      "status": "passthrough",
      "note": "Credentials the agent may use; allowedDomains is recommended alongside."
    },
    "opVaultId": {
      "status": "passthrough",
      "note": "1Password vault to inject secrets from."
    },
    "sessionSettings": {
      "status": "passthrough",
      "note": "Settings for the session Browser Use creates; ignored with sessionId."
    },
    "highlightElements": {
      "status": "passthrough",
      "note": "Boolean."
    },
    "flashMode": {
      "status": "passthrough",
      "note": "Boolean."
    },
    "thinking": {
      "status": "passthrough",
      "note": "Boolean."
    },
    "thinkingLevel": {
      "status": "passthrough",
      "note": "Reasoning depth; supported values depend on the model."
    },
    "vision": {
      "status": "passthrough",
      "note": "true | false | auto."
    },
    "systemPromptExtension": {
      "status": "passthrough",
      "note": "Text appended to the agent's system prompt."
    },
    "judge": {
      "status": "passthrough",
      "note": "Boolean; evaluates completion against judgeGroundTruth."
    },
    "judgeGroundTruth": {
      "status": "passthrough",
      "note": "Expected answer for the judge."
    },
    "judgeLlm": {
      "status": "passthrough",
      "note": "The model the judge runs on."
    },
    "skillIds": {
      "status": "passthrough",
      "note": "Skills to enable; ['*'] enables all."
    }
  }
}
