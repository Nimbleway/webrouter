{
  "provider": "browser-use",
  "method": "browse",
  "class": "web_router.providers.browser_use.BrowserUseBrowseProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.browser-use.com",
    "paths": {
      "status_path": "/api/v2/tasks/{job_id}/status",
      "task_path": "/api/v2/tasks/{job_id}",
      "tasks_path": "/api/v2/tasks"
    },
    "auth_header": "X-Browser-Use-API-Key"
  },
  "credentials": [
    "BROWSER_USE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.task": "probe task"
  },
  "options": {
    "start_url": {
      "sample": {
        "body.startUrl": "https://example.com"
      }
    },
    "output_schema": {
      "sample": {
        "body.structuredOutput": "{\"type\": \"object\", \"properties\": {\"answer\": {\"type\": \"string\"}}}"
      }
    },
    "max_steps": {
      "sample": {
        "body.maxSteps": 10
      }
    },
    "allowed_domains": {
      "sample": {
        "body.allowedDomains": [
          "example.com"
        ]
      }
    }
  },
  "not_mapped": []
}
