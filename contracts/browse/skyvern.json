{
  "provider": "skyvern",
  "method": "browse",
  "class": "web_router.providers.skyvern.SkyvernBrowseProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.skyvern.com",
    "paths": {
      "cancel_path": "/v1/runs/{job_id}/cancel",
      "run_path": "/v1/runs/{job_id}",
      "start_path": "/v1/run/tasks"
    },
    "auth_header": "x-api-key"
  },
  "credentials": [
    "SKYVERN_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body.prompt": "probe task"
  },
  "options": {
    "start_url": {
      "sample": {
        "body.url": "https://example.com"
      }
    }
  },
  "not_mapped": [
    "allowed_domains",
    "max_steps",
    "output_schema"
  ]
}
