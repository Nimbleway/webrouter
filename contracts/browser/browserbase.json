{
  "provider": "browserbase",
  "method": "browser",
  "class": "web_router.providers.browserbase.BrowserbaseBrowserProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.browserbase.com",
    "paths": {
      "debug_path": "/v1/sessions/{session_id}/debug",
      "open_path": "/v1/sessions",
      "release_path": "/v1/sessions/{session_id}"
    },
    "auth_header": "X-BB-API-Key"
  },
  "credentials": [
    "BROWSERBASE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body": {}
  },
  "options": {
    "proxy_country": {
      "sample": {
        "body": "<removed>",
        "body.proxies": [
          {
            "geolocation": {
              "country": "US"
            },
            "type": "browserbase"
          }
        ]
      }
    },
    "stealth": {
      "off": {
        "refused": "UnsupportedParameterError"
      },
      "low": {
        "body": "<removed>",
        "body.browserSettings.verified": false
      },
      "high": {
        "body": "<removed>",
        "body.browserSettings.verified": true
      }
    },
    "solve_captchas": {
      "true": {
        "body": "<removed>",
        "body.browserSettings.solveCaptchas": true
      },
      "false": {
        "body": "<removed>",
        "body.browserSettings.solveCaptchas": false
      }
    },
    "profile": {
      "sample": {
        "body": "<removed>",
        "body.browserSettings.context.id": "profile-id"
      }
    },
    "persist_profile": {
      "true": {
        "body.browserSettings.context.persist": true
      },
      "false": {
        "body.browserSettings.context.persist": false
      }
    },
    "timeout": {
      "sample": {
        "body": "<removed>",
        "body.timeout": 300
      }
    }
  },
  "not_mapped": [
    "headless",
    "idle_timeout",
    "viewport"
  ]
}
