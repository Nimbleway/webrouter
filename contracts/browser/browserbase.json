{
  "provider": "browserbase",
  "method": "browser",
  "class": "web_router.providers.browserbase.BrowserbaseBrowserProvider",
  "transport": {
    "kind": "http",
    "base_url": "https://api.browserbase.com",
    "paths": {
      "debug_path": "/v1/sessions/{session_id}/debug",
      "open_path": "/v1/sessions",
      "release_path": "/v1/sessions/{session_id}"
    },
    "auth_header": "X-BB-API-Key"
  },
  "credentials": [
    "BROWSERBASE_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body": {}
  },
  "options": {
    "proxy_country": {
      "sample": {
        "body": "<removed>",
        "body.proxies": [
          {
            "geolocation": {
              "country": "US"
            },
            "type": "browserbase"
          }
        ]
      }
    },
    "stealth": {
      "off": {
        "refused": "UnsupportedParameterError"
      },
      "low": {
        "body": "<removed>",
        "body.browserSettings.verified": false
      },
      "high": {
        "body": "<removed>",
        "body.browserSettings.verified": true
      }
    },
    "solve_captchas": {
      "true": {
        "body": "<removed>",
        "body.browserSettings.solveCaptchas": true
      },
      "false": {
        "body": "<removed>",
        "body.browserSettings.solveCaptchas": false
      }
    },
    "profile": {
      "sample": {
        "body": "<removed>",
        "body.browserSettings.context.id": "profile-id"
      }
    },
    "persist_profile": {
      "true": {
        "body.browserSettings.context.persist": true
      },
      "false": {
        "body.browserSettings.context.persist": false
      }
    },
    "timeout": {
      "sample": {
        "body": "<removed>",
        "body.timeout": 300
      }
    }
  },
  "not_mapped": [
    "headless",
    "idle_timeout",
    "viewport"
  ],
  "source": [
    "https://docs.browserbase.com/reference/api/create-a-session",
    "https://docs.browserbase.com/reference/api/update-a-session"
  ],
  "verified": {
    "proxy_country": "docs: https://docs.browserbase.com/platform/identity/proxies",
    "stealth": "docs: https://docs.browserbase.com/reference/api/create-a-session",
    "solve_captchas": "docs: https://docs.browserbase.com/reference/api/create-a-session",
    "profile": "live: tests/providers/test_browserbase_browser.py::test_live_a_login_saved_to_a_context_is_there_in_the_next_session",
    "persist_profile": "live: tests/providers/test_browserbase_browser.py::test_live_a_login_saved_to_a_context_is_there_in_the_next_session",
    "timeout": "docs: https://docs.browserbase.com/reference/api/create-a-session"
  },
  "vendor_options": {
    "projectId": {
      "status": "passthrough",
      "note": "Optional; Browserbase infers the project from the key."
    },
    "extensionId": {
      "status": "passthrough",
      "note": "An uploaded extension's id."
    },
    "keepAlive": {
      "status": "passthrough",
      "note": "Boolean; keeps the session alive after the driver disconnects. Release still ends it."
    },
    "proxySettings": {
      "status": "passthrough",
      "note": "{caCertificates: [...]}: TLS certificate ids to trust."
    },
    "region": {
      "status": "passthrough",
      "note": "us-west-2 | us-east-1 | eu-central-1 | ap-southeast-1."
    },
    "userMetadata": {
      "status": "passthrough",
      "note": "Arbitrary metadata attached to the session."
    }
  }
}
