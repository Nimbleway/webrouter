{
  "provider": "kernel",
  "method": "browser",
  "class": "web_router.providers.kernel.KernelBrowserProvider",
  "transport": {
    "kind": "http",
    "method": "POST",
    "base_url": "https://api.onkernel.com",
    "paths": {
      "open_path": "/browsers",
      "release_path": "/browsers/{session_id}"
    },
    "auth_header": "Authorization"
  },
  "credentials": [
    "KERNEL_API_KEY"
  ],
  "keyless": null,
  "always_sent": {
    "body": {}
  },
  "options": {
    "stealth": {
      "off": {
        "body": "<removed>",
        "body.stealth": false
      },
      "low": {
        "body": "<removed>",
        "body.stealth": true
      },
      "high": {
        "body": "<removed>",
        "body.stealth": true
      }
    },
    "profile": {
      "sample": {
        "body": "<removed>",
        "body.profile.id": "profile-id"
      }
    },
    "persist_profile": {
      "true": {
        "body.profile.save_changes": true
      },
      "false": {
        "body.profile.save_changes": false
      }
    },
    "idle_timeout": {
      "sample": {
        "body": "<removed>",
        "body.timeout_seconds": 60
      }
    },
    "viewport": {
      "sample": {
        "body": "<removed>",
        "body.viewport.height": 720,
        "body.viewport.width": 1280
      }
    },
    "headless": {
      "true": {
        "body": "<removed>",
        "body.headless": true
      },
      "false": {
        "body": "<removed>",
        "body.headless": false
      }
    }
  },
  "not_mapped": [
    "proxy_country",
    "solve_captchas",
    "timeout"
  ],
  "source": "TODO",
  "verified": {
    "stealth": "TODO",
    "profile": "TODO",
    "persist_profile": "TODO",
    "idle_timeout": "TODO",
    "viewport": "TODO",
    "headless": "TODO"
  },
  "vendor_options": "TODO"
}
