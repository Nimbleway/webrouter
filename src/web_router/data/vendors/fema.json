{
  "vendor": "fema",
  "name": "OpenFEMA",
  "category": "other",
  "summary": "FEMA open data: disaster declarations, assistance and mitigation funding, and National Flood Insurance Program claims and policies, queryable with OData-style filters.",
  "docs_url": "https://www.fema.gov/about/openfema/api",
  "base_url": "https://www.fema.gov/api/open",
  "notes": [
    "Keyless and free.",
    "Dataset names in the path and field names in $select/$filter are case-sensitive; the filter parser is strict about spaces, quotes and case.",
    "Each dataset is versioned in the path (v1, v2, ...); a newer version can replace an older one, so check datasets.list.",
    "Paging: $top (default 1000, max 10000) with $skip; set $count=true to get the total in metadata (otherwise it reads 0)."
  ],
  "sources": [
    "https://www.fema.gov/about/openfema/api",
    "https://www.fema.gov/about/openfema/data-sets"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "fema.disasters.declarations",
      "name": "Search disaster declarations",
      "summary": "Every federally declared disaster since 1953 (major disaster, emergency, fire management) by declared area, with incident type, dates and programs declared.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/DisasterDeclarationsSummaries",
      "params": {
        "filter": {
          "in": "query",
          "type": "string",
          "description": "OData filter: eq ne gt ge lt le, and/or/not, in (...), startswith/endswith/substringof/contains; strings single-quoted, dates ISO-8601.",
          "wire_name": "$filter",
          "example": "state eq 'TX' and declarationDate ge '2024-01-01'"
        },
        "select": {
          "in": "query",
          "type": "string",
          "description": "Fields to return, comma-separated (case-sensitive).",
          "wire_name": "$select"
        },
        "orderby": {
          "in": "query",
          "type": "string",
          "description": "Sort fields, comma-separated, each optionally asc/desc.",
          "wire_name": "$orderby"
        },
        "top": {
          "in": "query",
          "type": "integer",
          "description": "Records to return; default 1000, at most 10000.",
          "wire_name": "$top"
        },
        "skip": {
          "in": "query",
          "type": "integer",
          "description": "Records to skip, for paging.",
          "wire_name": "$skip"
        },
        "count": {
          "in": "query",
          "type": "boolean",
          "description": "true to include the total matching count in metadata.",
          "wire_name": "$count"
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "Output format; default json.",
          "wire_name": "$format",
          "enum": [
            "json",
            "jsona",
            "jsonl",
            "geojson",
            "csv",
            "parquet"
          ]
        }
      },
      "job": "disasters.search",
      "docs_url": "https://www.fema.gov/openfema-data-page/disaster-declarations-summaries-v2",
      "verified": {
        "docs": "https://www.fema.gov/openfema-data-page/disaster-declarations-summaries-v2"
      }
    },
