{
  "vendor": "rubygems",
  "name": "RubyGems.org",
  "category": "developer",
  "summary": "The Ruby gem registry: gem search, metadata, versions, reverse dependencies, owners and download counts, plus recent releases.",
  "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
  "base_url": "https://rubygems.org",
  "notes": [
    "Keyless for reads. The general guideline is 10 requests per second for the API and site; a 429 may carry Retry-After. Some answers come from the CDN cache.",
    "Each path also has a .yaml form; these entries use .json.",
    "Pushing, yanking, owner changes, webhooks and API-key calls are not in this entry."
  ],
  "sites": [
    "rubygems.org"
  ],
  "sources": [
    "https://guides.rubygems.org/rubygems-org-api/",
    "https://guides.rubygems.org/rubygems-org-rate-limits/"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "rubygems.gems.search",
      "name": "Search gems",
      "summary": "Active gems matching a query, 30 per page, as on the site.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/search.json",
      "params": {
        "query": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Search text.",
          "example": "cucumber"
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page, from 1; stop at an empty answer."
        }
      },
      "job": "packages.search",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.gems.get",
      "name": "Get a gem",
      "summary": "The latest version's details: downloads, authors, info, licenses, metadata links, checksums and dependencies.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/gems/{gem}.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        }
      },
      "job": "packages.get",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.gems.versions",
      "name": "List a gem's versions",
      "summary": "Every version with its date, platform, downloads, licenses and requirements.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/versions/{gem}.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        }
      },
      "job": "packages.versions",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.gems.latest_version",
      "name": "Get a gem's latest version",
      "summary": "The latest version number of a gem.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/versions/{gem}/latest.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        }
      },
      "job": "packages.versions",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.versions.get",
      "name": "Get one version",
      "summary": "Details of a specific gem version (API v2).",
      "kind": "read",
      "method": "GET",
      "path": "/api/v2/rubygems/{gem}/versions/{version}.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        },
        "version": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Version number.",
          "example": "8.1.3.1"
        },
        "platform": {
          "in": "query",
          "type": "string",
          "description": "A non-default platform, e.g. java or x86_64-linux."
        }
      },
      "job": "packages.versions",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.gems.reverse_dependencies",
      "name": "List reverse dependencies",
      "summary": "Names of gems whose latest version depends on this gem.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/gems/{gem}/reverse_dependencies.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        },
        "only": {
          "in": "query",
          "type": "string",
          "description": "runtime or development; both by default.",
          "enum": [
            "runtime",
            "development"
          ]
        }
      },
      "job": "packages.dependents",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.gems.owners",
      "name": "List a gem's owners",
      "summary": "Users who can push the gem, with role (owner or maintainer); email only when public.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/gems/{gem}/owners.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        }
      },
      "job": "packages.get",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.downloads.version",
      "name": "Get downloads for a gem version",
      "summary": "Total downloads of the gem and of one version.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/downloads/{gem}-{version}.json",
      "params": {
        "gem": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Gem name.",
          "example": "rails"
        },
        "version": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Version number.",
          "example": "8.1.3.1"
        }
      },
      "job": "packages.downloads",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.downloads.top",
      "name": "List the most downloaded versions",
      "summary": "The 50 most downloaded gem versions with their counts.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/downloads/all.json",
      "job": "packages.downloads",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.owners.gems",
      "name": "List a user's gems",
      "summary": "Every gem a user (handle or ID) can push.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/owners/{user}/gems.json",
      "params": {
        "user": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "User handle or ID."
        }
      },
      "job": "packages.list",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.versions.timeframe",
      "name": "List versions published in a time window",
      "summary": "Gem versions created between two times, paginated.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/timeframe_versions.json",
      "params": {
        "from": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "ISO 8601 start time.",
          "example": "2026-11-01T00:00:00Z"
        },
        "to": {
          "in": "query",
          "type": "string",
          "description": "ISO 8601 end time; at most 7 days after from (default now)."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page, from 1."
        }
      },
      "job": "packages.updates",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    },
    {
      "id": "rubygems.activity.just_updated",
      "name": "List just-updated gems",
      "summary": "The 50 most recently updated gem versions.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v1/activity/just_updated",
      "job": "packages.updates",
      "docs_url": "https://guides.rubygems.org/rubygems-org-api/",
      "verified": {
        "docs": "https://guides.rubygems.org/rubygems-org-api/"
      }
    }
  ]
}
