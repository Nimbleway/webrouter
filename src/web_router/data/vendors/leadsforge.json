    {
      "id": "leadsforge.enrichment.jobs",
      "name": "List enrichment jobs",
      "summary": "Your enrichment jobs, filterable by status, channel and time.",
      "kind": "read",
      "method": "GET",
      "path": "/enrichment/jobs",
      "params": {
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Offset."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Page size."
        },
        "status": {
          "in": "query",
          "type": "string",
          "description": "Filter by status.",
          "enum": [
            "in_progress",
            "completed",
            "failed"
          ]
        },
        "channel": {
          "in": "query",
          "type": "string",
          "description": "Filter by channel.",
          "enum": [
            "email",
            "phone",
            "linkedin"
          ]
        },
        "clientRequestID": {
          "in": "query",
          "type": "string",
          "description": "Filter by your clientRequestID."
        },
        "from": {
          "in": "query",
          "type": "string",
          "description": "Created-at lower bound, RFC3339."
        },
        "to": {
          "in": "query",
          "type": "string",
          "description": "Created-at upper bound, RFC3339."
        }
      },
      "notes": [
        "limit is required, at most 100."
      ],
      "job": "jobs.list",
      "docs_url": "https://api.leadsforge.ai/public/swagger/doc.json",
      "verified": {
        "docs": "https://api.leadsforge.ai/public/swagger/doc.json"
      }
