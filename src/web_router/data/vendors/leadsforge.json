    {
      "id": "leadsforge.email.find_batch",
      "name": "Find emails for many people (job)",
      "summary": "Starts an async job that finds emails for up to 500 people.",
      "kind": "read",
      "method": "POST",
      "path": "/enrichment/emails",
      "params": {
        "personIDs": {
          "in": "body",
          "type": "array",
          "description": "Person ids from the search call. Exclusive with people."
        },
        "people": {
          "in": "body",
          "type": "array",
          "description": "Up to 500 objects, each with linkedinURL, or firstName + lastName + company; optional companyDomain and externalID. Exclusive with personIDs.",
          "example": [
            {
              "linkedinURL": "https://www.linkedin.com/in/john-doe"
            }
          ]
        },
        "clientRequestID": {
          "in": "body",
          "type": "string",
          "description": "Your own id for the request."
        },
        "webhookURL": {
          "in": "body",
          "type": "string",
          "description": "URL that gets a POST when the job completes."
        },
        "Idempotency-Key": {
          "in": "header",
          "type": "string",
          "description": "Idempotency key: a repeat with the same key returns the existing job and never charges twice.",
          "wire_name": "Idempotency-Key"
        }
      },
      "notes": [
        "A read over POST that starts a billed job; the job only produces data and reserves credits. Poll leadsforge.enrichment.job with the jobID, then read leadsforge.enrichment.results."
      ],
      "job": "people.email.find",
      "docs_url": "https://api.leadsforge.ai/public/swagger/doc.json",
      "verified": {
        "docs": "https://api.leadsforge.ai/public/swagger/doc.json"
      }
    },
