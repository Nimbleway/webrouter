    {
      "id": "leadsforge.email.find",
      "name": "Find one work email (synchronous)",
      "summary": "Looks up one person's work email and answers in the same response.",
      "kind": "read",
      "method": "POST",
      "path": "/enrichment/email",
      "params": {
        "personID": {
          "in": "body",
          "type": "string",
          "description": "A person id from the search call."
        },
        "linkedinURL": {
          "in": "body",
          "type": "string",
          "description": "LinkedIn profile URL.",
          "example": "https://www.linkedin.com/in/john-doe"
        },
        "firstName": {
          "in": "body",
          "type": "string",
          "description": "First name; use with lastName and a company signal."
        },
        "lastName": {
          "in": "body",
          "type": "string",
          "description": "Last name."
        },
        "companyDomain": {
          "in": "body",
          "type": "string",
          "description": "Company domain; preferred over company name."
        },
        "company": {
          "in": "body",
          "type": "string",
          "description": "Company name, not a URL."
        },
        "externalID": {
          "in": "body",
          "type": "string",
          "description": "Your own id, up to 128 characters, echoed back."
        }
      },
      "notes": [
        "A read over POST. 1 credit on a hit, a miss is free. Give personID, linkedinURL, or firstName + lastName + a company signal."
      ],
      "job": "people.email.find",
      "docs_url": "https://api.leadsforge.ai/public/swagger/doc.json",
      "verified": {
        "docs": "https://api.leadsforge.ai/public/swagger/doc.json"
      }
