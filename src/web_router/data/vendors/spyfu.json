      "job": "domain.keywords.paid",
      "docs_url": "https://developer.spyfu.com/reference/paidserpapi_getmostsuccessful_get",
      "verified": {
        "docs": "https://developer.spyfu.com/reference/paidserpapi_getmostsuccessful_get.md"
      }
