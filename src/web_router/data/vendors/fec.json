          "in": "query",
          "type": "string",
          "description": "Two-letter state (House and Senate)."
        },
        "district": {
          "in": "query",
          "type": "string",
          "description": "Two-digit district (House)."
        },
        "election_full": {
          "in": "query",
          "type": "boolean",
          "description": "Full election period (default true)."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, from 1."
        },
        "per_page": {
          "in": "query",
          "type": "integer",
          "description": "Results per page; default 20, at most 100."
        }
      },
      "job": "elections.finance",
      "docs_url": "https://api.open.fec.gov/developers/",
      "verified": {
        "docs": "https://api.open.fec.gov/developers/"
      }
    }
  ]
}
