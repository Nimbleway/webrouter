    },
    {
      "id": "fec.elections.get",
      "name": "Get an election's candidates and totals",
      "summary": "Financial totals of every candidate for one office and cycle.",
      "kind": "read",
      "method": "GET",
      "path": "/elections/",
      "params": {
        "office": {
          "in": "query",
