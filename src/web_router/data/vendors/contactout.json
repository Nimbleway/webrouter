    {
      "id": "contactout.email.verify_batch_result",
      "name": "Get a bulk verification job",
      "summary": "Status and results of a bulk verification.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/email/verify/batch/{job_uuid}",
      "params": {
        "job_uuid": {
