        "current_titles_only": {
          "in": "body",
          "type": "boolean",
          "description": "Default true."
        },
        "job_function": {
          "in": "body",
          "type": "array",
          "description": "Job functions, max 50."
        },
        "seniority": {
          "in": "body",
          "type": "array",
          "description": "Seniority levels, max 50."
        },
        "skills": {
          "in": "body",
          "type": "array",
          "description": "Skills, max 50; Boolean allowed."
        },
        "location": {
          "in": "body",
          "type": "array",
          "description": "Locations, max 50."
        },
        "company": {
          "in": "body",
          "type": "array",
          "description": "Current companies, max 50."
        },
        "past_company": {
          "in": "body",
          "type": "array",
          "description": "Past companies, max 50."
        },
        "domain": {
          "in": "body",
          "type": "array",
          "description": "Company domains, max 50."
        },
        "industry": {
          "in": "body",
          "type": "array",
          "description": "Industries; prefix NOT to exclude."
        },
        "keyword": {
          "in": "body",
          "type": "string",
          "description": "Keyword; Boolean allowed."
        },
        "company_size": {
          "in": "body",
          "type": "array",
          "description": "Company size buckets."
        },
        "years_of_experience": {
          "in": "body",
          "type": "array",
          "description": "Ranges formatted X_Y."
        },
        "recently_changed_jobs": {
          "in": "body",
          "type": "boolean",
          "description": "Current job began in the last 3 calendar months. Default false."
        },
        "data_types": {
          "in": "body",
          "type": "array",
          "description": "Which contact data must exist: personal_email, work_email, phone."
        },
        "reveal_info": {
          "in": "body",
          "type": "boolean",
          "description": "Reveal contact info for each profile. Default false; costs email/phone credits."
        },
        "detailed_experience": {
          "in": "body",
          "type": "boolean",
          "description": "Include detailed experience. Default false."
        },
        "detailed_education": {
          "in": "body",
          "type": "boolean",
          "description": "Include detailed education. Default false."
        }
      },
      "notes": [
        "A read over POST: nothing is changed.",
        "Rate limit 60 requests per minute.",
        "1 search credit per profile returned; with reveal_info=true, 1 email or phone credit per profile where contact info is found.",
        "Many filters not listed here (education, languages, exclusions, location radius, output_fields) are in the docs."
      ],
      "job": "people.search",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
