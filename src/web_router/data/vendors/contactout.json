{
  "vendor": "contactout",
  "name": "ContactOut",
  "category": "enrichment",
  "summary": "Find work and personal emails and phones from LinkedIn profiles, search people and companies, and verify emails.",
  "docs_url": "https://api.contactout.com/",
  "pricing_url": "https://contactout.com/pricing",
  "base_url": "https://api.contactout.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "CONTACTOUT_API_KEY"
        ],
        "description": "A ContactOut API token (ContactOut dashboard > API). Sent in the \"token\" header."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "token",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Credits come in four kinds: email, phone, search and verifier; each call note says which is charged and only on a hit.",
    "Rate limits: people search 60 per minute, contact checkers 150, everything else 1000.",
    "LinkedIn URLs must be personal profile URLs (linkedin.com/in/ or /pub/), URL-encoded in query strings.",
    "The Campaigns API (create, start, stop campaigns, add recipients) and hashed-email endpoints are not in this entry."
  ],
  "sources": [
    "https://api.contactout.com/"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "contactout.usage.stats",
      "name": "Get API usage stats",
      "summary": "Credit usage for a month.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/stats",
      "params": {
        "period": {
          "in": "query",
          "type": "string",
          "description": "Month as YYYY-MM; defaults to the current month.",
          "example": "2026-10"
        }
      },
      "job": "account.usage",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.linkedin.enrich",
      "name": "Get a profile from a LinkedIn URL",
      "summary": "Profile data, with contact info unless profile_only is true.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/linkedin/enrich",
      "params": {
        "profile": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "URL-encoded LinkedIn profile URL containing linkedin.com/in/ or /pub/ (no Sales Navigator or Recruiter URLs).",
          "example": "https://www.linkedin.com/in/example"
        },
        "profile_only": {
          "in": "query",
          "type": "boolean",
          "description": "Return profile data without contact info."
        }
      },
      "notes": [
        "Charges 1 email credit if an email is found and 1 phone credit if a phone is found; 1 search credit if profile_only=true or no contact info is found."
      ],
      "job": "people.enrich",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.email.enrich",
      "name": "Get a profile from an email address",
      "summary": "Profile for the person behind an email.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/email/enrich",
      "params": {
        "email": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Email address."
        },
        "include": {
          "in": "query",
          "type": "string",
          "description": "work_email adds real-time verification and slows the call.",
          "enum": [
            "work_email"
          ]
        }
      },
      "notes": [
        "Charges 1 email credit if an email is found and 1 phone credit if a phone is found."
      ],
      "job": "people.enrich",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.people.enrich",
      "name": "Enrich a person",
      "summary": "Match by LinkedIn URL, email, phone or name plus company, location or education.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/people/enrich",
      "params": {
        "linkedin_url": {
          "in": "body",
          "type": "string",
          "description": "LinkedIn URL (a primary identifier)."
        },
        "email": {
          "in": "body",
          "type": "string",
          "description": "Email (a primary identifier)."
        },
        "phone": {
          "in": "body",
          "type": "string",
          "description": "Phone (a primary identifier)."
        },
        "full_name": {
          "in": "body",
          "type": "string",
          "description": "Full name."
        },
        "first_name": {
          "in": "body",
          "type": "string",
          "description": "First name; use with last_name."
        },
        "last_name": {
          "in": "body",
          "type": "string",
          "description": "Last name."
        },
        "company": {
          "in": "body",
          "type": "array",
          "description": "Company names, max 10."
        },
        "company_domain": {
          "in": "body",
          "type": "array",
          "description": "Company domains, max 10."
        },
        "education": {
          "in": "body",
          "type": "array",
          "description": "Schools, max 10."
        },
        "location": {
          "in": "body",
          "type": "string",
          "description": "Location."
        },
        "job_title": {
          "in": "body",
          "type": "string",
          "description": "Job title."
        },
        "include": {
          "in": "body",
          "type": "array",
          "description": "Contact data to return: work_email, personal_email, phone. Nothing contact-related is returned unless listed.",
          "example": [
            "work_email"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed.",
        "Match needs one primary identifier, or a name plus at least one of company, location or education.",
        "Charges 1 search credit if a profile is found, 1 email credit if an email is found, 1 phone credit if a phone is found."
      ],
      "job": "people.enrich",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.people.contact_by_linkedin",
      "name": "Get contact info for a LinkedIn profile",
      "summary": "Emails and optionally phones for one LinkedIn profile.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/people/linkedin",
      "params": {
        "profile": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "URL-encoded LinkedIn profile URL containing linkedin.com/in/ or /pub/ (no Sales Navigator or Recruiter URLs).",
          "example": "https://www.linkedin.com/in/example"
        },
        "include_phone": {
          "in": "query",
          "type": "boolean",
          "description": "Also look up phones. Default false."
        },
        "email_type": {
          "in": "query",
          "type": "string",
          "description": "personal, work, \"personal,work\" or none; default both. Real-time verification runs only when work is asked for."
        }
      },
      "notes": [
        "Charges 1 email credit if an email is found and 1 phone credit if a phone is found with include_phone=true. email_type=none charges no email credit."
      ],
      "job": "people.email.find",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.people.contact_batch",
      "name": "Get contact info for up to 100 LinkedIn profiles",
      "summary": "Bulk version of contact info lookup.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/people/linkedin/batch",
      "params": {
        "profiles": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "LinkedIn URLs, max 100."
        },
        "include_phone": {
          "in": "body",
          "type": "boolean",
          "description": "Also look up phones."
        },
        "email_type": {
          "in": "body",
          "type": "string",
          "description": "personal, work, \"personal,work\" or none."
        }
      },
      "notes": [
        "A read over POST: nothing is changed.",
        "1 email credit per profile with an email found, 1 phone credit per profile with a phone found when include_phone is true."
      ],
      "job": "people.email.find",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.people.contact_batch_v2",
      "name": "Submit an asynchronous contact-info job",
      "summary": "Up to 1,000 LinkedIn profiles; guesses and verifies work emails when none is on file.",
      "kind": "read",
      "method": "POST",
      "path": "/v2/people/linkedin/batch",
      "params": {
        "profiles": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "LinkedIn URLs, max 1000."
        },
        "include_phone": {
          "in": "body",
          "type": "boolean",
          "description": "Also look up phones."
        },
        "email_type": {
          "in": "body",
          "type": "string",
          "description": "personal, work, \"personal,work\" or none."
        }
      },
      "notes": [
        "Starts a job that only produces data. Returns a status (QUEUED) and a job_id; poll contactout.people.contact_batch_v2_result.",
        "1 email credit per profile with an email found, 1 phone credit per profile with a phone found when include_phone is true."
      ],
      "job": "people.email.find",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.people.contact_batch_v2_result",
      "name": "Get an asynchronous contact-info job",
      "summary": "Poll a job started with the v2 batch call.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/people/linkedin/batch/{job_id}",
      "params": {
        "job_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "UUID returned when the job was submitted."
        }
      },
      "notes": [
        "No separate charge is documented; the job was charged per profile."
      ],
      "job": "jobs.status",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
      "id": "contactout.company.enrich",
      "name": "Get company data from domains",
      "summary": "Company profiles for up to 30 domains.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/domain/enrich",
      "params": {
        "domains": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Domains, max 30.",
          "example": [
            "example.com"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed.",
        "1 search credit per company found."
      ],
      "job": "company.enrich",
      "docs_url": "https://api.contactout.com/",
      "verified": {
        "docs": "https://api.contactout.com/"
      }
    },
    {
