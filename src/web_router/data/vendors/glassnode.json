{
  "vendor": "glassnode",
  "name": "Glassnode",
  "category": "finance",
  "summary": "On-chain and market metrics for crypto assets as time series: prices, market cap, MVRV, SOPR, active addresses, supply, exchange balances, futures open interest and funding.",
  "docs_url": "https://docs.glassnode.com/basic-api/api",
  "pricing_url": "https://glassnode.com/pricing",
  "base_url": "https://api.glassnode.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "GLASSNODE_API_KEY"
        ],
        "description": "A Glassnode API key (Studio > Settings > API). Sent in the X-Api-Key header; an api_key query parameter also works."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-Api-Key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "The full API needs a Professional subscription. Advanced subscribers get the Light API: 14 days of history, 24h resolution only, 50 calls a day.",
    "Each data call costs data credits: 1 for BTC, 2 for any other asset. Metadata calls cost none.",
    "Default limit is 600 requests/minute (x-rate-limit-* response headers); over it returns 429.",
    "Series come back as [{t, v}] with t in Unix seconds; multi-value metrics put an object in o instead of a number in v.",
    "Hundreds of metrics share one shape, GET /v1/metrics/<group>/<metric> with a, s, u, i; list them with metadata.metrics and check a metric's parameters with metadata.metric."
  ],
  "sources": [
    "https://docs.glassnode.com/basic-api/api",
    "https://docs.glassnode.com/basic-api/api-credits",
    "https://docs.glassnode.com/basic-api/api-credits-1",
    "https://docs.glassnode.com/basic-api/metadata",
    "https://docs.glassnode.com/basic-api/endpoints/market",
    "https://docs.glassnode.com/basic-api/endpoints/indicators",
    "https://docs.glassnode.com/basic-api/endpoints/addresses",
    "https://docs.glassnode.com/basic-api/endpoints/transactions",
    "https://docs.glassnode.com/basic-api/endpoints/supply",
    "https://docs.glassnode.com/basic-api/endpoints/distribution",
    "https://docs.glassnode.com/basic-api/endpoints/derivatives"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "glassnode.market.price",
      "name": "Get price history",
      "summary": "USD close price series for an asset.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/metrics/market/price_usd_close",
      "params": {
        "a": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Asset ID, e.g. BTC, ETH (see the assets metadata).",
          "example": "BTC"
        },
        "s": {
          "in": "query",
          "type": "integer",
          "description": "Since, Unix seconds.",
          "example": 1704067200
        },
        "u": {
          "in": "query",
          "type": "integer",
          "description": "Until, Unix seconds."
        },
        "i": {
          "in": "query",
          "type": "string",
          "description": "Resolution: 10m, 1h, 24h, 1w, 1month.",
          "example": "24h",
          "enum": [
            "10m",
            "1h",
            "24h",
            "1w",
            "1month"
          ]
        },
        "f": {
          "in": "query",
          "type": "string",
          "description": "json (default) or csv.",
          "enum": [
            "json",
            "csv"
          ]
        },
        "timestamp_format": {
          "in": "query",
          "type": "string",
          "description": "unix (default) or humanized (RFC 3339).",
          "enum": [
            "unix",
            "humanized"
          ]
        }
      },
      "job": "market.history",
      "docs_url": "https://docs.glassnode.com/basic-api/endpoints/market",
      "verified": {
        "docs": "https://docs.glassnode.com/basic-api/endpoints/market"
      }
    },
