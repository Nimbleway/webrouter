    {
      "id": "glassnode.metadata.assets",
      "name": "List assets",
      "summary": "Every asset with its IDs on other data providers, contract addresses, decimals and tags.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/metadata/assets",
      "params": {
        "filter": {
          "in": "query",
          "type": "string",
          "description": "CEL filter, e.g. asset.id=='USDT' or asset.semantic_tags.exists(tag,tag=='stablecoin').",
          "example": "asset.id=='USDT'"
        }
