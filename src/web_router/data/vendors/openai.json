{
  "vendor": "openai",
  "name": "OpenAI",
  "category": "ai",
  "data": "service",
  "summary": "GPT models through the Responses and Chat Completions APIs, plus embeddings, image generation, text-to-speech and moderation.",
  "docs_url": "https://developers.openai.com/api/docs",
  "pricing_url": "https://openai.com/api/pricing/",
  "base_url": "https://api.openai.com/v1",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "OPENAI_API_KEY"
        ],
        "description": "an OpenAI API key (platform.openai.com/api-keys)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "The Responses API (openai.responses.create) is OpenAI's primary text API; Chat Completions remains supported.",
    "Billed per token at each model's price, with images and audio priced separately; see the pricing page.",
    "Rate limits are set per organization and project (requests and tokens per minute and day); exceeding one returns 429."
  ],
  "sources": [
    "https://developers.openai.com/api/llms.txt",
    "https://developers.openai.com/api/reference/resources/responses/methods/create",
    "https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create",
    "https://developers.openai.com/api/reference/resources/embeddings/methods/create",
    "https://developers.openai.com/api/reference/resources/images/methods/generate",
    "https://developers.openai.com/api/reference/resources/audio/subresources/speech/methods/create",
    "https://developers.openai.com/api/reference/resources/moderations/methods/create",
    "https://developers.openai.com/api/reference/resources/models/methods/list",
    "https://developers.openai.com/api/reference/resources/models/methods/retrieve"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "openai.responses.create",
      "name": "Create a model response",
      "summary": "Generate a reply from text, image or file input, with optional built-in tools and multi-turn state.",
      "kind": "read",
      "method": "POST",
      "path": "/responses",
      "params": {
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Model id, e.g. gpt-6-astra; list them with openai.models.list.",
          "example": "gpt-6-astra"
        },
        "input": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The prompt, or an array of input messages and items.",
          "example": "Write a one-sentence bedtime story about a unicorn."
        },
        "instructions": {
          "in": "body",
          "type": "string",
          "description": "A system (developer) message placed before the input."
        },
        "max_output_tokens": {
          "in": "body",
          "type": "integer",
          "description": "Upper bound on generated tokens, reasoning included."
        },
        "temperature": {
          "in": "body",
          "type": "number",
          "description": "Sampling temperature, default 1."
        },
        "top_p": {
          "in": "body",
          "type": "number",
          "description": "Nucleus sampling, default 1."
        },
        "reasoning": {
          "in": "body",
          "type": "object",
          "description": "Options for reasoning models, e.g. {\"effort\":\"low\"}."
        },
        "text": {
          "in": "body",
          "type": "object",
          "description": "Text output options, e.g. a json_schema format for structured output."
        },
        "tools": {
          "in": "body",
          "type": "array",
          "description": "Tools the model may call: functions and built-in tools such as web search or file search."
        },
        "tool_choice": {
          "in": "body",
          "type": "string",
          "description": "How the model picks tools: none, auto, required, or a specific tool."
        },
        "previous_response_id": {
          "in": "body",
          "type": "string",
          "description": "Continue from an earlier response."
        },
        "store": {
          "in": "body",
          "type": "boolean",
          "description": "Store the response for later retrieval; default true."
        },
        "background": {
          "in": "body",
          "type": "boolean",
          "description": "Run in the background; poll the response id for the result."
        }
      },
      "notes": [
        "Do not set stream: true; this client returns one JSON body.",
        "The text is in output[] items of type message, as content parts of type output_text."
      ],
      "job": "ai.chat",
      "docs_url": "https://developers.openai.com/api/reference/resources/responses/methods/create",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/responses/methods/create"
      }
    },
    {
      "id": "openai.chat.complete",
      "name": "Create a chat completion",
      "summary": "Send a conversation to a model and get the reply (Chat Completions API).",
      "kind": "read",
      "method": "POST",
      "path": "/chat/completions",
      "params": {
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Model id.",
          "example": "gpt-6-astra"
        },
        "messages": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Conversation as {role, content} messages.",
          "example": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        },
        "max_completion_tokens": {
          "in": "body",
          "type": "integer",
          "description": "Upper bound on generated tokens, reasoning included."
        },
        "temperature": {
          "in": "body",
          "type": "number",
          "description": "Sampling temperature, default 1."
        },
        "top_p": {
          "in": "body",
          "type": "number",
          "description": "Nucleus sampling, default 1."
        },
        "reasoning_effort": {
          "in": "body",
          "type": "string",
          "description": "Reasoning effort for reasoning models; default medium."
        },
        "response_format": {
          "in": "body",
          "type": "object",
          "description": "{\"type\":\"json_object\"} or a json_schema format."
        },
        "tools": {
          "in": "body",
          "type": "array",
          "description": "Function tools the model may call."
        },
        "tool_choice": {
          "in": "body",
          "type": "string",
          "description": "none, auto, required, or a named function."
        },
        "stop": {
          "in": "body",
          "type": "array",
          "description": "Stop sequences."
        },
        "seed": {
          "in": "body",
          "type": "integer",
          "description": "Best-effort deterministic sampling."
        },
        "n": {
          "in": "body",
          "type": "integer",
          "description": "Number of choices; default 1."
        },
        "web_search_options": {
          "in": "body",
          "type": "object",
          "description": "Web search options, for search-enabled models."
        }
      },
      "notes": [
        "Do not set stream: true; this client returns one JSON body."
      ],
      "job": "ai.chat",
      "docs_url": "https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create"
      }
    },
    {
      "id": "openai.embeddings.create",
      "name": "Create embeddings",
      "summary": "Embed text into vectors.",
      "kind": "read",
      "method": "POST",
      "path": "/embeddings",
      "params": {
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Embedding model: text-embedding-3-small, text-embedding-3-large or text-embedding-ada-002.",
          "example": "text-embedding-3-small"
        },
        "input": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Text or list of texts to embed.",
          "example": [
            "The food was delicious."
          ]
        },
        "dimensions": {
          "in": "body",
          "type": "integer",
          "description": "Output dimensions (text-embedding-3 models only)."
        },
        "encoding_format": {
          "in": "body",
          "type": "string",
          "description": "float (default) or base64.",
          "enum": [
            "float",
            "base64"
          ]
        }
      },
      "notes": [
        "A read over POST."
      ],
      "job": "ai.embeddings",
      "docs_url": "https://developers.openai.com/api/reference/resources/embeddings/methods/create",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/embeddings/methods/create"
      }
    },
    {
      "id": "openai.images.generate",
      "name": "Generate an image",
      "summary": "Create images from a text prompt.",
      "kind": "read",
      "method": "POST",
      "path": "/images/generations",
      "params": {
        "prompt": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Description of the image.",
          "example": "A watercolor lighthouse at dawn"
        },
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Image model, e.g. gpt-image-2, gpt-image-1.5, gpt-image-1-mini.",
          "example": "gpt-image-2"
        },
        "size": {
          "in": "body",
          "type": "string",
          "description": "Size such as 1024x1024 or 1536x1024, or auto (default); newer models accept other WIDTHxHEIGHT values."
        },
        "quality": {
          "in": "body",
          "type": "string",
          "description": "low, medium, high or auto (default)."
        },
        "n": {
          "in": "body",
          "type": "integer",
          "description": "Number of images; default 1."
        },
        "background": {
          "in": "body",
          "type": "string",
          "description": "transparent, opaque or auto.",
          "enum": [
            "transparent",
            "opaque",
            "auto"
          ]
        },
        "output_format": {
          "in": "body",
          "type": "string",
          "description": "png (default), webp or jpeg, among others."
        }
      },
      "notes": [
        "GPT image models return base64 in data[].b64_json, so responses are large; response_format url is not supported for them.",
        "Billed per image by size and quality; a read in that it changes nothing, but it spends money."
      ],
      "job": "ai.image.generate",
      "docs_url": "https://developers.openai.com/api/reference/resources/images/methods/generate",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/images/methods/generate"
      }
    },
    {
      "id": "openai.speech.generate",
      "name": "Generate speech from text",
      "summary": "Text-to-speech, returned as an audio file.",
      "kind": "read",
      "method": "POST",
      "path": "/audio/speech",
      "params": {
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Speech model: gpt-4o-mini-tts, tts-1 or tts-1-hd.",
          "example": "gpt-4o-mini-tts"
        },
        "input": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Text to speak."
        },
        "voice": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "A built-in voice such as alloy, ash or ballad, or a custom voice id.",
          "example": "alloy"
        },
        "instructions": {
          "in": "body",
          "type": "string",
          "description": "How to speak (tone, pace); not for tts-1 or tts-1-hd."
        },
        "response_format": {
          "in": "body",
          "type": "string",
          "description": "Audio format; default mp3 (opus, aac and others available)."
        },
        "speed": {
          "in": "body",
          "type": "number",
          "description": "Speaking speed; default 1."
        }
      },
      "notes": [
        "The response body is the audio bytes, not JSON."
      ],
      "job": "ai.speech.generate",
      "docs_url": "https://developers.openai.com/api/reference/resources/audio/subresources/speech/methods/create",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/audio/subresources/speech/methods/create"
      }
    },
    {
      "id": "openai.moderations.create",
      "name": "Moderate text or images",
      "summary": "Classify text or images for harmful content.",
      "kind": "read",
      "method": "POST",
      "path": "/moderations",
      "params": {
        "input": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Text, list of texts, or image and text items to classify.",
          "example": [
            "I want to hug you."
          ]
        },
        "model": {
          "in": "body",
          "type": "string",
          "description": "Moderation model; default omni-moderation-latest."
        }
      },
      "notes": [
        "A read over POST."
      ],
      "docs_url": "https://developers.openai.com/api/reference/resources/moderations/methods/create",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/moderations/methods/create"
      }
    },
    {
      "id": "openai.models.list",
      "name": "List models",
      "summary": "Models available to the key.",
      "kind": "read",
      "method": "GET",
      "path": "/models",
      "params": {},
      "job": "ai.models",
      "docs_url": "https://developers.openai.com/api/reference/resources/models/methods/list",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/models/methods/list"
      }
    },
    {
      "id": "openai.models.get",
      "name": "Get a model",
      "summary": "Basic information about one model.",
      "kind": "read",
      "method": "GET",
      "path": "/models/{model}",
      "params": {
        "model": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Model id.",
          "example": "gpt-6-astra"
        }
      },
      "job": "ai.models",
      "docs_url": "https://developers.openai.com/api/reference/resources/models/methods/retrieve",
      "verified": {
        "docs": "https://developers.openai.com/api/reference/resources/models/methods/retrieve"
      }
    }
  ]
}
