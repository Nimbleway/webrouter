          "in": "query",
          "type": "string",
          "required": true,
          "description": "City and state (or ZIP) line.",
          "example": "SMYRNA, DE"
        }
      },
      "job": "property.tax",
      "docs_url": "https://api.developer.attomdata.com/docs",
      "verified": {
        "docs": "https://api.developer.attomdata.com/swagger/spec/propertyapi-valuationv1.json"
      }
    },
    {
      "id": "attom.avm.detail",
      "name": "Get a property's automated valuation",
      "summary": "Property details with ATTOM's cascaded automated valuation (AVM) and its confidence score.",
      "kind": "read",
      "method": "GET",
      "path": "/attomavm/detail",
      "params": {
        "address1": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Street line of the address.",
          "example": "4529 Winona Court"
        },
        "address2": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "City and state (or ZIP) line.",
          "example": "Denver, CO"
        }
      },
      "notes": [
        "The scr field is the confidence score of the valuation; it drops when the property's own characteristics are missing."
      ],
      "job": "property.valuation",
      "docs_url": "https://api.developer.attomdata.com/docs",
      "verified": {
        "docs": "https://api.developer.attomdata.com/swagger/spec/propertyapi-valuationv1.json"
      }
    },
    {
      "id": "attom.valuation.rentalavm",
