          "example": "4529 Winona Court"
        },
        "address2": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "City and state (or ZIP) line.",
          "example": "Denver, CO"
        }
      },
      "job": "property.permits",
      "docs_url": "https://api.developer.attomdata.com/docs",
      "verified": {
        "docs": "https://api.developer.attomdata.com/swagger/spec/propertyapi_propertv1.json"
      }
    },
    {
      "id": "attom.assessment.detail",
      "name": "Get a property's tax assessment",
      "summary": "Property and assessment details (assessed values and taxes) for one address.",
      "kind": "read",
      "method": "GET",
      "path": "/assessment/detail",
      "params": {
        "address1": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Street line of the address.",
          "example": "468 SEQUOIA DR"
