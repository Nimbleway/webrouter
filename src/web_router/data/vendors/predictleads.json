    {
      "id": "predictleads.jobs.discover",
      "name": "Discover job openings",
      "summary": "Openings across companies by O*NET occupation code, title, seniority and company location; last year only.",
      "kind": "read",
      "method": "GET",
      "path": "/discover/job_openings",
      "params": {
        "onet_codes": {
          "in": "query",
          "type": "array",
          "description": "Comma-separated O*NET codes."
        },
        "location": {
          "in": "query",
          "type": "string",
          "description": "Only results in this country name or state name/abbreviation.",
          "example": "United States"
        },
        "active_only": {
          "in": "query",
          "type": "boolean",
          "description": "Only openings that are not closed and seen in the last 5 days."
        },
        "found_at_from": {
          "in": "query",
          "type": "string",
          "description": "Only openings found after this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "seniority": {
          "in": "query",
          "type": "string",
          "description": "Seniority of the opening.",
          "enum": [
            "not_set",
            "founder",
            "c_level",
            "partner",
            "president",
            "vice_president",
            "head",
            "director",
            "manager",
            "mid_senior",
            "junior"
          ]
        },
        "title": {
          "in": "query",
          "type": "string",
          "description": "Titles containing all of these words.",
          "example": "product manager"
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1. Without it the meta count is left out of the answer."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, default 30, max 1000."
        }
      },
      "notes": [
        "Costs 1 credit per record.",
        "Returns an estimated total count."
      ],
      "job": "jobs.search",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
