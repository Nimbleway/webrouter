    {
      "id": "predictleads.jobs.company",
      "name": "Get a company's job openings",
      "summary": "Job openings sourced from the company's own site.",
      "kind": "read",
      "method": "GET",
      "path": "/companies/{company_id_or_domain}/job_openings",
      "params": {
        "company_id_or_domain": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Company's id or domain.",
          "example": "stripe.com"
        },
        "active_only": {
          "in": "query",
          "type": "boolean",
          "description": "Only openings not closed, seen in the last 5 days and found in the last year."
        },
        "not_closed": {
          "in": "query",
          "type": "boolean",
          "description": "Like active_only without the last_seen_at condition."
        },
        "location": {
          "in": "query",
          "type": "string",
          "description": "Only results in this country name or state name/abbreviation.",
          "example": "United States"
        },
        "first_seen_at_from": {
          "in": "query",
          "type": "string",
          "description": "Only openings first seen after this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "first_seen_at_until": {
          "in": "query",
          "type": "string",
          "description": "Only openings first seen before this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "last_seen_at_from": {
          "in": "query",
          "type": "string",
          "description": "Only openings last seen after this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "last_seen_at_until": {
          "in": "query",
          "type": "string",
          "description": "Only openings last seen before this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "with_description_only": {
          "in": "query",
          "type": "boolean",
          "description": "Only openings with a description."
        },
        "with_location_only": {
          "in": "query",
          "type": "boolean",
          "description": "Only openings with a location."
        },
        "categories": {
          "in": "query",
          "type": "array",
          "description": "Comma-separated categories, such as sales, engineering, marketing, software_development.",
          "example": "sales,engineering"
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1. Without it the meta count is left out of the answer."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, default 100, max 1000."
        }
      },
      "notes": [
        "Costs 1 credit per call."
      ],
      "job": "jobs.search",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
