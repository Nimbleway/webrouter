{
  "vendor": "predictleads",
  "name": "PredictLeads",
  "category": "company-data",
  "data": "public",
  "summary": "Company intelligence: job openings, technology detections, news and financing events, connections and more for 120M+ companies.",
  "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
  "pricing_url": "https://www.predictleads.com/pricing",
  "base_url": "https://predictleads.com/api/v3",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "PREDICTLEADS_API_KEY"
        ],
        "description": "a PredictLeads API key (Your Subscription Plans page in the PredictLeads dashboard)"
      },
      "api_token": {
        "env": [
          "PREDICTLEADS_API_TOKEN"
        ],
        "description": "the PredictLeads API token that goes with the key (same page)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-Api-Key",
        "value": "{api_key}"
      },
      {
        "in": "header",
        "name": "X-Api-Token",
        "value": "{api_token}"
      }
    ]
  },
  "notes": [
    "Plan-based monthly request limits; each call costs credits (shown per endpoint) and the X-Credits-Used response header says how many. At the limit every call answers 402.",
    "Lists are paginated with page and limit; send page to get meta.count in the answer. Array filters are comma-separated strings.",
    "Company is identified by its id or by domain.",
    "The Follow and Unfollow endpoints (which drive webhook delivery) are not listed. v4 beta docs exist separately."
  ],
  "sources": [
    "https://docs.predictleads.com/v3/api_endpoints"
  ],
  "endpoints": [
    {
      "id": "predictleads.subscription.get",
      "name": "Get API subscription",
      "summary": "Subscription status, monthly credit limit and usage.",
      "kind": "read",
      "method": "GET",
      "path": "/api_subscription",
      "notes": [
        "Costs nothing (free)."
      ],
      "job": "account.usage",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
    },
    {
      "id": "predictleads.request_logs.list",
      "name": "List API request logs",
      "summary": "Your own API request log entries.",
      "kind": "read",
      "method": "GET",
      "path": "/api_request_logs",
      "params": {
        "requested_at_from": {
          "in": "query",
          "type": "string",
          "description": "Only requests made after this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "requested_at_until": {
          "in": "query",
          "type": "string",
          "description": "Only requests made before this date (ISO 8601).",
          "example": "2024-09-25"
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1. Without it the meta count is left out of the answer."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, default 100, max 1000."
        }
      },
      "notes": [
        "Costs nothing (free)."
      ],
      "job": "account.usage",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
    },
    {
      "id": "predictleads.followings.list",
      "name": "List followed companies",
      "summary": "Companies you follow for webhook delivery.",
      "kind": "read",
      "method": "GET",
      "path": "/followings",
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1. Without it the meta count is left out of the answer."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, default 100, max 1000."
        }
      },
      "notes": [
        "Costs 1 credit per call."
      ],
      "job": "company.search",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
    },
    {
      "id": "predictleads.company.get",
      "name": "Get a company",
      "summary": "Company profile: name, description, location, ticker, language.",
      "kind": "read",
      "method": "GET",
      "path": "/companies/{id_or_domain}",
      "params": {
        "id_or_domain": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Company's id or domain.",
          "example": "stripe.com"
        }
      },
      "notes": [
        "Costs 1 credit per call."
      ],
      "job": "company.enrich",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
    },
    {
      "id": "predictleads.companies.discover",
      "name": "Discover companies",
      "summary": "Companies filtered by location, size, NAICS code, industry and revenue, ordered by last update.",
      "kind": "read",
      "method": "GET",
      "path": "/discover/companies",
      "params": {
        "location": {
          "in": "query",
          "type": "string",
          "description": "Only results in this country name or state name/abbreviation.",
          "example": "United States"
        },
        "sizes": {
          "in": "query",
          "type": "array",
          "description": "Company sizes, comma-separated: 1, 2-10, 11-50, 51-200, 201-500, 501-1000, 1001-5000, 5001-10000, 10001+.",
          "example": "1,2-10,11-50"
        },
        "naics_codes": {
          "in": "query",
          "type": "array",
          "description": "NAICS codes, comma-separated."
        },
        "industry": {
          "in": "query",
          "type": "string",
          "description": "One industry name from PredictLeads' list of 494 (for example 'Advertising Services')."
        },
        "revenue_range_low": {
          "in": "query",
          "type": "integer",
          "description": "Only companies with revenue at or above this.",
          "example": 1000000
        },
        "revenue_range_high": {
          "in": "query",
          "type": "integer",
          "description": "Only companies with revenue at or below this.",
          "example": 100000000
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1. Without it the meta count is left out of the answer."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, default 30, max 1000."
        }
      },
      "notes": [
        "Costs 1 credit per record.",
        "Returns an estimated total count."
      ],
      "job": "company.search",
      "docs_url": "https://docs.predictleads.com/v3/api_endpoints",
      "verified": {
        "docs": "https://docs.predictleads.com/v3/api_endpoints"
      }
    },
