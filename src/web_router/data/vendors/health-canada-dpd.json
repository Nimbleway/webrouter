      "name": "Get active ingredients",
      "summary": "Active ingredients and strengths of a drug product.",
      "kind": "read",
      "method": "GET",
      "path": "/activeingredient/",
      "params": {
        "id": {
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Drug product code (drug_code from drugproduct).",
          "example": 2049
        },
        "ingredientname": {
          "in": "query",
