          "description": "Text matched within the ingredient name.",
          "example": "zinc"
        },
        "lang": {
          "in": "query",
          "type": "string",
          "description": "en (default) or fr.",
          "enum": [
            "en",
            "fr"
          ]
        },
        "type": {
          "in": "query",
          "type": "string",
          "description": "json (default) or xml.",
          "enum": [
            "json",
            "xml"
          ]
        }
