            "tiktok",
            "onlyfans",
            "twitter",
            "snapchat",
            "discord",
            "pinterest",
            "facebook",
            "linkedin",
            "twitch"
          ]
        },
        "email_required": {
          "in": "body",
          "type": "string",
          "description": "must_have rejects the match (no charge) when no valid email is found; preferred returns it anyway.",
          "enum": [
            "must_have",
            "preferred"
          ]
        }
      },
      "notes": [
        "A read over POST.",
        "0.2 credits per successful request. Only the requested platform is returned."
      ],
      "job": "social.profile",
      "docs_url": "https://docs.influencers.club/openapi/enrich-by-handle-profile/public_v1_creators_enrich_handle_profile_create.md",
      "verified": {
        "docs": "https://docs.influencers.club/openapi/enrich-by-handle-profile/public_v1_creators_enrich_handle_profile_create.md"
      }
    },
    {
      "id": "influencersclub.creators.enrich_analytics",
      "name": "Enrich a creator by handle (analytics)",
      "summary": "Engagement, growth, posting frequency, income estimates and audience data; no contact fields.",
      "kind": "read",
      "method": "POST",
      "path": "/public/v1/creators/enrich/handle/analytics/",
      "params": {
        "handle": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Creator username, profile URL, or YouTube channel id (UC...).",
          "example": "mrbeast"
        },
        "platform": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Platform the handle belongs to.",
          "enum": [
            "instagram",
            "onlyfans",
            "tiktok",
            "twitch",
            "twitter",
            "youtube"
          ]
        },
        "include_lookalikes": {
          "in": "body",
          "type": "boolean",
          "description": "Include lookalike creator recommendations."
        }
      },
      "notes": [
        "A read over POST.",
        "Facebook, Pinterest, Snapchat, Discord and LinkedIn have no analytics and answer 400."
      ],
      "job": "social.profile",
      "docs_url": "https://docs.influencers.club/openapi/enrich-by-handle-analytics/public_v1_creators_enrich_handle_analytics_create.md",
      "verified": {
        "docs": "https://docs.influencers.club/openapi/enrich-by-handle-analytics/public_v1_creators_enrich_handle_analytics_create.md"
      }
    },
