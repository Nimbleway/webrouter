    {
      "id": "influencersclub.dictionary.locations",
      "name": "List location values for a platform",
      "summary": "Location strings valid in discovery filters.",
      "kind": "read",
      "method": "GET",
      "path": "/public/v1/discovery/classifier/locations/{platform}/",
      "params": {
        "platform": {
          "in": "path",
