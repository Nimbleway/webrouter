    {
      "id": "influencersclub.creators.posts",
      "name": "List a creator's recent posts",
      "summary": "Recent posts with captions, media URLs, timestamps and engagement counts.",
      "kind": "read",
      "method": "POST",
      "path": "/public/v1/creators/content/posts/",
      "params": {
        "platform": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Platform.",
          "enum": [
            "instagram",
            "tiktok",
            "youtube"
          ]
        },
        "handle": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Creator username, profile URL, or YouTube channel id (UC...).",
          "example": "mrbeast"
        },
        "count": {
          "in": "body",
          "type": "integer",
          "description": "Posts per page, clamped per platform: Instagram fixed at 12, TikTok max 35, YouTube max 50."
        },
        "pagination_token": {
          "in": "body",
          "type": "string",
          "description": "Cursor from the previous response (next_token)."
        }
      },
      "notes": [
        "A read over POST.",
        "0.03 credits per successful request."
      ],
      "job": "social.posts",
      "docs_url": "https://docs.influencers.club/openapi/creator-posts/public_v1_creators_content_posts_create.md",
