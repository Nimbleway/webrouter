        },
        "search": {
          "in": "query",
          "type": "string",
          "description": "Substring filter on location names."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Pagination offset; offset plus limit may not exceed 10,000."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Results per page, 1 to 100."
        }
      },
      "notes": [
        "Free."
      ],
      "job": "social.search",
      "docs_url": "https://docs.influencers.club/openapi/dictionary/public_v1_discovery_classifier_locations_retrieve.md",
      "verified": {
        "docs": "https://docs.influencers.club/openapi/dictionary/public_v1_discovery_classifier_locations_retrieve.md"
