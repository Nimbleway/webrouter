{
  "vendor": "search1api",
  "name": "Search1API",
  "category": "search",
  "data": "public",
  "summary": "Web, news and Maps search, page reading, screenshots, extraction and site crawling through one API.",
  "docs_url": "https://s1.dev/docs",
  "pricing_url": "https://s1.dev/pricing",
  "base_url": "https://api.search1api.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "SEARCH1API_KEY"
        ],
        "description": "a Search1API key (create one in the dashboard at app.s1.dev)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Credits are charged when a request completes successfully (even with zero results); failed requests are free. $1 buys 1,000 credits; new accounts get 100 free.",
    "Cost per call: search 1, news 1, crawl 1, sitemap 1, trending 1, screenshot 2, maps 3 per page, ask 5, extract 10, deepcrawl 20; status checks and usage are free.",
    "Search, news and crawl also take a batch: an array of up to 50 request objects; this entry's params cover the single-request form.",
    "The docs also offer OAuth 2.1 for interactive clients; API keys are fully supported and used here."
  ],
  "sources": [
    "https://s1.dev/docs/essentials/credits-and-limits",
    "https://s1.dev/docs/essentials/authentication",
    "https://api.search1api.com/openapi.json",
    "https://s1.dev/docs/basic/search",
    "https://s1.dev/docs/basic/news",
    "https://s1.dev/docs/basic/ask",
    "https://s1.dev/docs/basic/maps",
    "https://s1.dev/docs/basic/crawl",
    "https://s1.dev/docs/basic/screenshot",
    "https://s1.dev/docs/advanced/extract",
    "https://s1.dev/docs/advanced/deepcrawl",
    "https://s1.dev/docs/utility/usage"
  ],
  "endpoints": [
    {
      "id": "search1api.web.search",
      "name": "Web search",
      "summary": "Ranked web results from one of many engines, with optional page text for the top results.",
      "kind": "read",
      "method": "POST",
      "path": "/search",
      "params": {
        "query": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The search query.",
          "example": "latest AI research"
        },
        "search_service": {
          "in": "body",
          "type": "string",
          "description": "Engine to search; omit for the default.",
          "enum": [
            "google",
            "bing",
            "bingcn",
            "duckduckgo",
            "yahoo",
            "yandex",
            "youtube",
            "x",
            "reddit",
            "github",
            "arxiv",
            "wechat",
            "bilibili",
            "imdb",
            "wikipedia",
            "grokipedia",
            "baidu",
            "360",
            "quark"
          ]
        },
        "max_results": {
          "in": "body",
          "type": "integer",
          "description": "Results to return, 1-50. Default 5.",
          "example": 5
        },
        "page": {
          "in": "body",
          "type": "integer",
          "description": "Page number, 1-100. Default 1.",
          "example": 1
        },
        "crawl_results": {
          "in": "body",
          "type": "integer",
          "description": "Fetch full page text for this many results, 0-50 (not more than max_results). Default 0."
        },
        "image": {
          "in": "body",
          "type": "boolean",
          "description": "Include images. Default false."
        },
        "include_sites": {
          "in": "body",
          "type": "array",
          "description": "Only these sites."
        },
        "exclude_sites": {
          "in": "body",
          "type": "array",
          "description": "Skip these sites."
        },
        "language": {
          "in": "body",
          "type": "string",
          "description": "Result language."
        },
        "time_range": {
          "in": "body",
          "type": "string",
          "description": "Only results from this period.",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 1 credit, plus 1 per page crawled successfully when crawl_results is set. The docs also allow a batch: send an array of up to 50 request objects (not supported by this entry's named params)."
      ],
      "job": "web.search",
      "docs_url": "https://s1.dev/docs/basic/search",
      "verified": {
        "docs": "https://s1.dev/docs/basic/search"
      }
    },
    {
      "id": "search1api.news.search",
      "name": "News search",
      "summary": "Recent news from several sources with site, language and time filters.",
      "kind": "read",
      "method": "POST",
      "path": "/news",
      "params": {
        "query": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The news query.",
          "example": "AI regulation"
        },
        "search_service": {
          "in": "body",
          "type": "string",
          "description": "News source to search.",
          "enum": [
            "google",
            "bing",
            "duckduckgo",
            "yahoo",
            "hackernews",
            "reuters"
          ]
        },
        "max_results": {
          "in": "body",
          "type": "integer",
          "description": "Results to return, 1-50. Default 5.",
          "example": 5
        },
        "crawl_results": {
          "in": "body",
          "type": "integer",
          "description": "Fetch full page text for this many results, 0-50. Default 0."
        },
        "image": {
          "in": "body",
          "type": "boolean",
          "description": "Include images. Default false."
        },
        "include_sites": {
          "in": "body",
          "type": "array",
          "description": "Only these sites."
        },
        "exclude_sites": {
          "in": "body",
          "type": "array",
          "description": "Skip these sites."
        },
        "language": {
          "in": "body",
          "type": "string",
          "description": "Result language."
        },
        "time_range": {
          "in": "body",
          "type": "string",
          "description": "Only results from this period.",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 1 credit, plus 1 per page crawled successfully when crawl_results is set."
      ],
      "job": "news.search",
      "docs_url": "https://s1.dev/docs/basic/news",
      "verified": {
        "docs": "https://s1.dev/docs/basic/news"
      }
    },
    {
      "id": "search1api.web.ask",
      "name": "Agentic search",
      "summary": "Describe what you want in plain language; a model picks up to five engines and reranks the results.",
      "kind": "read",
      "method": "POST",
      "path": "/ask",
      "params": {
        "query": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "What you want, in natural language (up to 500 characters). Hints like 'on Reddit' or 'this week' steer engine and time range.",
          "example": "What are developers saying about Bun 1.3 this month?"
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 5 credits."
      ],
      "job": "web.search",
      "docs_url": "https://s1.dev/docs/basic/ask",
      "verified": {
        "docs": "https://s1.dev/docs/basic/ask"
      }
    },
    {
      "id": "search1api.places.maps",
      "name": "Google Maps places",
      "summary": "Businesses and places from Google Maps for a query, 20 per page.",
      "kind": "read",
      "method": "POST",
      "path": "/maps",
      "params": {
        "query": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Google Maps search phrase.",
          "example": "coffee shops"
        },
        "country": {
          "in": "body",
          "type": "string",
          "description": "Two-letter country code. Default us.",
          "example": "us"
        },
        "language": {
          "in": "body",
          "type": "string",
          "description": "Result language, such as en or zh-CN. Default en."
        },
        "location": {
          "in": "body",
          "type": "object",
          "description": "Search origin {latitude, longitude, zoom (3-30, default 14)}. Required for page above 1.",
          "example": {
            "latitude": 40.7455,
            "longitude": -74.0083,
            "zoom": 15
          }
        },
        "page": {
          "in": "body",
          "type": "integer",
          "description": "Page number, 1-6. Default 1.",
          "example": 1
        },
        "max_results": {
          "in": "body",
          "type": "integer",
          "description": "Places to return from this page, 1-20. Default 20.",
          "example": 20
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 3 credits per page, however few places max_results keeps."
      ],
      "job": "places.search",
      "docs_url": "https://s1.dev/docs/basic/maps",
      "verified": {
        "docs": "https://s1.dev/docs/basic/maps"
      }
    },
    {
      "id": "search1api.web.crawl",
      "name": "Read a web page",
      "summary": "Fetch one page and return clean readable content.",
      "kind": "read",
      "method": "POST",
      "path": "/crawl",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The page URL.",
          "example": "https://example.com/article"
        },
        "enableFallback": {
          "in": "body",
          "type": "boolean",
          "description": "Use a fallback fetch method when the first fails. Default true."
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 1 credit. A batch form accepts an array of up to 50 items."
      ],
      "job": "web.extract",
      "docs_url": "https://s1.dev/docs/basic/crawl",
      "verified": {
        "docs": "https://s1.dev/docs/basic/crawl"
      }
    },
    {
      "id": "search1api.web.screenshot",
      "name": "Screenshot a page",
      "summary": "Render a public page as PNG, JPEG or WebP.",
      "kind": "read",
      "method": "POST",
      "path": "/screenshot",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The page URL.",
          "example": "https://example.com"
        },
        "format": {
          "in": "body",
          "type": "string",
          "description": "Image format; default png.",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "full_page": {
          "in": "body",
          "type": "boolean",
          "description": "Capture the full scrolling page. Default false."
        },
        "viewport": {
          "in": "body",
          "type": "object",
          "description": "{width, height, device_scale_factor}; default 1440 by 900 at scale 1."
        },
        "wait_until": {
          "in": "body",
          "type": "string",
          "description": "Page readiness event; default load.",
          "enum": [
            "domcontentloaded",
            "load",
            "networkidle"
          ]
        },
        "wait_for_selector": {
          "in": "body",
          "type": "string",
          "description": "CSS selector to wait for."
        },
        "selector": {
          "in": "body",
          "type": "string",
          "description": "CSS selector of one element to capture."
        },
        "delay_ms": {
          "in": "body",
          "type": "integer",
          "description": "Extra wait in ms. Default 0."
        },
        "timeout_ms": {
          "in": "body",
          "type": "integer",
          "description": "Timeout in ms. Default 20000."
        },
        "quality": {
          "in": "body",
          "type": "integer",
          "description": "Image quality for lossy formats."
        },
        "omit_background": {
          "in": "body",
          "type": "boolean",
          "description": "Transparent background. Default false."
        },
        "color_scheme": {
          "in": "body",
          "type": "string",
          "description": "Preferred color scheme; default light.",
          "enum": [
            "light",
            "dark"
          ]
        },
        "animations": {
          "in": "body",
          "type": "string",
          "description": "disabled (default) or allow.",
          "enum": [
            "disabled",
            "allow"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 2 credits."
      ],
      "job": "web.screenshot",
      "docs_url": "https://s1.dev/docs/basic/screenshot",
      "verified": {
        "docs": "https://s1.dev/docs/basic/screenshot"
      }
    },
    {
      "id": "search1api.web.sitemap",
      "name": "Site sitemap links",
      "summary": "Links from a website's sitemap.",
      "kind": "read",
      "method": "POST",
      "path": "/sitemap",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The website URL.",
          "example": "https://example.com"
        },
        "type": {
          "in": "body",
          "type": "string",
          "description": "sitemap or all.",
          "enum": [
            "sitemap",
            "all"
          ]
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 1 credit."
      ],
      "job": "web.map",
      "docs_url": "https://s1.dev/docs/advanced/sitemap",
      "verified": {
        "docs": "https://s1.dev/docs/advanced/sitemap"
      }
    },
    {
      "id": "search1api.web.trending",
      "name": "Trending topics",
      "summary": "Trending topics from a popular platform.",
      "kind": "read",
      "method": "POST",
      "path": "/trending",
      "params": {
        "search_service": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The platform to read trends from.",
          "example": "github"
        },
        "max_results": {
          "in": "body",
          "type": "integer",
          "description": "Maximum topics to return."
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Costs 1 credit."
      ],
      "job": "news.search",
      "docs_url": "https://s1.dev/docs/advanced/trending",
      "verified": {
        "docs": "https://s1.dev/docs/advanced/trending"
      }
    },
    {
      "id": "search1api.web.extract",
      "name": "Extract structured data from a page",
      "summary": "Pull specific fields out of one page using a prompt and a JSON shape you define.",
      "kind": "read",
      "method": "POST",
      "path": "/extract",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The page URL.",
          "example": "https://example.com/product"
        },
        "prompt": {
          "in": "body",
          "type": "string",
          "description": "What to extract, in plain language."
        },
        "response_format": {
          "in": "body",
          "type": "object",
          "description": "A JSON schema describing the shape to return."
        }
      },
      "notes": [
        "A read over POST: nothing is changed on your account; it spends credits.",
        "Beta. Costs 10 credits per request."
      ],
      "job": "web.extract",
      "docs_url": "https://s1.dev/docs/advanced/extract",
      "verified": {
        "docs": "https://s1.dev/docs/advanced/extract"
      }
    },
    {
      "id": "search1api.web.deepcrawl",
      "name": "Start a site deep crawl",
      "summary": "Start an asynchronous crawl of a whole site; returns a task id to poll.",
      "kind": "read",
      "method": "POST",
      "path": "/deepcrawl",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The site URL.",
          "example": "https://example.com"
        },
        "type": {
          "in": "body",
          "type": "string",
          "description": "sitemap or all.",
          "enum": [
            "sitemap",
            "all"
          ]
        },
        "max_pages": {
          "in": "body",
          "type": "integer",
          "description": "Maximum pages, 1-1000. Default 1000."
        },
        "include_paths": {
          "in": "body",
          "type": "array",
          "description": "Only crawl matching paths (up to 20 rules); a rule without * is a path prefix."
        },
        "exclude_paths": {
          "in": "body",
          "type": "array",
          "description": "Skip matching paths (up to 20 rules); exclusion wins."
        },
        "format": {
          "in": "body",
          "type": "string",
          "description": "Result format: zip (default, Markdown files behind zipUrl) or json (pages inline).",
          "enum": [
            "zip",
            "json"
          ]
        }
      },
      "notes": [
        "Starts a job that only produces data. Beta. Poll search1api.web.deepcrawl_status with the returned task id.",
        "Costs 20 credits per task regardless of page count."
      ],
      "job": "web.crawl",
      "docs_url": "https://s1.dev/docs/advanced/deepcrawl",
      "verified": {
        "docs": "https://s1.dev/docs/advanced/deepcrawl"
      }
    },
    {
      "id": "search1api.web.deepcrawl_status",
      "name": "Check a deep crawl",
      "summary": "Status and, when finished, the result of a deep crawl task.",
      "kind": "read",
      "method": "GET",
      "path": "/deepcrawl/status/{taskId}",
      "params": {
        "taskId": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "The task id returned when the crawl started."
        }
      },
      "notes": [
        "Free."
      ],
      "job": "jobs.status",
      "docs_url": "https://s1.dev/docs/advanced/deepcrawl",
      "verified": {
        "docs": "https://s1.dev/docs/advanced/deepcrawl"
      }
    },
    {
      "id": "search1api.account.usage",
      "name": "Check credit balance",
      "summary": "Remaining credits for the key.",
      "kind": "read",
      "method": "GET",
      "path": "/usage",
      "params": {
        "period": {
          "in": "query",
          "type": "string",
          "description": "Period to report.",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        }
      },
      "notes": [
        "Free."
      ],
      "job": "account.usage",
      "docs_url": "https://s1.dev/docs/utility/usage",
      "verified": {
        "docs": "https://s1.dev/docs/utility/usage"
      }
    }
  ],
  "curated": "2026-11-08"
}
