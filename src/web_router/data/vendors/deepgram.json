{
  "vendor": "deepgram",
  "name": "Deepgram",
  "category": "ai",
  "summary": "Speech-to-text transcription of recorded audio, text-to-speech, and text analysis (summaries, topics, sentiment, intents).",
  "docs_url": "https://developers.deepgram.com/reference/deepgram-api-overview",
  "pricing_url": "https://deepgram.com/pricing",
  "base_url": "https://api.deepgram.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "DEEPGRAM_API_KEY"
        ],
        "description": "a Deepgram API key (console.deepgram.com)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Token {api_key}"
      }
    ]
  },
  "notes": [
    "The key goes in 'Authorization: Token <key>' (not Bearer, which is for short-lived JWTs).",
    "Billed by audio duration for transcription and by characters for speech; see the pricing page.",
    "Options for listen, speak and read are query parameters; only the audio URL or text goes in the JSON body."
  ],
  "sources": [
    "https://developers.deepgram.com/reference/speech-to-text/listen-pre-recorded",
    "https://developers.deepgram.com/reference/text-to-speech/speak-request",
    "https://developers.deepgram.com/reference/text-intelligence/analyze-text",
    "https://developers.deepgram.com/reference/manage/models/list",
    "https://developers.deepgram.com/reference/manage/projects/list",
    "https://developers.deepgram.com/reference/manage/usage/get",
    "https://developers.deepgram.com/reference/manage/billing/list"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "deepgram.listen.transcribe",
      "name": "Transcribe recorded audio from a URL",
      "summary": "Speech-to-text for a hosted audio or video file, with optional formatting, diarization, summaries and topics.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/listen",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Public URL of the audio file to transcribe.",
          "example": "https://dpgr.am/spacewalk.wav"
        },
        "model": {
          "in": "query",
          "type": "string",
          "description": "STT model, e.g. nova-3, nova-3-medical, nova-2, enhanced, base. Default base-general.",
          "example": "nova-3"
        },
        "language": {
          "in": "query",
          "type": "string",
          "description": "BCP-47 language hint; default en.",
          "example": "en"
        },
        "detect_language": {
          "in": "query",
          "type": "boolean",
          "description": "Detect the dominant spoken language."
        },
        "smart_format": {
          "in": "query",
          "type": "boolean",
          "description": "Extra formatting for readability (numbers, dates, punctuation)."
        },
        "punctuate": {
          "in": "query",
          "type": "boolean",
          "description": "Add punctuation and capitalization."
        },
        "diarize_model": {
          "in": "query",
          "type": "string",
          "description": "Turn on speaker labels and pick the diarization model.",
          "enum": [
            "latest",
            "v1",
            "v2"
          ]
        },
        "utterances": {
          "in": "query",
          "type": "boolean",
          "description": "Segment speech into utterances."
        },
        "paragraphs": {
          "in": "query",
          "type": "boolean",
          "description": "Split the transcript into paragraphs."
        },
        "summarize": {
          "in": "query",
          "type": "string",
          "description": "Set to v2 to add a summary."
        },
        "topics": {
          "in": "query",
          "type": "boolean",
          "description": "Detect topics."
        },
        "callback": {
          "in": "query",
          "type": "string",
          "description": "URL Deepgram posts the result to; the call then returns only a request_id."
        },
        "tag": {
          "in": "query",
          "type": "string",
          "description": "Label for grouping usage reports."
        }
      },
      "notes": [
        "Synchronous unless callback is set: the transcript is in results.channels[].alternatives[].transcript.",
        "Uploading a local file needs a raw binary body, which this entry does not cover; pass a URL."
      ],
      "job": "ai.speech.transcribe",
      "docs_url": "https://developers.deepgram.com/reference/speech-to-text/listen-pre-recorded",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/speech-to-text/listen-pre-recorded"
      }
    },
    {
      "id": "deepgram.speak.generate",
      "name": "Generate speech from text",
      "summary": "Text-to-speech in an Aura voice, returned as an audio file.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/speak",
      "params": {
        "text": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Text to speak.",
          "example": "Hello from Deepgram."
        },
        "model": {
          "in": "query",
          "type": "string",
          "description": "Voice model, e.g. aura-2-thalia-en, aura-2-agustina-es; default aura-asteria-en.",
          "example": "aura-2-thalia-en"
        },
        "encoding": {
          "in": "query",
          "type": "string",
          "description": "Audio encoding; default mp3.",
          "enum": [
            "linear16",
            "flac",
            "mulaw",
            "alaw",
            "mp3",
            "opus",
            "aac"
          ]
        },
        "container": {
          "in": "query",
          "type": "string",
          "description": "Container: none, wav (linear16, mulaw, alaw) or ogg (opus).",
          "enum": [
            "none",
            "wav",
            "ogg"
          ]
        },
        "sample_rate": {
          "in": "query",
          "type": "integer",
          "description": "Sample rate in Hz; allowed values depend on the encoding (mp3 is 22050)."
        },
        "bit_rate": {
          "in": "query",
          "type": "integer",
          "description": "Bit rate; for mp3, 32000 or 48000."
        },
        "speed": {
          "in": "query",
          "type": "number",
          "description": "Speaking speed; default 1."
        }
      },
      "notes": [
        "The response body is the audio bytes, not JSON.",
        "Billed per character of text."
      ],
      "job": "ai.speech.generate",
      "docs_url": "https://developers.deepgram.com/reference/text-to-speech/speak-request",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/text-to-speech/speak-request"
      }
    },
    {
      "id": "deepgram.read.analyze",
      "name": "Analyze text",
      "summary": "Summary, topics, sentiment and intents for a text or the text at a URL.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/read",
      "params": {
        "text": {
          "in": "body",
          "type": "string",
          "description": "Plain text to analyze (send this or url)."
        },
        "url": {
          "in": "body",
          "type": "string",
          "description": "URL of the text to analyze (send this or text)."
        },
        "language": {
          "in": "query",
          "type": "string",
          "description": "BCP-47 language; default en."
        },
        "summarize": {
          "in": "query",
          "type": "boolean",
          "description": "Summarize the text."
        },
        "topics": {
          "in": "query",
          "type": "boolean",
          "description": "Detect topics."
        },
        "custom_topic": {
          "in": "query",
          "type": "string",
          "description": "A custom topic to detect (up to 100)."
        },
        "custom_topic_mode": {
          "in": "query",
          "type": "string",
          "description": "strict returns only custom topics; extended adds detected ones.",
          "enum": [
            "extended",
            "strict"
          ]
        },
        "sentiment": {
          "in": "query",
          "type": "boolean",
          "description": "Detect sentiment."
        },
        "intents": {
          "in": "query",
          "type": "boolean",
          "description": "Detect intents."
        },
        "custom_intent": {
          "in": "query",
          "type": "string",
          "description": "A custom intent to detect."
        },
        "custom_intent_mode": {
          "in": "query",
          "type": "string",
          "description": "strict or extended, as for topics.",
          "enum": [
            "extended",
            "strict"
          ]
        }
      },
      "notes": [
        "A read over POST: it changes nothing."
      ],
      "job": "ai.text.analyze",
      "docs_url": "https://developers.deepgram.com/reference/text-intelligence/analyze-text",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/text-intelligence/analyze-text"
      }
    },
    {
      "id": "deepgram.models.list",
      "name": "List models",
      "summary": "Metadata for the current public speech-to-text and text-to-speech models.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/models",
      "params": {
        "include_outdated": {
          "in": "query",
          "type": "boolean",
          "description": "Also return non-latest model versions."
        }
      },
      "job": "ai.models",
      "docs_url": "https://developers.deepgram.com/reference/manage/models/list",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/manage/models/list"
      }
    },
    {
      "id": "deepgram.projects.list",
      "name": "List projects",
      "summary": "The projects the key can access, with their ids (needed by usage and balances).",
      "kind": "read",
      "method": "GET",
      "path": "/v1/projects",
      "params": {},
      "docs_url": "https://developers.deepgram.com/reference/manage/projects/list",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/manage/projects/list"
      }
    },
    {
      "id": "deepgram.usage.get",
      "name": "Get project usage",
      "summary": "Usage totals for a project over a date range, optionally filtered.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/projects/{project_id}/usage",
      "params": {
        "project_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Project id from deepgram.projects.list."
        },
        "start": {
          "in": "query",
          "type": "string",
          "description": "Start date, YYYY-MM-DD."
        },
        "end": {
          "in": "query",
          "type": "string",
          "description": "End date, YYYY-MM-DD."
        },
        "endpoint": {
          "in": "query",
          "type": "string",
          "description": "Only requests to this endpoint (e.g. listen)."
        },
        "model": {
          "in": "query",
          "type": "string",
          "description": "Only requests that used this model uuid."
        },
        "tag": {
          "in": "query",
          "type": "string",
          "description": "Only requests with this tag."
        }
      },
      "job": "account.usage",
      "docs_url": "https://developers.deepgram.com/reference/manage/usage/get",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/manage/usage/get"
      }
    },
    {
      "id": "deepgram.balances.list",
      "name": "List project balances",
      "summary": "Remaining credit balances on a project.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/projects/{project_id}/balances",
      "params": {
        "project_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Project id from deepgram.projects.list."
        }
      },
      "job": "account.usage",
      "docs_url": "https://developers.deepgram.com/reference/manage/billing/list",
      "verified": {
        "docs": "https://developers.deepgram.com/reference/manage/billing/list"
      }
    }
  ]
}
