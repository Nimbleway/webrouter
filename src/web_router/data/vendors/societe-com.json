    {
      "id": "societe-com.companies.search",
      "name": "Search companies",
      "summary": "Companies by name or director, optionally narrowed by NAF code and department.",
      "kind": "read",
      "method": "GET",
      "path": "/entreprise/search",
      "params": {
        "nom": {
          "in": "query",
          "type": "string",
          "description": "Company name.",
          "example": "societe"
        },
        "dirig": {
          "in": "query",
          "type": "string",
          "description": "Director's last name."
        },
        "pre": {
          "in": "query",
          "type": "string",
          "description": "Director's first name; needs another field too."
        },
        "ape": {
          "in": "query",
          "type": "string",
          "description": "NAF/APE activity code, e.g. 3700Z; needs another field too."
        },
        "dep": {
          "in": "query",
          "type": "string",
          "description": "Department number, e.g. 75; needs another field too."
        },
        "debut": {
          "in": "query",
          "type": "integer",
          "description": "Offset for the next results, default 1."
        },
        "nbrep": {
          "in": "query",
          "type": "integer",
          "description": "Maximum results, default 200, at most 1000."
        },
        "exa": {
          "in": "query",
          "type": "string",
          "description": "on for an exact name match.",
          "enum": [
            "on"
          ]
        }
      },
      "notes": [
        "0.1 credit.",
        "exa=on makes the name match exact."
      ],
      "job": "company.search",
      "docs_url": "https://api.societe.com/apisite/documentations/v1/documentation-api.html",
      "verified": {
        "docs": "https://api.societe.com/apisite/documentations/v1/documentation-api.html"
      }
    },
    {
      "id": "societe-com.companies.autocomplete",
      "name": "Autocomplete companies",
      "summary": "Companies whose name matches the text typed, with SIREN, postcode, city and open/closed status.",
      "kind": "read",
      "method": "GET",
      "path": "/autocomplete/entreprise",
      "params": {
        "q": {
          "in": "query",
          "type": "string",
          "description": "Company name search text.",
          "required": true
        },
        "geo": {
          "in": "query",
          "type": "string",
          "description": "Filter by department, postcode or city, e.g. 75 or paris."
        },
        "ape": {
          "in": "query",
          "type": "string",
          "description": "Filter by NAF activity code, e.g. 7312Z."
        },
        "count": {
          "in": "query",
          "type": "integer",
          "description": "Results, at most 100."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Paging offset."
        }
      },
      "notes": [
        "Free."
      ],
      "job": "company.suggest",
      "docs_url": "https://api.societe.com/apisite/documentations/v1/documentation-api.html",
      "verified": {
        "docs": "https://api.societe.com/apisite/documentations/v1/documentation-api.html"
      }
    },
