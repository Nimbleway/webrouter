{
  "vendor": "societe-com",
  "name": "Societe.com API Pro",
  "category": "company-data",
  "summary": "French company data from SIRENE, INPI and BODACC by SIREN, SIRET or VAT number: legal details, directors and their mandates, beneficial owners, financial statements, establishments, insolvency proceedings, legal events, scores, trademarks and search.",
  "docs_url": "https://api.societe.com/apisite/documentations/v1/documentation-api.html",
  "pricing_url": "https://www.societe.com/solutions/api",
  "base_url": "https://api.societe.com/api/v1",
  "auth": {
    "credentials": {
      "token": {
        "env": [
          "SOCIETE_COM_API_KEY"
        ],
        "description": "A Societe.com API Pro token (pro account, then ask api-pro-support@societe.com). Sent as X-Authorization: socapi <token>."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-Authorization",
        "value": "socapi {token}"
      }
    ]
  },
  "notes": [
    "Calls are only accepted from IP addresses allowed in your Societe.com account; any other IP gets 401 or 403.",
    "Each successful call spends credits (costs per route below; 402 when out). Failed calls cost nothing, except failures with valid parameters.",
    "Rate limit: 60 requests a minute by default (Highrate option for more); 429 when exceeded.",
    "JSON by default; contenttype=xml returns XML. Dates in answers are AAAAMMJJ. Field names are French."
  ],
  "sources": [
    "https://api.societe.com/apisite/documentations/v1/documentation-api.html",
    "https://www.societe.com/solutions/api",
    "https://www.societe.com/api/versions.html"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "societe-com.companies.exists",
      "name": "Check a company exists",
      "summary": "Whether a SIREN, SIRET or VAT number exists, with name, head-office SIRET, VAT number, status and registry flags.",
      "kind": "read",
      "method": "GET",
      "path": "/entreprise/{numid}/exist",
      "params": {
        "numid": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "SIREN (9 digits), SIRET (14 digits) or EU VAT number (FR56428723266) of the company.",
          "example": "493467849"
        }
      },
      "notes": [
        "0.2 credit."
      ],
      "job": "company.verify",
      "docs_url": "https://api.societe.com/apisite/documentations/v1/documentation-api.html",
      "verified": {
        "docs": "https://api.societe.com/apisite/documentations/v1/documentation-api.html"
      }
    },
    {
