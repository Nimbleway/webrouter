{
  "vendor": "heygen",
  "name": "HeyGen",
  "category": "media-generation",
  "data": "service",
  "summary": "AI avatar videos: prompt-to-video with Video Agent, avatar videos from a script, and the avatars, voices and videos in an account.",
  "docs_url": "https://developers.heygen.com/docs/quick-start",
  "pricing_url": "https://www.heygen.com/api-pricing",
  "base_url": "https://api.heygen.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "HEYGEN_API_KEY"
        ],
        "description": "a HeyGen API key from the HeyGen dashboard. Sent in the x-api-key header."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "x-api-key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Video generation is asynchronous and credit-billed: create, then poll (or pass callback_url).",
    "Lists page with an opaque token from the previous response, not page numbers.",
    "Answers wrap their payload in a data object.",
    "Translation, lipsync, templates, avatar creation and deletes are not in this entry."
  ],
  "sources": [
    "https://developers.heygen.com/llms.txt",
    "https://developers.heygen.com/docs/quick-start",
    "https://developers.heygen.com/reference/create-video-agent-session",
    "https://developers.heygen.com/reference/get-video-agent-session",
    "https://developers.heygen.com/reference/create-video",
    "https://developers.heygen.com/reference/get-video",
    "https://developers.heygen.com/reference/list-videos",
    "https://developers.heygen.com/reference/list-avatar-looks",
    "https://developers.heygen.com/reference/list-audio-voices",
    "https://developers.heygen.com/reference/get-current-user"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "heygen.video_agent.create",
      "name": "Generate a video from a prompt",
      "summary": "Video Agent writes the script, picks an avatar and scenes, and renders a video from one prompt.",
      "kind": "read",
      "method": "POST",
      "path": "/v3/video-agents",
      "params": {
        "prompt": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "What the video should be, 1-10,000 characters."
        },
        "mode": {
          "in": "body",
          "type": "string",
          "enum": [
            "generate",
            "chat"
          ],
          "description": "generate runs to the end; chat is multi-turn and may stop to ask questions."
        },
        "avatar_id": {
          "in": "body",
          "type": "string",
          "description": "Avatar look id to use."
        },
        "voice_id": {
          "in": "body",
          "type": "string",
          "description": "Voice id for narration."
        },
        "style_id": {
          "in": "body",
          "type": "string",
          "description": "Visual style id."
        },
        "orientation": {
          "in": "body",
          "type": "string",
          "enum": [
            "landscape",
            "portrait"
          ],
          "description": "Auto-detected when unset."
        },
        "callback_url": {
          "in": "body",
          "type": "string",
          "description": "Webhook for completion or failure."
        },
        "callback_id": {
          "in": "body",
          "type": "string",
          "description": "Your id, echoed in the webhook."
        },
        "visibility": {
          "in": "body",
          "type": "string",
          "enum": [
            "private",
            "space",
            "selected"
          ],
          "description": "Who in the workspace can open the session; default space."
        }
      },
      "notes": [
        "Spends credits. Poll heygen.video_agent.get until it has a video_id, then heygen.videos.get until the video is completed. Stop if the session is failed or waiting_for_input."
      ],
      "job": "ai.video.generate",
      "docs_url": "https://developers.heygen.com/reference/create-video-agent-session",
      "verified": {
        "docs": "https://developers.heygen.com/reference/create-video-agent-session"
      }
    },
    {
      "id": "heygen.video_agent.get",
      "name": "Get a Video Agent session",
      "summary": "Session status, progress, video_id and recent messages.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/video-agents/{session_id}",
      "params": {
        "session_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Session id from heygen.video_agent.create."
        }
      },
      "job": "jobs.status",
      "docs_url": "https://developers.heygen.com/reference/get-video-agent-session",
      "verified": {
        "docs": "https://developers.heygen.com/reference/get-video-agent-session"
      }
    },
    {
      "id": "heygen.videos.create",
      "name": "Create an avatar video",
      "summary": "An avatar (or a look) speaks your script, or lip-syncs your audio.",
      "kind": "read",
      "method": "POST",
      "path": "/v3/videos",
      "params": {
        "type": {
          "in": "body",
          "type": "string",
          "required": true,
          "enum": [
            "avatar"
          ],
          "description": "avatar for this form; the image, cinematic_avatar and studio forms take other inputs and need a raw call."
        },
        "avatar_id": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Avatar look id from heygen.avatars.looks."
        },
        "script": {
          "in": "body",
          "type": "string",
          "description": "Text to speak; not with audio_url."
        },
        "voice_id": {
          "in": "body",
          "type": "string",
          "description": "Voice for the script; unset uses the avatar's default voice."
        },
        "audio_url": {
          "in": "body",
          "type": "string",
          "description": "Public URL of audio to lip-sync instead of a script."
        },
        "title": {
          "in": "body",
          "type": "string",
          "description": "Title in the HeyGen dashboard."
        },
        "resolution": {
          "in": "body",
          "type": "string",
          "enum": [
            "4k",
            "1080p",
            "720p"
          ],
          "description": "Default 720p; 4k only for some avatars."
        },
        "aspect_ratio": {
          "in": "body",
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "4:5",
            "5:4",
            "1:1",
            "auto"
          ],
          "description": "Default 16:9."
        },
        "output_format": {
          "in": "body",
          "type": "string",
          "enum": [
            "mp4",
            "webm"
          ]
        },
        "callback_url": {
          "in": "body",
          "type": "string",
          "description": "Webhook called when the video is ready."
        },
        "callback_id": {
          "in": "body",
          "type": "string",
          "description": "Your id, echoed in the webhook."
        }
      },
      "notes": [
        "Spends credits. Avatar IV engine by default. Poll heygen.videos.get for status."
      ],
      "job": "ai.video.generate",
      "docs_url": "https://developers.heygen.com/reference/create-video",
      "verified": {
        "docs": "https://developers.heygen.com/reference/create-video"
      }
    },
    {
      "id": "heygen.videos.get",
      "name": "Get a video",
      "summary": "Status and, when completed, video_url, thumbnail_url, duration; failure details otherwise.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/videos/{video_id}",
      "params": {
        "video_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Video id."
        }
      },
      "notes": [
        "Poll until status is completed or failed."
      ],
      "job": "jobs.status",
      "docs_url": "https://developers.heygen.com/reference/get-video",
      "verified": {
        "docs": "https://developers.heygen.com/reference/get-video"
      }
    },
    {
      "id": "heygen.videos.list",
      "name": "List videos",
      "summary": "Videos in the account, paginated, by folder or title.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/videos",
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Per page, default 10."
        },
        "token": {
          "in": "query",
          "type": "string",
          "description": "Cursor from the previous page."
        },
        "folder_id": {
          "in": "query",
          "type": "string",
          "description": "Only this folder."
        },
        "title": {
          "in": "query",
          "type": "string",
          "description": "Title substring."
        }
      },
      "job": "media.list",
      "docs_url": "https://developers.heygen.com/reference/list-videos",
      "verified": {
        "docs": "https://developers.heygen.com/reference/list-videos"
      }
    },
    {
      "id": "heygen.avatars.looks",
      "name": "List avatar looks",
      "summary": "Avatar looks (outfits, poses); a look's id is the avatar_id for a video.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/avatars/looks",
      "params": {
        "group_id": {
          "in": "query",
          "type": "string",
          "description": "Only looks of this avatar group."
        },
        "avatar_type": {
          "in": "query",
          "type": "string",
          "enum": [
            "studio_avatar",
            "digital_twin",
            "photo_avatar"
          ]
        },
        "ownership": {
          "in": "query",
          "type": "string",
          "enum": [
            "public",
            "private"
          ],
          "description": "public = HeyGen presets, private = yours; unset = all."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "1-50, default 20."
        },
        "token": {
          "in": "query",
          "type": "string",
          "description": "Cursor for the next page."
        }
      },
      "job": "ai.avatars.list",
      "docs_url": "https://developers.heygen.com/reference/list-avatar-looks",
      "verified": {
        "docs": "https://developers.heygen.com/reference/list-avatar-looks"
      }
    },
    {
      "id": "heygen.voices.list",
      "name": "List voices",
      "summary": "Voices: the workspace's own (default) or HeyGen's public ones.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/models/audio/voices",
      "params": {
        "type": {
          "in": "query",
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "description": "Default private (your workspace's voices)."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Per page, default 10."
        },
        "token": {
          "in": "query",
          "type": "string",
          "description": "Cursor from the previous page."
        }
      },
      "job": "ai.voices.list",
      "docs_url": "https://developers.heygen.com/reference/list-audio-voices",
      "verified": {
        "docs": "https://developers.heygen.com/reference/list-audio-voices"
      }
    },
    {
      "id": "heygen.user.get",
      "name": "Get account and credits",
      "summary": "The user's profile, remaining credits or balance, and billing details.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/users/me",
      "job": "account.usage",
      "docs_url": "https://developers.heygen.com/reference/get-current-user",
      "verified": {
        "docs": "https://developers.heygen.com/reference/get-current-user"
      }
    }
  ]
}
