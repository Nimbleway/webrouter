    },
    {
      "id": "crossref.members.get",
      "name": "Get a Crossref member",
      "summary": "One member (publisher): names, prefixes, DOI counts and metadata coverage.",
      "kind": "read",
      "method": "GET",
      "path": "/members/{id}",
      "params": {
        "id": {
          "in": "path",
