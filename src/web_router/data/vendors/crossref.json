      "path": "/funders/{id}/works",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Funder id (the suffix of its 10.13039 DOI).",
          "example": "100000001"
        },
        "query": {
          "in": "query",
          "type": "string",
          "description": "Words to look for in any field."
        },
        "query_bibliographic": {
          "in": "query",
          "type": "string",
          "description": "Looks only in citation fields (titles, authors, ISSNs, years); good for matching a reference string.",
          "wire_name": "query.bibliographic"
        },
        "query_author": {
          "in": "query",
          "type": "string",
          "description": "Author given and family names.",
          "wire_name": "query.author"
        },
        "query_title": {
          "in": "query",
          "type": "string",
          "description": "Title.",
          "wire_name": "query.title"
        },
        "query_affiliation": {
          "in": "query",
          "type": "string",
          "description": "Contributor affiliations.",
          "wire_name": "query.affiliation"
        },
        "filter": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated name:value filters."
        },
        "select": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated fields to return."
        },
        "sort": {
          "in": "query",
          "type": "string",
          "description": "Sort field, e.g. published."
        },
        "order": {
          "in": "query",
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "description": "Default desc."
        },
        "rows": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, max 1000."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Items to skip, up to 10,000."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "* to start deep paging, then the previous next-cursor."
        },
        "mailto": {
          "in": "query",
          "type": "string",
          "description": "Your email, for the polite pool."
        }
      },
      "job": "scholar.funder.papers",
      "docs_url": "https://api.crossref.org/swagger-ui/index.html#/Funders/get_funders__id__works",
      "verified": {
