{
  "vendor": "binance",
  "name": "Binance",
  "category": "finance",
  "data": "public",
  "summary": "Binance spot exchange public market data: prices, 24h tickers, order books, trades, candles and symbol rules, keyless.",
  "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api",
  "base_url": "https://{host}/api/v3",
  "settings": {
    "host": {
      "env": [
        "BINANCE_HOST"
      ],
      "default": "api.binance.com",
      "choices": [
        "api.binance.com",
        "api-gcp.binance.com",
        "api1.binance.com",
        "api2.binance.com",
        "api3.binance.com",
        "api4.binance.com",
        "data-api.binance.vision"
      ],
      "description": "REST base host; data-api.binance.vision serves public market data only. api1-api4 are faster but less stable."
    }
  },
  "notes": [
    "Market data endpoints are public: no API key needed. Trading and account endpoints are signed and not in this entry.",
    "Rate limits are per IP and counted in request weight (each endpoint lists its weight); usage comes back in X-MBX-USED-WEIGHT-* headers. A 429 means back off for Retry-After seconds; ignoring 429s gets the IP banned (418), from 2 minutes up to 3 days.",
    "Symbols are concatenated pairs with no separator, upper case: BTCUSDT, ETHBTC.",
    "A 'symbols' parameter is a JSON array string, e.g. [\"BTCUSDT\",\"BNBBTC\"]; at most 100 symbols. Do not combine symbol and symbols.",
    "Times are milliseconds since the epoch, UTC. Prices and quantities come back as strings."
  ],
  "sources": [
    "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-api-information",
    "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
    "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-endpoints"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "binance.ticker.price",
      "name": "Get latest symbol prices",
      "summary": "Latest price for one symbol, several, or every symbol.",
      "kind": "read",
      "method": "GET",
      "path": "/ticker/price",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "description": "One symbol.",
          "example": "BTCUSDT"
        },
        "symbols": {
          "in": "query",
          "type": "string",
          "description": "JSON array of symbols.",
          "example": "[\"BTCUSDT\",\"ETHUSDT\"]"
        },
        "symbolStatus": {
          "in": "query",
          "type": "string",
          "enum": [
            "TRADING",
            "HALT",
            "BREAK",
            "CANCEL_ONLY"
          ],
          "description": "Only symbols with this status."
        }
      },
      "notes": [
        "Weight 2 with symbol, 4 with symbols or none (all symbols)."
      ],
      "job": "crypto.price",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.ticker.24hr",
      "name": "Get 24-hour ticker statistics",
      "summary": "Rolling 24-hour price change, high, low, volume and last price.",
      "kind": "read",
      "method": "GET",
      "path": "/ticker/24hr",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "description": "One symbol.",
          "example": "BTCUSDT"
        },
        "symbols": {
          "in": "query",
          "type": "string",
          "description": "JSON array of symbols, max 100."
        },
        "type": {
          "in": "query",
          "type": "string",
          "enum": [
            "FULL",
            "MINI"
          ],
          "description": "FULL (default) or MINI."
        },
        "symbolStatus": {
          "in": "query",
          "type": "string",
          "enum": [
            "TRADING",
            "HALT",
            "BREAK",
            "CANCEL_ONLY"
          ],
          "description": "Only symbols with this status."
        }
      },
      "notes": [
        "Weight 2 for 1-20 symbols, 40 for 21-100, 80 for more or for no symbol parameter (all symbols)."
      ],
      "job": "market.quote",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.ticker.book",
      "name": "Get best bid and ask",
      "summary": "Best bid and ask price and quantity for one, several or all symbols.",
      "kind": "read",
      "method": "GET",
      "path": "/ticker/bookTicker",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "description": "One symbol.",
          "example": "BTCUSDT"
        },
        "symbols": {
          "in": "query",
          "type": "string",
          "description": "JSON array of symbols."
        },
        "symbolStatus": {
          "in": "query",
          "type": "string",
          "enum": [
            "TRADING",
            "HALT",
            "BREAK",
            "CANCEL_ONLY"
          ],
          "description": "Only symbols with this status."
        }
      },
      "notes": [
        "Weight 2 with symbol, 4 otherwise."
      ],
      "job": "market.quote",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.klines",
      "name": "Get candlesticks",
      "summary": "OHLCV candles for a symbol at a given interval.",
      "kind": "read",
      "method": "GET",
      "path": "/klines",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Symbol.",
          "example": "BTCUSDT"
        },
        "interval": {
          "in": "query",
          "type": "string",
          "required": true,
          "enum": [
            "1s",
            "1m",
            "3m",
            "5m",
            "15m",
            "30m",
            "1h",
            "2h",
            "4h",
            "6h",
            "8h",
            "12h",
            "1d",
            "3d",
            "1w",
            "1M"
          ],
          "description": "Candle interval (case-sensitive: 1m minute, 1M month).",
          "example": "1d"
        },
        "startTime": {
          "in": "query",
          "type": "integer",
          "description": "Start, ms since epoch."
        },
        "endTime": {
          "in": "query",
          "type": "integer",
          "description": "End, ms since epoch."
        },
        "timeZone": {
          "in": "query",
          "type": "string",
          "description": "Interval time zone, e.g. 8 or 05:45, within -12:00 to +14:00; default 0 (UTC)."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Default 500, max 1000."
        }
      },
      "notes": [
        "Weight 2. Each candle is an array of values, not an object."
      ],
      "job": "market.history",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.depth",
      "name": "Get order book",
      "summary": "Bids and asks for a symbol.",
      "kind": "read",
      "method": "GET",
      "path": "/depth",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Symbol.",
          "example": "BTCUSDT"
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Levels; default 100, max 5000."
        },
        "symbolStatus": {
          "in": "query",
          "type": "string",
          "enum": [
            "TRADING",
            "HALT",
            "BREAK",
            "CANCEL_ONLY"
          ],
          "description": "Fail unless the symbol has this status."
        }
      },
      "notes": [
        "Weight grows with limit: 5 (1-100), 25 (101-500), 50 (501-1000), 250 (1001-5000)."
      ],
      "job": "market.quote",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.trades",
      "name": "Get recent trades",
      "summary": "The most recent trades on a symbol.",
      "kind": "read",
      "method": "GET",
      "path": "/trades",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Symbol.",
          "example": "BTCUSDT"
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Default 500, max 1000."
        }
      },
      "notes": [
        "Weight 25."
      ],
      "job": "market.history",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.avg_price",
      "name": "Get current average price",
      "summary": "Current average price of a symbol.",
      "kind": "read",
      "method": "GET",
      "path": "/avgPrice",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Symbol.",
          "example": "BTCUSDT"
        }
      },
      "notes": [
        "Weight 2."
      ],
      "job": "crypto.price",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints"
      }
    },
    {
      "id": "binance.exchange_info",
      "name": "Get exchange and symbol info",
      "summary": "Trading rules, filters, status and permissions for symbols.",
      "kind": "read",
      "method": "GET",
      "path": "/exchangeInfo",
      "params": {
        "symbol": {
          "in": "query",
          "type": "string",
          "description": "One symbol.",
          "example": "ETHBTC"
        },
        "symbols": {
          "in": "query",
          "type": "string",
          "description": "JSON array of symbols."
        },
        "permissions": {
          "in": "query",
          "type": "string",
          "description": "JSON array of permissions, e.g. [\"SPOT\"]; not with symbol/symbols."
        },
        "showPermissionSets": {
          "in": "query",
          "type": "boolean",
          "description": "Populate permissionSets; default true."
        },
        "symbolStatus": {
          "in": "query",
          "type": "string",
          "enum": [
            "TRADING",
            "HALT",
            "BREAK",
            "CANCEL_ONLY"
          ],
          "description": "Only symbols with this status; not with symbol/symbols."
        }
      },
      "notes": [
        "Weight 20. With no parameters the response covers every symbol and is large."
      ],
      "job": "market.symbols",
      "docs_url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-endpoints",
      "verified": {
        "docs": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-endpoints"
      }
    }
  ]
}
