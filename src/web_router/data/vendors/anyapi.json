      "kind": "read",
      "method": "POST",
      "path": "/v1/run/facebook.profile_posts",
      "params": {
        "cursor": {
          "in": "body",
          "type": "string",
          "description": "nextCursor from the previous response."
        },
        "pageId": {
          "in": "body",
          "type": "string",
          "description": "Facebook page id."
        },
        "url": {
          "in": "body",
          "type": "string",
