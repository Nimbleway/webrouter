{
  "vendor": "fishaudio",
  "name": "Fish Audio",
  "category": "media-generation",
  "summary": "Text-to-speech, voice design and voice-model management from Fish Audio.",
  "docs_url": "https://docs.fish.audio/api-reference/introduction",
  "pricing_url": "https://docs.fish.audio/developer-guide/models-pricing/pricing-and-rate-limits",
  "base_url": "https://api.fish.audio",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "FISH_API_KEY"
        ],
        "description": "a Fish Audio API key (fish.audio/app/developers)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Authenticate with an API key as a Bearer token; the key acts for the account that created it, so voice models and wallet endpoints are that account's own data.",
    "The model header (not a body field) picks the TTS model; leave it out for s2.1-pro.",
    "Speech comes back as raw audio bytes, so the HTTP body is not JSON.",
    "Real-time WebSocket streaming and speech-to-text exist but are not listed here."
  ],
  "sources": [
    "https://docs.fish.audio/api-reference/introduction",
    "https://docs.fish.audio/api-reference/openapi.json",
    "https://docs.fish.audio/api-reference/endpoint/openapi-v1/text-to-speech",
    "https://docs.fish.audio/llms.txt"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "fishaudio.speech.generate",
      "name": "Generate speech (text to speech)",
      "summary": "Turns text into audio in a chosen voice, returning the audio file.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/tts",
      "params": {
        "model": {
          "in": "header",
          "type": "string",
          "description": "TTS model: s1, s2-pro, s2.1-pro (default), s2.1-pro-free (free developer tier) or drama-3.",
          "example": "s2.1-pro",
          "enum": [
            "s1",
            "s2-pro",
            "s2.1-pro",
            "s2.1-pro-free",
            "drama-3"
          ]
        },
        "text": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Text to speak.",
          "example": "Hello from Fish Audio."
        },
        "reference_id": {
          "in": "body",
          "type": "string",
          "description": "Voice model id from the Fish Audio library or your own models (a list of ids for multi-speaker)."
        },
        "format": {
          "in": "body",
          "type": "string",
          "description": "Output audio format; default mp3.",
          "enum": [
            "wav",
            "pcm",
            "mp3",
            "opus"
          ]
        },
        "sample_rate": {
          "in": "body",
          "type": "integer",
          "description": "Sample rate in Hz; default 44100 (48000 for opus)."
        },
        "mp3_bitrate": {
          "in": "body",
          "type": "integer",
          "description": "MP3 bitrate in kbps."
        },
        "prosody": {
          "in": "body",
          "type": "object",
          "description": "Speed and volume adjustments."
        },
        "temperature": {
          "in": "body",
          "type": "number",
          "description": "Expressiveness: higher is more varied."
        },
        "top_p": {
          "in": "body",
          "type": "number",
          "description": "Nucleus sampling diversity."
        },
        "language": {
          "in": "body",
          "type": "string",
          "description": "BCP-47 language tag of the text, e.g. en, es-MX, zh-CN."
        },
        "normalize": {
          "in": "body",
          "type": "boolean",
          "description": "Rewrite numbers, dates and symbols as spoken words before synthesis."
        },
        "latency": {
          "in": "body",
          "type": "string",
          "description": "normal (best quality), balanced or low.",
          "enum": [
            "low",
            "normal",
            "balanced"
          ]
        },
        "chunk_length": {
          "in": "body",
          "type": "integer",
          "description": "Text segment size for processing."
        }
      },
      "notes": [
        "A read over POST: it generates audio and changes nothing. Returns binary audio, not JSON.",
        "Inline zero-shot cloning (references) needs MessagePack, not JSON, and is not declared here; use reference_id with a voice model.",
        "The free developer tier uses the s2.1-pro-free model."
      ],
      "job": "ai.speech.generate",
      "docs_url": "https://docs.fish.audio/api-reference/endpoint/openapi-v1/text-to-speech",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/endpoint/openapi-v1/text-to-speech"
      }
    },
    {
      "id": "fishaudio.voice.design",
      "name": "Design a voice from a prompt",
      "summary": "Generates candidate voices from a text instruction.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/voice-design",
      "params": {
        "model": {
          "in": "header",
          "type": "string",
          "required": true,
          "description": "Voice-design model name (see the docs)."
        },
        "instruction": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Voice design prompt, 1 to 2000 characters.",
          "example": "A warm, calm female narrator"
        },
        "reference_text": {
          "in": "body",
          "type": "string",
          "description": "Text used as reference content for the voice."
        },
        "language": {
          "in": "body",
          "type": "string",
          "description": "BCP-47 hint such as en, zh, ja."
        },
        "n": {
          "in": "body",
          "type": "integer",
          "description": "Number of candidates."
        },
        "seed": {
          "in": "body",
          "type": "integer",
          "description": "Deterministic seed."
        }
      },
      "notes": [
        "Candidates carry signatures that can be passed to fishaudio.model.create (voice_design_signatures) to keep one as a voice model."
      ],
      "job": "ai.speech.generate",
      "docs_url": "https://docs.fish.audio/api-reference/endpoint/openapi-v1/voice-design",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/endpoint/openapi-v1/voice-design"
      }
    },
    {
      "id": "fishaudio.model.list",
      "name": "List voice models",
      "summary": "Voices in the library or your own workspace.",
      "kind": "read",
      "method": "GET",
      "path": "/model",
      "params": {
        "self": {
          "in": "query",
          "type": "boolean",
          "description": "True for models owned by your workspace only."
        },
        "title": {
          "in": "query",
          "type": "string",
          "description": "Filter by title."
        },
        "tag": {
          "in": "query",
          "type": "string",
          "description": "Filter by tag."
        },
        "language": {
          "in": "query",
          "type": "string",
          "description": "Filter by language."
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Page size."
        },
        "page_number": {
          "in": "query",
          "type": "integer",
          "description": "Page number."
        },
        "licensed": {
          "in": "query",
          "type": "boolean",
          "description": "Only voices licensed by Fish Audio."
        },
        "sort_by": {
          "in": "query",
          "type": "string",
          "description": "Sort field."
        }
      },
      "docs_url": "https://docs.fish.audio/api-reference/endpoint/model/list-models",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/endpoint/model/list-models"
      }
    },
    {
      "id": "fishaudio.model.get",
      "name": "Get a voice model",
      "summary": "Details of one voice model, including its id for reference_id.",
      "kind": "read",
      "method": "GET",
      "path": "/model/{id}",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Voice model id."
        }
      },
      "docs_url": "https://docs.fish.audio/api-reference/endpoint/model/get-model",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/endpoint/model/get-model"
      }
    },
    {
      "id": "fishaudio.model.delete",
      "name": "Delete a voice model",
      "summary": "Permanently deletes one of your voice models.",
      "kind": "write",
      "method": "DELETE",
      "path": "/model/{id}",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Voice model id."
        }
      },
      "docs_url": "https://docs.fish.audio/api-reference/endpoint/model/delete-model",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/endpoint/model/delete-model"
      }
    },
    {
      "id": "fishaudio.wallet.credit",
      "name": "Get API credit balance",
      "summary": "Remaining API credit of the account (user id self), optionally a team.",
      "kind": "read",
      "method": "GET",
      "path": "/wallet/{user_id}/api-credit",
      "params": {
        "user_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "User id, or self.",
          "example": "self"
        },
        "check_free_credit": {
          "in": "query",
          "type": "boolean",
          "description": "Also report the free credit."
        },
        "team_id": {
          "in": "query",
          "type": "string",
          "description": "Team id."
        }
      },
      "job": "account.usage",
      "docs_url": "https://docs.fish.audio/api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/openapi.json"
      }
    },
    {
      "id": "fishaudio.wallet.package",
      "name": "Get the account's package",
      "summary": "The subscription package of the user.",
      "kind": "read",
      "method": "GET",
      "path": "/wallet/{user_id}/package",
      "params": {
        "user_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "User id, or self.",
          "example": "self"
        }
      },
      "job": "account.usage",
      "docs_url": "https://docs.fish.audio/api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.fish.audio/api-reference/openapi.json"
      }
    }
  ]
}
