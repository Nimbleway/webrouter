{
  "vendor": "enrichlayer",
  "name": "Enrich Layer",
  "category": "enrichment",
  "summary": "People, company, contact, job and school data: profile enrichment, lookups, search, emails and phone numbers from Enrich Layer.",
  "docs_url": "https://enrichlayer.com/docs",
  "pricing_url": "https://enrichlayer.com/pricing",
  "base_url": "https://enrichlayer.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "ENRICHLAYER_API_KEY"
        ],
        "description": "an Enrich Layer API key from your account dashboard (https://enrichlayer.com)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Credit-based; each endpoint states its cost, and optional include flags add credits. account.credit_balance is free.",
    "use_cache and live_fetch trade freshness for credits: a forced fresh fetch costs 9 extra credits.",
    "Boolean flags and options are strings (include, exclude, skip, enrich), not true/false.",
    "Paged endpoints return a next_page URL; send its cursor value (after, next_token or pagination) back."
  ],
  "sources": [
    "https://enrichlayer.com/llms.txt",
    "https://enrichlayer.com/docs/api/v2/openapi.json"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "enrichlayer.person.profile",
      "name": "Get a person profile",
      "summary": "Structured profile data for one person; 1 credit plus paid extras.",
      "kind": "read",
      "method": "GET",
      "path": "/api/v2/profile",
      "params": {
        "profile_url": {
          "in": "query",
          "type": "string",
          "description": "Person profile URL.",
          "example": "https://www.linkedin.com/in/williamhgates/"
        },
        "twitter_profile_url": {
          "in": "query",
          "type": "string",
          "description": "Twitter/X URL of the person, instead of profile_url."
        },
        "facebook_profile_url": {
          "in": "query",
          "type": "string",
          "description": "Facebook URL, instead of profile_url."
        },
        "extra": {
          "in": "query",
          "type": "string",
          "description": "Extra details (website link). include adds 1 credit; default exclude."
        },
        "github_profile_id": {
          "in": "query",
          "type": "string",
          "description": "GitHub link. include adds 1 credit; default exclude."
        },
        "twitter_profile_id": {
          "in": "query",
          "type": "string",
          "description": "Twitter link. include adds 1 credit; default exclude."
        },
        "personal_contact_number": {
          "in": "query",
          "type": "string",
          "description": "Personal phone numbers (per number). include adds 1 credit; default exclude."
        },
        "personal_email": {
          "in": "query",
          "type": "string",
          "description": "Personal emails (per email). include adds 1 credit; default exclude."
        },
        "inferred_salary": {
          "in": "query",
          "type": "string",
          "description": "Estimated salary. include adds 1 credit; default exclude."
        },
        "skills": {
          "in": "query",
          "type": "string",
          "description": "Skills (free). include adds 1 credit; default exclude."
        },
        "use_cache": {
          "in": "query",
          "type": "string",
          "description": "Cache policy: if-present (default), or if-recent to refetch stale data for 1 extra credit."
        },
        "fallback_to_cache": {
          "in": "query",
          "type": "string",
          "description": "Behavior when a fresh fetch fails: on-error (default) or never."
        },
        "live_fetch": {
          "in": "query",
          "type": "string",
          "description": "Set to force to fetch a fresh profile for 9 extra credits."
        }
      },
      "job": "people.enrich",
      "docs_url": "https://enrichlayer.com/docs/api/v2/people-api/person-profile",
      "verified": {
        "docs": "https://enrichlayer.com/docs/api/v2/people-api/person-profile"
      }
    },
    {
