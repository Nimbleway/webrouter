{
  "vendor": "elevenlabs",
  "name": "ElevenLabs",
  "category": "media-generation",
  "summary": "Text to speech, sound effects and music generation, plus voice search, models and usage, from ElevenLabs.",
  "docs_url": "https://elevenlabs.io/docs/api-reference/introduction",
  "pricing_url": "https://elevenlabs.io/pricing/api",
  "base_url": "https://{host}",
  "settings": {
    "host": {
      "env": [
        "ELEVENLABS_API_HOST"
      ],
      "default": "api.elevenlabs.io",
      "choices": [
        "api.elevenlabs.io",
        "api.us.elevenlabs.io",
        "api.eu.residency.elevenlabs.io",
        "api.in.residency.elevenlabs.io",
        "api.sg.residency.elevenlabs.io"
      ],
      "description": "The ElevenLabs API host: the global default, US, or a data-residency region (EU, India, Singapore) for workspaces created there."
    }
  },
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "ELEVENLABS_API_KEY"
        ],
        "description": "an ElevenLabs API key (keys can be restricted per endpoint and quota). Sent in the xi-api-key header."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "xi-api-key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Generation endpoints answer with raw audio in the chosen output_format, not JSON.",
    "Usage is billed in credits from the subscription; elevenlabs.subscription.get shows what is left.",
    "enable_logging=false (zero retention) is Enterprise-only and is not offered here.",
    "Speech to text, voice cloning, dubbing and agents are not in this entry."
  ],
  "sources": [
    "https://elevenlabs.io/docs/llms.txt",
    "https://elevenlabs.io/docs/api-reference/authentication",
    "https://elevenlabs.io/docs/api-reference/text-to-speech/convert",
    "https://elevenlabs.io/docs/api-reference/text-to-sound-effects/convert",
    "https://elevenlabs.io/docs/api-reference/music/compose",
    "https://elevenlabs.io/docs/api-reference/voices/search",
    "https://elevenlabs.io/docs/api-reference/models/list",
    "https://elevenlabs.io/docs/api-reference/history/list",
    "https://elevenlabs.io/docs/api-reference/user/subscription/get"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "elevenlabs.speech.generate",
      "name": "Text to speech",
      "summary": "Turns text into speech with a chosen voice and returns the audio file.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/text-to-speech/{voice_id}",
      "params": {
        "voice_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Voice id from elevenlabs.voices.search."
        },
        "output_format": {
          "in": "query",
          "type": "string",
          "description": "codec_samplerate_bitrate; default mp3_44100_128. mp3 192 kbps needs Creator tier or above; 44.1 kHz PCM/WAV needs Pro or above."
        },
        "text": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Text to speak."
        },
        "model_id": {
          "in": "body",
          "type": "string",
          "description": "Model id from elevenlabs.models.list; default eleven_multilingual_v2.",
          "example": "eleven_multilingual_v2"
        },
        "language_code": {
          "in": "body",
          "type": "string",
          "description": "ISO 639-1 code to enforce a language; ignored by models that do not support it (not multilingual_v2)."
        },
        "voice_settings": {
          "in": "body",
          "type": "object",
          "description": "Per-request override of the voice's stored settings."
        },
        "seed": {
          "in": "body",
          "type": "integer",
          "description": "0-4294967295, for best-effort determinism."
        },
        "previous_text": {
          "in": "body",
          "type": "string",
          "description": "Text before this one, for continuity across clips."
        },
        "next_text": {
          "in": "body",
          "type": "string",
          "description": "Text after this one, for continuity across clips."
        },
        "apply_text_normalization": {
          "in": "body",
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "Spell out numbers and the like; default auto."
        }
      },
      "notes": [
        "The response body is the audio bytes, not JSON. Spends character credits from the subscription."
      ],
      "job": "ai.speech.generate",
      "docs_url": "https://elevenlabs.io/docs/api-reference/text-to-speech/convert",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/text-to-speech/convert"
      }
    },
    {
      "id": "elevenlabs.sound_effects.generate",
      "name": "Generate a sound effect",
      "summary": "Turns a text description into a sound effect.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/sound-generation",
      "params": {
        "output_format": {
          "in": "query",
          "type": "string",
          "description": "codec_samplerate_bitrate; default mp3_44100_128. mp3 192 kbps needs Creator tier or above; 44.1 kHz PCM/WAV needs Pro or above."
        },
        "text": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Description of the sound.",
          "example": "rain on a tin roof"
        },
        "duration_seconds": {
          "in": "body",
          "type": "number",
          "description": "0.5-30 seconds; unset lets the model pick."
        },
        "loop": {
          "in": "body",
          "type": "boolean",
          "description": "Make it loop smoothly. Default false."
        },
        "prompt_influence": {
          "in": "body",
          "type": "number",
          "description": "0-1, default 0.3; higher follows the prompt more closely."
        },
        "model_id": {
          "in": "body",
          "type": "string",
          "enum": [
            "eleven_text_to_sound_v2",
            "eleven_text_to_sound_v3"
          ],
          "description": "Default eleven_text_to_sound_v2."
        }
      },
      "notes": [
        "The response body is the audio bytes. Spends credits."
      ],
      "job": "ai.audio.generate",
      "docs_url": "https://elevenlabs.io/docs/api-reference/text-to-sound-effects/convert",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/text-to-sound-effects/convert"
      }
    },
    {
      "id": "elevenlabs.music.compose",
      "name": "Compose music",
      "summary": "Generates a song from a text prompt (or a composition plan).",
      "kind": "read",
      "method": "POST",
      "path": "/v1/music",
      "params": {
        "prompt": {
          "in": "body",
          "type": "string",
          "description": "Text prompt; not with composition_plan.",
          "example": "upbeat synthwave with a driving bassline"
        },
        "composition_plan": {
          "in": "body",
          "type": "object",
          "description": "Detailed section-by-section plan; not with prompt."
        },
        "music_length_ms": {
          "in": "body",
          "type": "integer",
          "description": "3,000-600,000 ms, with prompt only; unset lets the model choose."
        },
        "model_id": {
          "in": "body",
          "type": "string",
          "enum": [
            "music_v1",
            "music_v2",
            "music_v2_5"
          ],
          "description": "Default music_v1."
        },
        "force_instrumental": {
          "in": "body",
          "type": "boolean",
          "description": "Guarantee no vocals; with prompt only."
        }
      },
      "notes": [
        "The response body is the audio bytes. Spends credits."
      ],
      "job": "ai.music.generate",
      "docs_url": "https://elevenlabs.io/docs/api-reference/music/compose",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/music/compose"
      }
    },
    {
      "id": "elevenlabs.voices.search",
      "name": "List and search voices",
      "summary": "The account's voices (and default voices) with search, filters and cursor paging.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/voices",
      "params": {
        "search": {
          "in": "query",
          "type": "string",
          "description": "Matches name, description, labels and category."
        },
        "voice_type": {
          "in": "query",
          "type": "string",
          "enum": [
            "personal",
            "community",
            "default",
            "workspace",
            "non-default",
            "non-community",
            "saved"
          ]
        },
        "category": {
          "in": "query",
          "type": "string",
          "enum": [
            "premade",
            "cloned",
            "generated",
            "professional"
          ]
        },
        "gender": {
          "in": "query",
          "type": "string",
          "description": "Filter on the gender label."
        },
        "age": {
          "in": "query",
          "type": "string",
          "description": "Filter on the age label."
        },
        "accent": {
          "in": "query",
          "type": "string",
          "description": "Filter on the accent label."
        },
        "language": {
          "in": "query",
          "type": "array",
          "description": "Filter on language labels; any match."
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Up to 100, default 10."
        },
        "next_page_token": {
          "in": "query",
          "type": "string",
          "description": "Token from the previous page; continue while has_more is true."
        },
        "sort": {
          "in": "query",
          "type": "string",
          "enum": [
            "created_at_unix",
            "name"
          ]
        },
        "sort_direction": {
          "in": "query",
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "job": "ai.voices.list",
      "docs_url": "https://elevenlabs.io/docs/api-reference/voices/search",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/voices/search"
      }
    },
    {
      "id": "elevenlabs.models.list",
      "name": "List models",
      "summary": "Available models and what each can do (can_do_text_to_speech, languages, ...).",
      "kind": "read",
      "method": "GET",
      "path": "/v1/models",
      "job": "ai.models",
      "docs_url": "https://elevenlabs.io/docs/api-reference/models/list",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/models/list"
      }
    },
    {
      "id": "elevenlabs.history.list",
      "name": "List generated audio",
      "summary": "Past generations (text to speech, speech to speech, Studio, dubbing), newest first.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/history",
      "params": {
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Up to 1,000, default 100."
        },
        "start_after_history_item_id": {
          "in": "query",
          "type": "string",
          "description": "Cursor: the last item id of the previous page."
        },
        "voice_id": {
          "in": "query",
          "type": "string",
          "description": "Only items made with this voice."
        },
        "date_after_unix": {
          "in": "query",
          "type": "integer",
          "description": "Only items at or after this Unix time."
        },
        "date_before_unix": {
          "in": "query",
          "type": "integer",
          "description": "Only items before this Unix time."
        },
        "search": {
          "in": "query",
          "type": "string",
          "description": "Search term."
        },
        "source": {
          "in": "query",
          "type": "string",
          "enum": [
            "TTS",
            "STS",
            "Flows"
          ]
        },
        "sort_direction": {
          "in": "query",
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "notes": [
        "Music and sound-effect generations are not in the history."
      ],
      "job": "account.history",
      "docs_url": "https://elevenlabs.io/docs/api-reference/history/list",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/history/list"
      }
    },
    {
      "id": "elevenlabs.subscription.get",
      "name": "Get subscription and usage",
      "summary": "Tier, character count used and limit, and reset date.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/user/subscription",
      "job": "account.usage",
      "docs_url": "https://elevenlabs.io/docs/api-reference/user/subscription/get",
      "verified": {
        "docs": "https://elevenlabs.io/docs/api-reference/user/subscription/get"
      }
    }
  ]
}
