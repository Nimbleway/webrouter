{
  "vendor": "parallel",
  "name": "Parallel",
  "category": "search",
  "summary": "Web search, URL extraction, deep-research Tasks and people/company discovery from Parallel Web Systems.",
  "docs_url": "https://docs.parallel.ai/getting-started/overview",
  "pricing_url": "https://parallel.ai/pricing",
  "base_url": "https://api.parallel.ai",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "PARALLEL_API_KEY"
        ],
        "description": "a Parallel API key (platform.parallel.ai > API keys)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "x-api-key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Auth is the x-api-key header.",
    "Task and FindAll runs are asynchronous: start, then poll the status endpoint or fetch the result. Task cost depends on the processor tier.",
    "FindAll and entity search live under /v1beta and may change.",
    "Parallel also has image and place search, Decisions, monitors, memory and a Responses/Chat API, not in this entry."
  ],
  "sources": [
    "https://docs.parallel.ai/llms.txt",
    "https://docs.parallel.ai/api-reference/search/search.md",
    "https://docs.parallel.ai/api-reference/tasks/create-task-run.md",
    "https://docs.parallel.ai/api-reference/findall/fast-entity-search.md"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "parallel.search.query",
      "name": "Search the web",
      "summary": "Ranked web results with LLM-ready excerpts, from an objective and keyword queries.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/search",
      "params": {
        "search_queries": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Concise keyword queries, 3-6 words each; give 2-3 for best results.",
          "example": [
            "parallel web systems funding"
          ]
        },
        "objective": {
          "in": "body",
          "type": "string",
          "description": "Natural-language goal that focuses the results."
        },
        "mode": {
          "in": "body",
          "type": "string",
          "description": "Search preset; turbo is fastest.",
          "enum": [
            "turbo",
            "fast",
            "basic",
            "advanced"
          ]
        },
        "max_chars_total": {
          "in": "body",
          "type": "integer",
          "description": "Cap on total excerpt characters across results."
        },
        "session_id": {
          "in": "body",
          "type": "string",
          "description": "Ties related search and extract calls together."
        },
        "advanced_settings": {
          "in": "body",
          "type": "object",
          "description": "Source policy, fetch policy and excerpt settings."
        }
      },
      "notes": [
        "A read over POST: it runs a search and changes nothing in your account."
      ],
      "job": "web.search",
      "docs_url": "https://docs.parallel.ai/api-reference/search/search.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/search/search.md"
      }
    },
    {
      "id": "parallel.extract.urls",
      "name": "Extract content from URLs",
      "summary": "Relevant excerpts or full markdown for up to 20 URLs.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/extract",
      "params": {
        "urls": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "URLs to extract, up to 20.",
          "example": [
            "https://example.com"
          ]
        },
        "objective": {
          "in": "body",
          "type": "string",
          "description": "Goal that focuses the excerpts."
        },
        "search_queries": {
          "in": "body",
          "type": "array",
          "description": "Optional keyword queries that focus the excerpts."
        },
        "max_chars_total": {
          "in": "body",
          "type": "integer",
          "description": "Cap on total excerpt characters."
        },
        "session_id": {
          "in": "body",
          "type": "string",
          "description": "Ties related calls together."
        },
        "advanced_settings": {
          "in": "body",
          "type": "object",
          "description": "Fetch policy, excerpt settings, full content and links."
        }
      },
      "notes": [
        "A read over POST: it fetches pages and changes nothing in your account."
      ],
      "job": "web.extract",
      "docs_url": "https://docs.parallel.ai/api-reference/extract/extract.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/extract/extract.md"
      }
    },
    {
      "id": "parallel.task.run.create",
      "name": "Start a Task run",
      "summary": "Start an asynchronous deep-research or enrichment run with a chosen processor.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/tasks/runs",
      "params": {
        "input": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The task input: text, or a JSON object.",
          "example": "What was the GDP of France in 2023?"
        },
        "processor": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Processor tier (e.g. lite, base, core, pro, ultra); higher tiers cost more and take longer.",
          "example": "base"
        },
        "task_spec": {
          "in": "body",
          "type": "object",
          "description": "Input and output schemas; defaults to an automatic output schema."
        },
        "source_policy": {
          "in": "body",
          "type": "object",
          "description": "Included and excluded domains."
        },
        "previous_interaction_id": {
          "in": "body",
          "type": "string",
          "description": "Interaction id to chain context from."
        },
        "enable_events": {
          "in": "body",
          "type": "boolean",
          "description": "Record progress events."
        },
        "metadata": {
          "in": "body",
          "type": "object",
          "description": "String key-value metadata stored with the run."
        }
      },
      "notes": [
        "A read over POST: it starts a job that only produces data (it bills per run by processor).",
        "Returns at once with status queued; poll task.run.get, or block on task.run.result."
      ],
      "job": "research.start",
      "docs_url": "https://docs.parallel.ai/api-reference/tasks/create-task-run.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/tasks/create-task-run.md"
      }
    },
    {
      "id": "parallel.task.run.get",
      "name": "Get a Task run's status",
      "summary": "Status of one Task run.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/tasks/runs/{run_id}",
      "params": {
        "run_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Task run id."
        }
      },
      "job": "research.status",
      "docs_url": "https://docs.parallel.ai/api-reference/tasks/retrieve-task-run.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/tasks/retrieve-task-run.md"
      }
    },
    {
      "id": "parallel.task.run.result",
      "name": "Get a Task run's result",
      "summary": "The result of a run; blocks until the run completes or the timeout passes.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/tasks/runs/{run_id}/result",
      "params": {
        "run_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Task run id."
        },
        "timeout": {
          "in": "query",
          "type": "integer",
          "description": "Seconds to wait for completion."
        }
      },
      "job": "research.result",
      "docs_url": "https://docs.parallel.ai/api-reference/tasks/retrieve-task-run-result.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/tasks/retrieve-task-run-result.md"
      }
    },
    {
      "id": "parallel.entities.search",
      "name": "Search people or companies fast",
      "summary": "Fast synchronous ranked list of people or companies matching a description.",
      "kind": "read",
      "method": "POST",
      "path": "/v1beta/findall/entity-search",
      "params": {
        "entity_type": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "What to search for.",
          "example": "companies",
          "enum": [
            "people",
            "companies"
          ]
        },
        "objective": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Natural-language description of the target entities.",
          "example": "Series A fintech startups in London"
        },
        "match_limit": {
          "in": "body",
          "type": "integer",
          "description": "Most entities to return, 5-1000; default 100."
        }
      },
      "notes": [
        "A read over POST: it runs a search and changes nothing in your account.",
        "Beta path (/v1beta). Returns a fixed set of attributes; use FindAll runs for full match evaluation."
      ],
      "job": "company.search",
      "docs_url": "https://docs.parallel.ai/api-reference/findall/fast-entity-search.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/findall/fast-entity-search.md"
      }
    },
    {
      "id": "parallel.findall.run.create",
      "name": "Start a FindAll run",
      "summary": "Discover and evaluate entities against match conditions; asynchronous.",
      "kind": "read",
      "method": "POST",
      "path": "/v1beta/findall/runs",
      "params": {
        "objective": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Natural-language objective."
        },
        "entity_type": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Type of entity to find, e.g. companies."
        },
        "match_conditions": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Conditions each entity must meet."
        },
        "generator": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Generator tier.",
          "enum": [
            "preview",
            "base",
            "core",
            "pro"
          ]
        },
        "match_limit": {
          "in": "body",
          "type": "integer",
          "required": true,
          "description": "Most matches to find, 5-1000."
        },
        "exclude_list": {
          "in": "body",
          "type": "array",
          "description": "Entity names or ids to exclude, up to 10000."
        }
      },
      "notes": [
        "A read over POST: it starts a job that only produces data (billed per run).",
        "Beta path (/v1beta). Returns a run in status queued; poll findall.run.get."
      ],
      "job": "company.search",
      "docs_url": "https://docs.parallel.ai/api-reference/findall/create-findall-run.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/findall/create-findall-run.md"
      }
    },
    {
      "id": "parallel.findall.run.get",
      "name": "Get a FindAll run's status",
      "summary": "Status of a FindAll run.",
      "kind": "read",
      "method": "GET",
      "path": "/v1beta/findall/runs/{findall_id}",
      "params": {
        "findall_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "FindAll run id."
        }
      },
      "job": "jobs.status",
      "docs_url": "https://docs.parallel.ai/api-reference/findall/retrieve-findall-run-status.md",
      "verified": {
        "docs": "https://docs.parallel.ai/api-reference/findall/retrieve-findall-run-status.md"
      }
    }
  ]
}
