        "days": {
          "in": "query",
          "type": "string",
          "description": "Period: all (default), 7, 30, 60 or 90.",
          "enum": [
            "all",
            "7",
            "30",
            "60",
            "90"
          ]
        },
        "chain": {
          "in": "query",
          "type": "string",
          "description": "Chain name or hex chain ID; default eth. e.g. eth, base, polygon, bsc, arbitrum, optimism, avalanche, linea.",
          "example": "eth"
        }
      },
      "job": "crypto.account",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
      "verified": {
        "docs": "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json"
      }
    },
