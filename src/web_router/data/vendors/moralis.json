    {
      "id": "moralis.token.search",
      "name": "Search tokens",
      "summary": "Tokens matching a name, symbol, contract or pair address, across chains.",
      "kind": "read",
      "method": "GET",
      "path": "/tokens/search",
      "params": {
        "query": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Name, symbol, token or pair address.",
          "example": "pepe"
        },
        "chains": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated chains to search; default all.",
          "example": "eth,base"
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Results."
        },
        "isVerifiedContract": {
          "in": "query",
          "type": "boolean",
          "description": "Only verified contracts."
        },
        "sortBy": {
          "in": "query",
          "type": "string",
          "description": "volume1hDesc (default), volume24hDesc, liquidityDesc or marketCapDesc.",
          "enum": [
            "volume1hDesc",
            "volume24hDesc",
            "liquidityDesc",
            "marketCapDesc"
          ]
        }
      },
      "job": "crypto.assets",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
