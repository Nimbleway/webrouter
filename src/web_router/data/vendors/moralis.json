{
  "vendor": "moralis",
  "name": "Moralis",
  "category": "finance",
  "summary": "EVM blockchain data: wallet balances with prices, net worth, decoded history and PnL, token prices, metadata, holders and search, DEX candles, and NFT holdings and floor prices.",
  "docs_url": "https://docs.moralis.com/",
  "pricing_url": "https://docs.moralis.com/get-started/pricing",
  "base_url": "https://deep-index.moralis.io/api/v2.2",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "MORALIS_API_KEY"
        ],
        "description": "A Moralis API key (admin.moralis.com). Sent in the X-API-Key header."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-API-Key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "No self-serve free plan; paid plans include a monthly compute-unit (CU) allowance, and each endpoint costs a set number of CUs (info.endpoint_weights lists them). Multi-chain calls cost per chain.",
    "Rate limits are requests per second per plan (40 on Starter), measured over a rolling 4-second window; over it returns 429.",
    "chain takes a name (eth, base, polygon, bsc, arbitrum, optimism, avalanche, linea...) or hex chain ID; default eth.",
    "List endpoints page with cursor: pass the cursor from the previous response while one is returned."
  ],
  "sources": [
    "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json",
    "https://deep-index.moralis.io/api-docs-2.2/",
    "https://docs.moralis.com/get-started/pricing",
    "https://docs.moralis.com/llms.txt"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "moralis.wallet.tokens",
      "name": "Get a wallet's token balances with prices",
      "summary": "Native and ERC-20 balances with USD price, value, logos and spam flags.",
      "kind": "read",
      "method": "GET",
      "path": "/wallets/{address}/tokens",
      "params": {
        "address": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address.",
          "example": "0x0000000000000000000000000000000000000001"
        },
        "chain": {
          "in": "query",
          "type": "string",
          "description": "Chain name or hex chain ID; default eth. e.g. eth, base, polygon, bsc, arbitrum, optimism, avalanche, linea.",
          "example": "eth"
        },
        "token_addresses": {
          "in": "query",
          "type": "array",
          "description": "Only these token contracts."
        },
        "exclude_spam": {
          "in": "query",
          "type": "boolean",
          "description": "Leave out spam tokens; default false."
        },
        "exclude_unverified_contracts": {
          "in": "query",
          "type": "boolean",
          "description": "Leave out unverified contracts; default false."
        },
        "exclude_native": {
          "in": "query",
          "type": "boolean",
          "description": "Leave out the native balance."
        },
        "to_block": {
          "in": "query",
          "type": "integer",
          "description": "Balances as of this block."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Page size."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "cursor from the previous response, for the next page."
        }
      },
      "job": "crypto.account",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
      "verified": {
        "docs": "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json"
      }
    },
    {
      "id": "moralis.wallet.net_worth",
      "name": "Get a wallet's net worth",
      "summary": "Total USD value of a wallet, per chain and overall.",
      "kind": "read",
      "method": "GET",
      "path": "/wallets/{address}/net-worth",
      "params": {
        "address": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address.",
          "example": "0x0000000000000000000000000000000000000001"
        },
        "chains": {
          "in": "query",
          "type": "array",
          "description": "Chains to include, e.g. eth, base, polygon.",
          "example": [
            "eth",
            "base"
          ]
        },
        "exclude_spam": {
          "in": "query",
          "type": "boolean",
          "description": "Leave out spam tokens; default false."
        },
        "exclude_unverified_contracts": {
          "in": "query",
          "type": "boolean",
          "description": "Leave out unverified contracts; default false."
        },
        "min_pair_side_liquidity_usd": {
          "in": "query",
          "type": "number",
          "description": "Ignore tokens whose pair has less USD liquidity on one side.",
          "example": 1000
        }
      },
      "notes": [
        "Cost scales with the number of chains queried."
      ],
      "job": "crypto.account",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
      "verified": {
        "docs": "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json"
      }
    },
    {
      "id": "moralis.wallet.history",
      "name": "Get a wallet's decoded history",
      "summary": "Every transaction of a wallet, decoded, categorized (send, swap, NFT, approval...) and summarized.",
      "kind": "read",
      "method": "GET",
      "path": "/wallets/{address}/history",
      "params": {
        "address": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address.",
          "example": "0x0000000000000000000000000000000000000001"
        },
        "chain": {
          "in": "query",
          "type": "string",
          "description": "Chain name or hex chain ID; default eth. e.g. eth, base, polygon, bsc, arbitrum, optimism, avalanche, linea.",
          "example": "eth"
        },
        "from_block": {
          "in": "query",
          "type": "integer",
          "description": "Lowest block; or use from_date."
        },
        "to_block": {
          "in": "query",
          "type": "integer",
          "description": "Highest block; or use to_date."
        },
        "from_date": {
          "in": "query",
          "type": "string",
          "description": "Start, Unix seconds or a date string.",
          "example": "2024-01-01"
        },
        "to_date": {
          "in": "query",
          "type": "string",
          "description": "End, Unix seconds or a date string."
        },
        "include_internal_transactions": {
          "in": "query",
          "type": "boolean",
          "description": "Include internal transactions."
        },
        "nft_metadata": {
          "in": "query",
          "type": "boolean",
          "description": "Include NFT metadata."
        },
        "order": {
          "in": "query",
          "type": "string",
          "description": "DESC (default, newest first) or ASC.",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Page size."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "cursor from the previous response, for the next page."
        }
      },
      "job": "crypto.transactions",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
      "verified": {
        "docs": "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json"
      }
    },
    {
      "id": "moralis.wallet.erc20_transfers",
      "name": "List a wallet's ERC-20 transfers",
      "summary": "ERC-20 transfers in and out of a wallet, newest first.",
      "kind": "read",
      "method": "GET",
      "path": "/{address}/erc20/transfers",
      "params": {
        "address": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address.",
          "example": "0x0000000000000000000000000000000000000001"
        },
        "chain": {
          "in": "query",
          "type": "string",
          "description": "Chain name or hex chain ID; default eth. e.g. eth, base, polygon, bsc, arbitrum, optimism, avalanche, linea.",
          "example": "eth"
        },
        "from_block": {
          "in": "query",
          "type": "integer",
          "description": "Lowest block; or use from_date."
        },
        "to_block": {
          "in": "query",
          "type": "integer",
          "description": "Highest block; or use to_date."
        },
        "from_date": {
          "in": "query",
          "type": "string",
          "description": "Start, Unix seconds or a date string.",
          "example": "2024-01-01"
        },
        "to_date": {
          "in": "query",
          "type": "string",
          "description": "End, Unix seconds or a date string."
        },
        "contract_addresses": {
          "in": "query",
          "type": "array",
          "description": "Only these token contracts."
        },
        "order": {
          "in": "query",
          "type": "string",
          "description": "DESC (default, newest first) or ASC.",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Page size."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "cursor from the previous response, for the next page."
        }
      },
      "notes": [
        "value is in the token's smallest unit; a decimal-adjusted value_decimal comes alongside."
      ],
      "job": "crypto.transfers",
      "docs_url": "https://deep-index.moralis.io/api-docs-2.2/",
      "verified": {
        "docs": "https://deep-index.moralis.io/api-docs-2.2/v2.2/swagger.json"
      }
    },
    {
      "id": "moralis.wallet.profitability_summary",
      "name": "Get a wallet's profit and loss",
      "summary": "Realized profit and loss, trade counts and volume of a wallet over a period.",
