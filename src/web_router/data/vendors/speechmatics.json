{
  "vendor": "speechmatics",
  "name": "Speechmatics",
  "category": "ai",
  "data": "service",
  "summary": "Batch speech-to-text jobs on Speechmatics: list jobs, read their status and transcripts, and check usage.",
  "docs_url": "https://docs.speechmatics.com/api-ref/batch/create-a-new-job",
  "pricing_url": "https://www.speechmatics.com/pricing",
  "base_url": "https://{region}.asr.api.speechmatics.com/v2",
  "settings": {
    "region": {
      "env": [
        "SPEECHMATICS_REGION"
      ],
      "default": "eu1",
      "choices": [
        "eu1",
        "eu2",
        "us1",
        "us2",
        "au1"
      ],
      "description": "The batch region. A job lives in the region it was created in and every call about it must use that region. eu2 and us2 are for enterprise failover only."
    }
  },
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "SPEECHMATICS_API_KEY"
        ],
        "description": "a Speechmatics API key (portal, API Keys)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Creating a job (POST /jobs) takes multipart/form-data (a JSON 'config' part plus an optional audio file), which this catalog cannot send; submit jobs with Speechmatics' SDK or CLI and read them here.",
    "Jobs are asynchronous: poll speechmatics.jobs.get until status is done, then fetch the transcript. The wait query parameter blocks server-side for a few seconds instead of polling.",
    "Transcripts come as json-v2 (words with timings and confidences), txt or srt."
  ],
  "sources": [
    "https://docs.speechmatics.com/batch.yaml",
    "https://docs.speechmatics.com/api-ref/batch/create-a-new-job",
    "https://docs.speechmatics.com/api-ref/batch/list-all-jobs",
    "https://docs.speechmatics.com/api-ref/batch/get-the-transcript-for-a-transcription-job",
    "https://docs.speechmatics.com/administration/regions"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "speechmatics.jobs.list",
      "name": "List batch jobs",
      "summary": "Your most recent jobs first, with status, config and duration.",
      "kind": "read",
      "method": "GET",
      "path": "/jobs",
      "params": {
        "created_before": {
          "in": "query",
          "type": "string",
          "description": "UTC timestamp cursor: only jobs created before it. Page by passing the oldest created_at seen.",
          "example": "2026-11-01T00:00:00Z"
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Jobs to return, 1-100; no limit by default."
        },
        "include_deleted": {
          "in": "query",
          "type": "boolean",
          "description": "Include deleted jobs; default false."
        }
      },
      "job": "jobs.list",
      "docs_url": "https://docs.speechmatics.com/api-ref/batch/list-all-jobs",
      "verified": {
        "docs": "https://docs.speechmatics.com/api-ref/batch/list-all-jobs"
      }
    },
    {
      "id": "speechmatics.jobs.get",
      "name": "Get a job's details",
      "summary": "A job's status (running, done, rejected, deleted, expired), config and any errors.",
      "kind": "read",
      "method": "GET",
      "path": "/jobs/{jobid}",
      "params": {
        "jobid": {
          "in": "path",
          "type": "string",
          "required": true,
          "example": "a1b2c3d4e5"
        },
        "wait": {
          "in": "query",
          "type": "integer",
          "description": "Seconds to block until the job reaches a terminal state (capped server-side); 0 answers at once. Always 200 with the current state."
        }
      },
      "job": "jobs.status",
      "docs_url": "https://docs.speechmatics.com/batch.yaml",
      "verified": {
        "docs": "https://docs.speechmatics.com/batch.yaml"
      }
    },
    {
      "id": "speechmatics.jobs.transcript",
      "name": "Get a job's transcript",
      "summary": "The finished transcript as json-v2, plain text or SRT subtitles.",
      "kind": "read",
      "method": "GET",
      "path": "/jobs/{jobid}/transcript",
      "params": {
        "jobid": {
          "in": "path",
          "type": "string",
          "required": true,
          "example": "a1b2c3d4e5"
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "Output format; default json-v2.",
          "enum": [
            "json-v2",
            "txt",
            "srt"
          ]
        },
        "wait": {
          "in": "query",
          "type": "integer",
          "description": "Seconds to block until the transcript is ready; 404 if still not ready, so retry."
        }
      },
      "job": "jobs.result",
      "docs_url": "https://docs.speechmatics.com/api-ref/batch/get-the-transcript-for-a-transcription-job",
      "verified": {
        "docs": "https://docs.speechmatics.com/api-ref/batch/get-the-transcript-for-a-transcription-job"
      }
    },
    {
      "id": "speechmatics.usage.get",
      "name": "Get usage statistics",
      "summary": "Hours of audio processed per mode, type, language and model between two dates.",
      "kind": "read",
      "method": "GET",
      "path": "/usage",
      "params": {
        "since": {
          "in": "query",
          "type": "string",
          "description": "Start date, inclusive, YYYY-MM-DD.",
          "example": "2026-10-01"
        },
        "until": {
          "in": "query",
          "type": "string",
          "description": "End date, inclusive, YYYY-MM-DD.",
          "example": "2026-10-31"
        }
      },
      "job": "account.usage",
      "docs_url": "https://docs.speechmatics.com/batch.yaml",
      "verified": {
        "docs": "https://docs.speechmatics.com/batch.yaml"
      }
    },
    {
      "id": "speechmatics.jobs.delete",
      "name": "Delete a job",
      "summary": "Deletes a job and its audio and transcript.",
      "kind": "write",
      "method": "DELETE",
      "path": "/jobs/{jobid}",
      "params": {
        "jobid": {
          "in": "path",
          "type": "string",
          "required": true
        },
        "force": {
          "in": "query",
          "type": "boolean",
          "description": "Terminate a running job; without it a running job answers 423 Locked."
        }
      },
      "job": "jobs.delete",
      "docs_url": "https://docs.speechmatics.com/batch.yaml",
      "verified": {
        "docs": "https://docs.speechmatics.com/batch.yaml"
      }
    }
  ]
}
