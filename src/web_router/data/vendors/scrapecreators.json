          "in": "query",
          "type": "string",
          "description": "Two-letter country code to route the request through."
        },
        "trim": {
          "in": "query",
          "type": "boolean",
          "description": "True for a smaller response."
        },
        "cursor": {
          "in": "query",
          "type": "number",
          "description": "Cursor from the previous response."
