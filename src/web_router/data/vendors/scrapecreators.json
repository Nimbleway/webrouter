{
  "vendor": "scrapecreators",
  "name": "Scrape Creators",
  "category": "social",
  "summary": "Public social media data over one API: TikTok, Instagram, YouTube, X, LinkedIn and Reddit profiles, posts, comments and search.",
  "docs_url": "https://docs.scrapecreators.com",
  "base_url": "https://api.scrapecreators.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "SCRAPECREATORS_API_KEY"
        ],
        "description": "Scrape Creators API key (dashboard > API Key)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "x-api-key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Credit-based: each request uses credits and some options (include_replies, long transcription) cost more. account.credits shows the balance.",
    "Public data only, found by URL or handle; paging is by a cursor-like token whose name differs per endpoint (cursor, max_cursor, next_max_id, continuationToken, after, page).",
    "Set trim=true where offered for a much smaller response; cache_max_age lets a cached answer stand in for a fresh call.",
    "X and LinkedIn post search go through Google, so coverage is partial.",
    "download_media is left out: it stores the media in the user's Scrape Creators account."
  ],
  "sources": [
    "https://docs.scrapecreators.com/openapi.json",
    "https://docs.scrapecreators.com"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "scrapecreators.account.credits",
      "name": "Get the credit balance",
      "summary": "Credits left on the account (field creditCount).",
      "kind": "read",
      "method": "GET",
      "path": "/v1/account/credit-balance",
      "params": {},
      "job": "account.usage",
      "docs_url": "https://docs.scrapecreators.com/openapi.json",
      "verified": {
        "docs": "https://docs.scrapecreators.com/openapi.json"
      },
      "notes": []
    },
    {
      "id": "scrapecreators.tiktok.profile",
      "name": "Get a TikTok profile",
      "summary": "Public bio, identity and stats of a TikTok account.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/tiktok/profile",
      "params": {
        "handle": {
          "in": "query",
          "type": "string",
          "description": "The account handle, without @."
        },
        "user_id": {
          "in": "query",
          "type": "string",
          "description": "The platform's numeric user id."
        },
        "cache_max_age": {
          "in": "query",
          "type": "string",
          "description": "Accept a cached answer this old or newer (1d to 30d).",
          "enum": [
            "1d",
            "3d",
            "7d",
            "14d",
            "30d"
          ]
        }
      },
      "job": "social.profile",
      "docs_url": "https://docs.scrapecreators.com/openapi.json",
      "verified": {
        "docs": "https://docs.scrapecreators.com/openapi.json"
      },
      "notes": []
    },
    {
      "id": "scrapecreators.tiktok.profile_videos",
      "name": "List a TikTok user's videos",
      "summary": "Videos posted by a user, latest or most popular, paged by max_cursor.",
      "kind": "read",
      "method": "GET",
      "path": "/v3/tiktok/profile/videos",
      "params": {
        "handle": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "The account handle, without @."
        },
        "user_id": {
          "in": "query",
          "type": "string",
          "description": "The platform's numeric user id."
        },
        "sort_by": {
          "in": "query",
          "type": "string",
          "description": "Sort order.",
          "enum": [
            "latest",
            "popular"
          ]
        },
        "region": {
          "in": "query",
          "type": "string",
          "description": "Two-letter country code to route the request through."
        },
        "include_pinned": {
          "in": "query",
          "type": "boolean",
          "description": "Include pinned posts (default true)."
        },
        "trim": {
          "in": "query",
          "type": "boolean",
          "description": "True for a smaller response."
        },
        "max_cursor": {
          "in": "query",
          "type": "string",
          "description": "max_cursor from the previous response."
        }
      },
      "job": "social.posts",
      "docs_url": "https://docs.scrapecreators.com/openapi.json",
      "verified": {
        "docs": "https://docs.scrapecreators.com/openapi.json"
      },
      "notes": []
    },
