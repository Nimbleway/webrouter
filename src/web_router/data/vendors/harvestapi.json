{
  "vendor": "harvestapi",
  "name": "HarvestAPI",
  "category": "social",
  "summary": "LinkedIn data without a LinkedIn login: profiles, companies, jobs, posts, comments and reactions, searchable by filters.",
  "docs_url": "https://docs.harvestapi.io",
  "base_url": "https://api.harvestapi.io",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "HARVESTAPI_API_KEY"
        ],
        "description": "A HarvestAPI key (harvestapi.io/admin/api-keys)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-API-Key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Public LinkedIn data only. The API also has connection and messaging calls that use your own LinkedIn account; they are not listed here.",
    "Paging is by page number, and list endpoints that return a paginationToken want it back for later pages.",
    "Concurrency is limited by plan (1 request at once on Free, up to 40 on Business); extra requests queue (10 deep), then error.",
    "Many filters take comma-separated lists; all parameters are query strings."
  ],
  "sources": [
    "https://docs.harvestapi.io",
    "https://docs.harvestapi.io/guides/concurrency.md",
    "https://docs.harvestapi.io/linkedin-api-reference/openapi.json",
    "https://docs.harvestapi.io/platform-api-reference/openapi.json"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "harvestapi.account.me",
      "name": "Get your API user",
      "summary": "Details of the account tied to the API key.",
      "kind": "read",
      "method": "GET",
      "path": "/users/my-api-user",
      "params": {},
      "job": "account.usage",
      "docs_url": "https://docs.harvestapi.io/platform-api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.harvestapi.io/platform-api-reference/openapi.json"
      }
    },
    {
      "id": "harvestapi.linkedin.profile",
      "name": "Get a LinkedIn profile",
      "summary": "Profile details by URL, public identifier or id; optionally find the email.",
      "kind": "read",
      "method": "GET",
      "path": "/linkedin/profile",
      "params": {
        "query": {
          "in": "query",
          "type": "string",
          "description": "URL, public identifier or id of the target."
        },
        "main": {
          "in": "query",
          "type": "string",
          "description": "'true' for only the main profile version."
        },
        "findEmail": {
          "in": "query",
          "type": "string",
          "description": "'true' to also find the email (SMTP-verified)."
        }
      },
      "job": "people.enrich",
      "docs_url": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json"
      },
      "notes": [
        "Give query."
      ]
    },
    {
      "id": "harvestapi.linkedin.profile_search",
      "name": "Search LinkedIn profiles",
      "summary": "Profiles by name, company, school, title or location, paged by page.",
      "kind": "read",
      "method": "GET",
      "path": "/linkedin/profile-search",
      "params": {
        "search": {
          "in": "query",
          "type": "string",
          "description": "Search keywords."
        },
        "currentCompany": {
          "in": "query",
          "type": "string",
          "description": "Company id or URL; comma-separated for several."
        },
        "pastCompany": {
          "in": "query",
          "type": "string",
          "description": "Past company id or URL, comma-separated."
        },
        "school": {
          "in": "query",
          "type": "string",
          "description": "School id or URL, comma-separated."
        },
        "firstName": {
          "in": "query",
          "type": "string",
          "description": "First name."
        },
        "lastName": {
          "in": "query",
          "type": "string",
          "description": "Last name."
        },
        "title": {
          "in": "query",
          "type": "string",
          "description": "Job title."
        },
        "location": {
          "in": "query",
          "type": "string",
          "description": "Location text."
        },
        "geoId": {
          "in": "query",
          "type": "string",
          "description": "LinkedIn Geo ID; overrides location."
        },
        "industryId": {
          "in": "query",
          "type": "string",
          "description": "Industry id, comma-separated for several."
        },
        "keywordsCompany": {
          "in": "query",
          "type": "string",
          "description": "Keywords in company name."
        },
        "keywordsSchool": {
          "in": "query",
          "type": "string",
          "description": "Keywords in school name."
        },
        "followerOf": {
          "in": "query",
          "type": "string",
          "description": "Only followers of this profile (URL or id)."
        },
        "page": {
          "in": "query",
          "type": "string",
          "description": "Page number, from 1."
        }
      },
      "job": "people.search",
      "docs_url": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json"
      }
    },
    {
      "id": "harvestapi.linkedin.profile_by_email",
      "name": "Find a profile by work email",
      "summary": "Reverse lookup of the person behind a work email.",
      "kind": "read",
      "method": "GET",
      "path": "/linkedin/profile-by-email",
      "params": {
        "email": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "The work email to look up."
        },
        "firstName": {
          "in": "query",
          "type": "string",
          "description": "First name."
        },
        "lastName": {
          "in": "query",
          "type": "string",
          "description": "Last name."
        }
      },
      "job": "people.enrich",
      "docs_url": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json"
      }
    },
    {
      "id": "harvestapi.linkedin.profile_posts",
      "name": "List a profile's posts",
      "summary": "Posts by a profile, paged by page and paginationToken.",
      "kind": "read",
      "method": "GET",
      "path": "/linkedin/profile-posts",
      "params": {
        "profile": {
          "in": "query",
          "type": "string",
          "description": "Profile URL, public identifier or id."
        },
        "postedLimit": {
          "in": "query",
          "type": "string",
          "description": "Posted within: 24h, week or month."
        },
        "scrapePostedLimit": {
          "in": "query",
          "type": "string",
          "description": "Filter by age after scraping: 1h, 24h, week, month, 3months, ..."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, from 1."
        },
        "paginationToken": {
          "in": "query",
          "type": "string",
          "description": "paginationToken from the previous page, where the endpoint asks for it."
        }
      },
      "job": "social.posts",
      "docs_url": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json",
      "verified": {
        "docs": "https://docs.harvestapi.io/linkedin-api-reference/openapi.json"
