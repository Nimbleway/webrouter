{
  "vendor": "financialdatasets",
  "name": "Financial Datasets",
  "category": "finance",
  "data": "public",
  "summary": "US public-company prices, financial statements, metrics, SEC filings, insider and institutional holdings, and macro series.",
  "docs_url": "https://docs.financialdatasets.ai/introduction",
  "pricing_url": "https://financialdatasets.ai",
  "base_url": "https://api.financialdatasets.ai",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "FINANCIAL_DATASETS_API_KEY"
        ],
        "description": "a Financial Datasets API key (financialdatasets.ai dashboard)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "X-API-KEY",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Dates are YYYY-MM-DD. period is annual, quarterly or ttm.",
    "List endpoints page by cursor: each response carries next_page_url until the last page; limit is the total across pages, not a page size (pages hold up to 10).",
    "Insufficient credit answers 402; some endpoints (webhooks, a few feeds) need higher plans.",
    "Non-US fundamentals: set market to UK or FR, or pass an isin."
  ],
  "sources": [
    "https://docs.financialdatasets.ai/quickstart.md",
    "https://docs.financialdatasets.ai/guides/pagination.md",
    "https://docs.financialdatasets.ai/api/openapi.json"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "financialdatasets.prices.history",
      "name": "Get historical stock prices",
      "summary": "End-of-day open, high, low, close and volume for a US ticker.",
      "kind": "read",
      "method": "GET",
      "path": "/prices",
      "params": {
        "ticker": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Ticker symbol, e.g. AAPL.",
          "example": "AAPL"
        },
        "interval": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Bar size.",
          "example": "day",
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        },
        "start_date": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Start, YYYY-MM-DD.",
          "example": "2026-01-01"
        },
        "end_date": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "End, YYYY-MM-DD.",
          "example": "2026-11-01"
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Pagination cursor from a previous next_page_url; when sent, other parameters are ignored."
        }
      },
      "notes": [
        "Paginated: follow next_page_url exactly as given until it is absent."
      ],
      "job": "market.history",
      "docs_url": "https://docs.financialdatasets.ai/api/prices/historical.md",
      "verified": {
        "docs": "https://docs.financialdatasets.ai/api/prices/historical.md"
      }
    },
    {
      "id": "financialdatasets.prices.snapshot",
      "name": "Get the latest stock price",
      "summary": "Latest price with day change and day change percent.",
      "kind": "read",
      "method": "GET",
      "path": "/prices/snapshot",
      "params": {
        "ticker": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Ticker symbol, e.g. AAPL.",
          "example": "AAPL"
        }
      },
      "job": "market.quote",
      "docs_url": "https://docs.financialdatasets.ai/api/prices/snapshot.md",
      "verified": {
        "docs": "https://docs.financialdatasets.ai/api/prices/snapshot.md"
      }
    },
    {
      "id": "financialdatasets.prices.market_snapshot",
      "name": "Get a snapshot of the whole US market",
      "summary": "Latest price and day change of every actively traded US stock.",
      "kind": "read",
      "method": "GET",
      "path": "/prices/snapshot/market",
      "notes": [
        "Very large response."
      ],
      "job": "market.quote",
      "docs_url": "https://docs.financialdatasets.ai/api/prices/market-snapshot.md",
      "verified": {
        "docs": "https://docs.financialdatasets.ai/api/prices/market-snapshot.md"
      }
    },
    {
      "id": "financialdatasets.financials.income_statements",
      "name": "Get income statements",
      "summary": "Income statements, annual, quarterly or trailing twelve months.",
      "kind": "read",
      "method": "GET",
      "path": "/financials/income-statements",
      "params": {
        "ticker": {
          "in": "query",
          "type": "string",
          "description": "Ticker; required unless cik or isin is given.",
          "example": "AAPL"
        },
        "period": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Reporting period.",
          "example": "annual",
          "enum": [
            "annual",
            "quarterly",
            "ttm"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Maximum records in total across all pages; each page holds up to 10."
        },
        "cik": {
          "in": "query",
          "type": "string",
          "description": "SEC Central Index Key, instead of ticker."
        },
        "market": {
          "in": "query",
          "type": "string",
          "description": "US (default), UK or FR.",
          "enum": [
            "US",
            "UK",
            "FR"
          ]
        },
        "isin": {
          "in": "query",
          "type": "string",
          "description": "ISIN of a non-US listing, instead of ticker."
        },
        "report_period_gte": {
          "in": "query",
          "type": "string",
          "description": "Report period on or after, YYYY-MM-DD."
        },
        "report_period_lte": {
          "in": "query",
          "type": "string",
          "description": "Report period on or before, YYYY-MM-DD."
        },
        "filing_date_gte": {
          "in": "query",
          "type": "string",
          "description": "SEC filing date on or after, YYYY-MM-DD."
        },
        "filing_date_lte": {
          "in": "query",
          "type": "string",
          "description": "SEC filing date on or before, YYYY-MM-DD; use for point-in-time work."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Pagination cursor from a previous next_page_url; when sent, other parameters are ignored."
        }
      },
      "notes": [
        "Paginated: follow next_page_url exactly as given until it is absent."
      ],
      "job": "market.fundamentals",
      "docs_url": "https://docs.financialdatasets.ai/api/financials/income-statements.md",
      "verified": {
        "docs": "https://docs.financialdatasets.ai/api/financials/income-statements.md"
      }
    },
