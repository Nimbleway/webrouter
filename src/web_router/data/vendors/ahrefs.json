          "required": true,
          "example": "2026-11-01"
        },
        "target": {
          "in": "query",
          "type": "string",
          "description": "Domain or URL.",
          "required": true,
          "example": "ahrefs.com"
        },
        "mode": {
          "in": "query",
          "type": "string",
          "description": "Scope of the target.",
          "enum": [
            "exact",
            "prefix",
            "domain",
            "subdomains"
          ]
        },
        "protocol": {
          "in": "query",
          "type": "string",
          "description": "Protocol of the target.",
          "enum": [
            "both",
            "http",
            "https"
          ]
        },
        "country": {
          "in": "query",
          "type": "string",
          "description": "Two-letter country code (ISO 3166-1 alpha-2).",
          "example": "us"
        },
        "volume_mode": {
          "in": "query",
          "type": "string",
          "description": "Search volume mode; affects volume, traffic and traffic value.",
          "enum": [
            "monthly",
            "average"
          ]
        },
        "traffic_mode": {
          "in": "query",
          "type": "string",
          "description": "Organic traffic mode.",
          "enum": [
            "static",
            "adaptive"
          ]
        },
        "output": {
          "in": "query",
          "type": "string",
          "description": "Output format; default json.",
          "enum": [
            "json",
            "csv",
            "xml",
            "php"
          ]
        }
      },
      "job": "domain.overview",
      "docs_url": "https://docs.ahrefs.com/reference/site-explorer.json",
      "verified": {
        "docs": "https://docs.ahrefs.com/reference/site-explorer.json"
      }
    },
