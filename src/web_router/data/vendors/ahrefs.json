{
  "vendor": "ahrefs",
  "name": "Ahrefs",
  "category": "seo",
  "summary": "Ahrefs API v3: Domain Rating, backlinks, referring domains, organic keywords, top pages and keyword metrics.",
  "docs_url": "https://docs.ahrefs.com/api/docs/introduction.md",
  "pricing_url": "https://ahrefs.com/pricing",
  "base_url": "https://api.ahrefs.com/v3",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "AHREFS_API_KEY"
        ],
        "description": "An Ahrefs API v3 key (Account settings > API keys; workspace owners and admins only). Sent as a Bearer token."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "API access needs an eligible paid plan; other plans only get a limited set of free test queries.",
    "Billing is in API units: each request costs max(50, per-row cost x rows), where a field costs 1 unit by default and some metrics 5 or 10. Select few columns and set limit.",
    "60 requests per minute by default; 429 also comes from load-based throttling.",
    "Most site-explorer and keyword calls require select (columns) and date; dates are YYYY-MM-DD."
  ],
  "sources": [
    "https://docs.ahrefs.com/api/docs/introduction.md",
    "https://docs.ahrefs.com/api/docs/limits-consumption.md",
    "https://docs.ahrefs.com/openapi.json",
    "https://docs.ahrefs.com/reference/site-explorer.json",
    "https://docs.ahrefs.com/reference/keywords-explorer.json"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "ahrefs.domain_rating",
      "name": "Get Domain Rating",
      "summary": "Domain Rating (0-100) and Ahrefs Rank of a domain on a date.",
      "kind": "read",
      "method": "GET",
      "path": "/site-explorer/domain-rating",
      "params": {
        "date": {
          "in": "query",
          "type": "string",
          "description": "Date to report on, YYYY-MM-DD.",
          "required": true,
          "example": "2026-11-01"
        },
        "target": {
          "in": "query",
          "type": "string",
          "description": "Domain or URL.",
          "required": true,
          "example": "ahrefs.com"
        },
        "output": {
          "in": "query",
          "type": "string",
          "description": "Output format; default json.",
          "enum": [
            "json",
            "csv",
            "xml",
            "php"
          ]
        }
      },
      "job": "domain.rank",
      "docs_url": "https://docs.ahrefs.com/reference/site-explorer.json",
      "verified": {
        "docs": "https://docs.ahrefs.com/reference/site-explorer.json"
      }
    },
    {
      "id": "ahrefs.metrics",
      "name": "Get site organic and paid metrics",
      "summary": "Organic keywords, traffic and value, plus paid metrics, for a domain or URL.",
      "kind": "read",
      "method": "GET",
      "path": "/site-explorer/metrics",
      "params": {
        "date": {
          "in": "query",
          "type": "string",
