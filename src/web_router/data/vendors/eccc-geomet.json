          "description": "RFC 3339 instant or interval; .. leaves an end open, e.g. 2020-01-01/..",
          "example": "2020-01-01/2020-01-31"
        },
        "sortby": {
          "in": "query",
          "type": "string",
          "description": "Property to sort by; prefix with - for descending.",
          "example": "-LOCAL_DATE"
        },
        "properties": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated properties to return."
        },
        "skipGeometry": {
          "in": "query",
          "type": "boolean",
          "description": "true to drop geometries."
        },
        "STATION_NAME": {
          "in": "query",
          "type": "string",
          "description": "Station name."
        },
        "CLIMATE_IDENTIFIER": {
          "in": "query",
          "type": "string",
          "description": "Climate id, e.g. 6158355."
        },
        "PROV_STATE_TERR_CODE": {
          "in": "query",
          "type": "string",
          "description": "Province/territory code, e.g. ON."
        },
        "STN_ID": {
          "in": "query",
          "type": "integer",
          "description": "Numeric station id."
        }
      },
      "job": "weather.stations",
      "docs_url": "https://api.weather.gc.ca/openapi?f=html",
      "verified": {
        "docs": "https://api.weather.gc.ca/openapi?f=html"
      }
    },
    {
      "id": "eccc-geomet.climate.daily",
