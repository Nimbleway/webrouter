    {
      "id": "rentcast.markets.get",
      "name": "Get market statistics for a ZIP code",
      "summary": "Average/median sale and rent figures for a ZIP, by property type and bedrooms, with monthly history.",
      "kind": "read",
      "method": "GET",
      "path": "/markets",
      "params": {
        "zipCode": {
          "in": "query",
          "type": "string",
          "description": "Five-digit US ZIP code.",
          "required": true,
          "example": "29611"
        },
        "dataType": {
          "in": "query",
          "type": "string",
          "description": "Which statistics, default All.",
          "enum": [
            "All",
            "Sale",
            "Rental"
          ]
        },
        "historyRange": {
          "in": "query",
          "type": "integer",
          "description": "Months of history to include (default 12 per the description)."
        }
      },
      "job": "property.market",
      "docs_url": "https://developers.rentcast.io/reference/market-statistics",
      "verified": {
        "docs": "https://developers.rentcast.io/reference/market-statistics"
