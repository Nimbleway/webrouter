{
  "vendor": "commoditypriceapi",
  "name": "Commodity Price API",
  "category": "finance",
  "summary": "Latest, historical, intraday and time-series prices for metals, oil, agricultural and other commodities.",
  "docs_url": "https://commoditypriceapi.com/docs",
  "pricing_url": "https://commoditypriceapi.com/pricing",
  "base_url": "https://api.commoditypriceapi.com/v3",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "COMMODITYPRICEAPI_API_KEY"
        ],
        "description": "a Commodity Price API key (commoditypriceapi.com dashboard)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "x-api-key",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Every 2xx response counts against the monthly quota; 4xx and 5xx do not.",
    "Symbols are case-insensitive codes (XAU, WTIOIL-FUT, BRENTOIL-SPOT); list them with commoditypriceapi.symbols. Unrecognised symbols come back under 'unresolved' with status 206.",
    "Each plan caps symbols per request; going over returns 402. Endpoints a plan does not include also return 402.",
    "The quote currency parameter is ignored on the Basic and legacy Lite plans."
  ],
  "sources": [
    "https://commoditypriceapi.com/docs"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "commoditypriceapi.rates.latest",
      "name": "Get latest commodity prices",
      "summary": "Latest prices for one or more commodities.",
      "kind": "read",
      "method": "GET",
      "path": "/rates/latest",
      "params": {
        "symbols": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Comma-separated symbols.",
          "example": "XAU,WTIOIL-FUT"
        },
        "quote": {
          "in": "query",
          "type": "string",
          "description": "Quote currency; defaults to each commodity's own currency.",
          "example": "EUR"
        },
        "metadata": {
          "in": "query",
          "type": "boolean",
          "description": "Include metadata; default true."
        }
      },
      "notes": [
        "Prices may be delayed up to 10 minutes depending on the plan."
      ],
      "job": "market.quote",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.rates.latest_symbol",
      "name": "Get real-time price of one commodity",
      "summary": "Per-second price of one of the main metals or oil benchmarks, optionally per gram, tola or carat.",
      "kind": "read",
      "method": "GET",
      "path": "/rates/latest/{symbol}",
      "params": {
        "symbol": {
          "in": "path",
          "type": "string",
          "required": true,
          "enum": [
            "XAU",
            "XAG",
            "WTIOIL-SPOT",
            "WTIOIL-FUT",
            "BRENTOIL-SPOT",
            "BRENTOIL-FUT",
            "XCU-SPOT",
            "XCU-FUT",
            "XPT",
            "XPD"
          ],
          "example": "XAU",
          "description": "Commodity symbol."
        },
        "quote": {
          "in": "query",
          "type": "string",
          "description": "Quote currency."
        },
        "include": {
          "in": "query",
          "type": "string",
          "description": "Extra units: gram or tola for XAG, XPT, XPD; gram, tola or carat for XAU; none for copper or oil."
        },
        "metadata": {
          "in": "query",
          "type": "boolean",
          "description": "Include metadata; default true."
        }
      },
      "job": "market.quote",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.rates.historical",
      "name": "Get commodity prices on a date",
      "summary": "Prices for one or more commodities on a past date (from 1990-01-01).",
      "kind": "read",
      "method": "GET",
      "path": "/rates/historical",
      "params": {
        "symbols": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Comma-separated symbols.",
          "example": "XAU"
        },
        "date": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Date, YYYY-MM-DD.",
          "example": "2024-01-15"
        }
      },
      "notes": [
        "Falls back to the last earlier rate; 404 RATE_NOT_FOUND when there is none."
      ],
      "job": "market.history",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.rates.time_series",
      "name": "Get commodity price time series",
      "summary": "Daily prices for one or more commodities over a date range of up to 365 days.",
      "kind": "read",
      "method": "GET",
      "path": "/rates/time-series",
      "params": {
        "symbols": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Comma-separated symbols.",
          "example": "XAU"
        },
        "startDate": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Start date, YYYY-MM-DD.",
          "example": "2024-01-01"
        },
        "endDate": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "End date, YYYY-MM-DD; at most 365 days after startDate.",
          "example": "2024-03-31"
        }
      },
      "notes": [
        "Standard, Advanced and Enterprise plans only; Basic gets 402."
      ],
      "job": "market.history",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.rates.fluctuation",
      "name": "Get commodity price change between dates",
      "summary": "Start and end price and change for one or more commodities between two dates.",
      "kind": "read",
      "method": "GET",
      "path": "/rates/fluctuation",
      "params": {
        "symbols": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Comma-separated symbols.",
          "example": "XAU"
        },
        "startDate": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Start date, YYYY-MM-DD."
        },
        "endDate": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "End date, YYYY-MM-DD."
        }
      },
      "notes": [
        "Standard, Advanced and Enterprise plans only; Basic gets 402. No range limit."
      ],
      "job": "market.history",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.rates.intraday",
      "name": "Get intraday commodity prices",
      "summary": "Intraday bars for one commodity on one UTC day.",
      "kind": "read",
      "method": "GET",
      "path": "/rates/intraday",
      "params": {
        "symbols": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Exactly one symbol.",
          "example": "XAU"
        },
        "interval": {
          "in": "query",
          "type": "string",
          "required": true,
          "enum": [
            "1m",
            "5m",
            "10m",
            "15m",
            "30m",
            "45m",
            "1h",
            "2h",
            "4h",
            "8h",
            "12h",
            "1d"
          ],
          "example": "1h",
          "description": "Bar interval."
        },
        "date": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "UTC date, YYYY-MM-DD, not in the future.",
          "example": "2026-11-06"
        },
        "startTime": {
          "in": "query",
          "type": "string",
          "description": "HH:mm UTC on an interval mark; default 00:00. Pass the response's nextStartTime to page."
        },
        "metadata": {
          "in": "query",
          "type": "boolean",
          "description": "Include metadata; default true."
        }
      },
      "notes": [
        "Advanced and Enterprise plans only (402 otherwise, not counted).",
        "At most 100 points per response; page with nextStartTime.",
        "Only for symbols updated every second, minute or 10 minutes; others return 400."
      ],
      "job": "market.history",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.symbols",
      "name": "List commodity symbols",
      "summary": "Supported symbols, optionally filtered by underlying or contract type.",
      "kind": "read",
      "method": "GET",
      "path": "/symbols",
      "params": {
        "underlying": {
          "in": "query",
          "type": "string",
          "description": "Filter by underlying, e.g. WTIOIL-FUT."
        },
        "contract": {
          "in": "query",
          "type": "string",
          "enum": [
            "futures",
            "spot"
          ],
          "description": "Filter by contract type."
        },
        "includeExpired": {
          "in": "query",
          "type": "boolean",
          "description": "Include expired contracts; default false."
        }
      },
      "job": "market.symbols",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    },
    {
      "id": "commoditypriceapi.usage",
      "name": "Get API usage",
      "summary": "The key's plan and quota usage.",
      "kind": "read",
      "method": "GET",
      "path": "/usage",
      "job": "account.usage",
      "docs_url": "https://commoditypriceapi.com/docs",
      "verified": {
        "docs": "https://commoditypriceapi.com/docs"
      }
    }
  ]
}
