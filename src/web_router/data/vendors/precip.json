          "required": true,
          "example": "41.5868"
        },
        "longitude": {
          "in": "query",
          "type": "string",
          "description": "WGS84 longitude; a comma-separated list only with a commercial key.",
          "required": true,
          "example": "-93.625"
        },
        "timeZoneId": {
          "in": "query",
          "type": "string",
          "description": "IANA time zone for timestamps and day boundaries, default America/Chicago."
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "Output format, default json.",
          "enum": [
            "json",
            "geojson",
            "csv"
          ]
        }
      },
      "job": "weather.precipitation",
      "docs_url": "https://api-docs.precip.ai/api/precipitation-data",
      "verified": {
        "docs": "https://api-docs.precip.ai/api/precipitation-data"
      }
    },
    {
      "id": "precip.precip.minutely",
      "name": "Get minutely precipitation rate",
      "summary": "Minute-by-minute precipitation rate, observed then nowcast for the next 60 minutes.",
      "kind": "read",
      "method": "GET",
      "path": "/minutely",
      "params": {
        "latitude": {
          "in": "query",
          "type": "string",
          "description": "WGS84 latitude; a comma-separated list only with a commercial key.",
          "required": true,
          "example": "41.5868"
        },
        "longitude": {
          "in": "query",
          "type": "string",
          "description": "WGS84 longitude; a comma-separated list only with a commercial key.",
          "required": true,
          "example": "-93.625"
        },
        "start": {
          "in": "query",
          "type": "string",
          "description": "Date, datetime or relative (now-1h); default now-1h."
        },
        "end": {
          "in": "query",
          "type": "string",
          "description": "Date, datetime or relative (now+1h); default now+1h; at most 7 days after start."
        },
        "units": {
          "in": "query",
          "type": "string",
          "description": "metric gives mm/h, imperial in/h; default metric.",
          "enum": [
            "metric",
            "imperial"
          ]
        },
        "timeZoneId": {
          "in": "query",
          "type": "string",
          "description": "IANA time zone for timestamps and day boundaries, default America/Chicago."
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "Output format, default json.",
          "enum": [
            "json",
            "geojson",
            "csv"
          ]
        }
      },
      "notes": [
        "source on each row says observation, nowcast or forecast."
      ],
      "job": "weather.precipitation",
      "docs_url": "https://api-docs.precip.ai/api/precipitation-data",
      "verified": {
        "docs": "https://api-docs.precip.ai/api/precipitation-data"
      }
    },
    {
      "id": "precip.precip.last",
      "name": "Get precipitation over the last N hours",
      "summary": "Total precipitation over the last 12, 24, 48 or 168 hours.",
      "kind": "read",
      "method": "GET",
      "path": "/last-{hours}",
      "params": {
        "hours": {
          "in": "path",
          "type": "string",
          "required": true,
          "enum": [
            "12",
            "24",
            "48",
            "168"
          ],
          "description": "Look-back window in hours."
        },
        "latitude": {
          "in": "query",
          "type": "string",
          "description": "WGS84 latitude; a comma-separated list only with a commercial key.",
          "required": true,
          "example": "41.5868"
        },
        "longitude": {
          "in": "query",
