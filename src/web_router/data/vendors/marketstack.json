        },
        "date_to": {
          "in": "query",
          "type": "string",
          "description": "To date, YYYY-MM-DD."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Results; default 100."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Results to skip."
        }
      },
      "docs_url": "https://docs.apilayer.com/marketstack/docs/marketstack-api-v2-v-2-0-0",
      "verified": {
        "docs": "https://docs.apilayer.com/marketstack/docs/marketstack-api-v2-v-2-0-0"
      }
    }
  ]
}
