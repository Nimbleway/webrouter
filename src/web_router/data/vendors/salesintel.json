    {
      "id": "salesintel.company.technologies",
      "name": "Append technologies to companies",
      "summary": "Whether named companies use the given technologies, by domain or name.",
      "kind": "read",
      "method": "GET",
      "path": "/service/technologies/append",
      "params": {
        "company_domain": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated domains (recommended)."
        },
        "company_name": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated names, matched by 'contains'."
        },
        "tech_category": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated (~) categories from the taxonomy."
        },
        "tech_subcategory": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated sub-categories."
        },
        "tech_product": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated products from the taxonomy."
        },
        "tech_vendor": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated vendors."
        },
        "is_international": {
          "in": "query",
          "type": "boolean",
          "description": "false: US-based, true: outside the US."
        },
        "verified": {
          "in": "query",
          "type": "boolean",
          "description": "Human-verified records only."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number."
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Records per page, default 50."
        }
      },
      "notes": [
        "Charged per company returned, whether or not it uses the technologies. Needs the technographics add-on."
      ],
      "job": "company.technologies",
      "docs_url": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis",
      "verified": {
        "docs": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis"
      }
    },
    {
      "id": "salesintel.reference.tech_categories",
      "name": "List technology categories",
      "summary": "The category and sub-category taxonomy for the technology filters.",
      "kind": "read",
      "method": "GET",
      "path": "/service/technologies/taxonomy/categories",
      "notes": [
        "Free, but needs account access."
      ],
      "job": "reference.keywords",
      "docs_url": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis",
      "verified": {
        "docs": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis"
      }
    },
    {
      "id": "salesintel.reference.tech_products",
      "name": "Search technology products",
      "summary": "Products and vendors in the technology taxonomy matching a name.",
      "kind": "read",
      "method": "GET",
      "path": "/service/technologies/taxonomy/products",
      "params": {
        "product": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated product names, matched by 'contains'; this or vendor is required."
        },
        "vendor": {
          "in": "query",
          "type": "string",
          "description": "Tilde-separated vendor names; this or product is required."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number."
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Records per page, default 50."
        }
      },
      "notes": [
        "Free, but needs account access."
      ],
      "job": "reference.keywords",
      "docs_url": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis",
      "verified": {
        "docs": "https://developer.salesintel.io/salesintel-api-documentation/technographic-apis"
      }
    },
    {
      "id": "salesintel.company.news",
      "name": "Get company news",
      "summary": "News articles about companies, by domain, filtered by category, event type and date.",
      "kind": "read",
      "method": "GET",
      "path": "/service/news",
      "params": {
        "company_domains": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Comma-separated domains."
        },
        "published_begin_date": {
          "in": "query",
          "type": "string",
          "description": "Published on or after, yyyyMMdd."
        },
        "extracted_begin_date": {
          "in": "query",
          "type": "string",
          "description": "Found by SalesIntel on or after, yyyyMMdd; best for keeping a list current."
        },
        "location_country_codes": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated ISO-2 codes; one article can repeat per country."
        },
        "news_categories": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated news categories."
        },
        "news_event_types": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated news types."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number."
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "description": "Records per page, default 50."
        }
      },
      "notes": [
        "Charged per article on the pages fetched. About 6 months of news, extracted since 2023-02-20."
      ],
      "job": "news.search",
      "docs_url": "https://developer.salesintel.io/salesintel-api-documentation/news-apis",
      "verified": {
        "docs": "https://developer.salesintel.io/salesintel-api-documentation/news-apis"
      }
    }
  ]
}
