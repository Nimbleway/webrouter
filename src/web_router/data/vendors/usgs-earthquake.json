          "description": "Circle radius in km (exclusive with maxradius)."
        },
        "maxradius": {
          "in": "query",
          "type": "number",
          "description": "Circle radius in degrees, 0..180."
        },
        "minmagnitude": {
          "in": "query",
          "type": "number",
          "description": "Minimum magnitude.",
          "example": 4.5
        },
        "maxmagnitude": {
          "in": "query",
          "type": "number",
          "description": "Maximum magnitude."
        },
        "mindepth": {
          "in": "query",
          "type": "number",
          "description": "Minimum depth in km, -100..1000."
        },
        "maxdepth": {
          "in": "query",
          "type": "number",
          "description": "Maximum depth in km, -100..1000."
        },
        "eventtype": {
          "in": "query",
          "type": "string",
          "description": "Event type; earthquake excludes blasts and other non-earthquakes."
        },
        "alertlevel": {
          "in": "query",
          "type": "string",
          "description": "PAGER alert level.",
          "enum": [
            "green",
            "yellow",
            "orange",
            "red"
          ]
        },
        "minsig": {
          "in": "query",
          "type": "integer",
          "description": "Minimum significance."
        },
        "reviewstatus": {
          "in": "query",
          "type": "string",
          "description": "automatic, reviewed or all (default).",
          "enum": [
            "automatic",
            "reviewed",
            "all"
          ]
        },
        "catalog": {
          "in": "query",
          "type": "string",
          "description": "Limit to one catalog (catalogs.list)."
        },
        "contributor": {
          "in": "query",
          "type": "string",
          "description": "Limit to one contributor."
        },
        "producttype": {
          "in": "query",
          "type": "string",
          "description": "Only events with this product, e.g. shakemap, losspager, dyfi, moment-tensor."
        }
      },
      "notes": [
        "format here is text (default), geojson or xml."
      ],
      "job": "events.list",
      "docs_url": "https://earthquake.usgs.gov/fdsnws/event/1/",
      "verified": {
        "docs": "https://earthquake.usgs.gov/fdsnws/event/1/"
      }
    },
    {
