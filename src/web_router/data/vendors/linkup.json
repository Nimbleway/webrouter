{
  "vendor": "linkup",
  "name": "Linkup",
  "category": "search",
  "data": "public",
  "summary": "Agentic web search, page fetch and asynchronous research with sourced answers from Linkup.",
  "docs_url": "https://docs.linkup.so/pages/documentation/get-started/introduction",
  "pricing_url": "https://www.linkup.so/pricing",
  "base_url": "https://api.linkup.so",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "LINKUP_API_KEY"
        ],
        "description": "a Linkup API key (app.linkup.so)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Auth is 'Authorization: Bearer <key>'. Without a key the API answers 402 with x402 pay-per-request details; this entry uses the key.",
    "Linkup also has /tasks (batch wrapper around search, fetch and research) and a closed-beta /extract, not in this entry.",
    "Dates are YYYY-MM-DD."
  ],
  "sources": [
    "https://docs.linkup.so/llms.txt",
    "https://api.linkup.so/v1/openapi.json"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "linkup.search.query",
      "name": "Search the web",
      "summary": "Agentic web search returning sources, a sourced answer or structured data.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/search",
      "params": {
        "q": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Natural-language question.",
          "example": "What is Microsoft's 2024 revenue?"
        },
        "depth": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Search mode: flash is lowest latency, deep the most thorough.",
          "example": "standard",
          "enum": [
            "flash",
            "fast",
            "standard",
            "deep"
          ]
        },
        "outputType": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "searchResults for sources and snippets, sourcedAnswer, or structured.",
          "example": "searchResults",
          "enum": [
            "searchResults",
            "sourcedAnswer",
            "structured"
          ]
        },
        "structuredOutputSchema": {
          "in": "body",
          "type": "string",
          "description": "JSON Schema (as a string, root type object) of the output; required when outputType is structured."
        },
        "includeSources": {
          "in": "body",
          "type": "boolean",
          "description": "With structured output, also return sources; this changes the response shape."
        },
        "includeInlineCitations": {
          "in": "body",
          "type": "boolean",
          "description": "With sourcedAnswer, include inline citations."
        },
        "includeImages": {
          "in": "body",
          "type": "boolean",
          "description": "Include images in results."
        },
        "maxResults": {
          "in": "body",
          "type": "integer",
          "description": "Most results to return."
        },
        "includeDomains": {
          "in": "body",
          "type": "array",
          "description": "Domains to search on, up to 100.",
          "example": [
            "microsoft.com"
          ]
        },
        "excludeDomains": {
          "in": "body",
          "type": "array",
          "description": "Domains to leave out."
        },
        "fromDate": {
          "in": "body",
          "type": "string",
          "description": "Earliest date considered, YYYY-MM-DD."
        },
        "toDate": {
          "in": "body",
          "type": "string",
          "description": "Latest date considered, YYYY-MM-DD."
        }
      },
      "notes": [
        "A read over POST: it runs a search and changes nothing in your account.",
        "Cost per call depends on depth; deeper modes cost more credits and take longer.",
        "429 can mean a rate limit or insufficient credits."
      ],
      "job": "web.search",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/search/reference.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/search/reference.md"
      }
    },
    {
      "id": "linkup.fetch.page",
      "name": "Fetch a page as markdown",
      "summary": "Clean markdown from any public URL, HTML or PDF, optionally with JS rendering or schema-based extraction.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/fetch",
      "params": {
        "url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The page to fetch.",
          "example": "https://docs.linkup.so"
        },
        "renderJs": {
          "in": "body",
          "type": "boolean",
          "description": "Render the page's JavaScript."
        },
        "mode": {
          "in": "body",
          "type": "string",
          "description": "Fetch strategy; pro succeeds more often on hard pages.",
          "enum": [
            "standard",
            "pro"
          ]
        },
        "includeRawContent": {
          "in": "body",
          "type": "boolean",
          "description": "Include raw page content and its content type."
        },
        "extractImages": {
          "in": "body",
          "type": "boolean",
          "description": "Extract images from the page."
        },
        "schema": {
          "in": "body",
          "type": "object",
          "description": "JSON Schema describing structured data to extract from the page."
        },
        "instructions": {
          "in": "body",
          "type": "string",
          "description": "Guidance for extraction; requires schema."
        }
      },
      "notes": [
        "A read over POST: it fetches a page and changes nothing in your account.",
        "includeRawHtml is deprecated; use includeRawContent."
      ],
      "job": "web.extract",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/fetch/reference.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/fetch/reference.md"
      }
    },
    {
      "id": "linkup.research.create",
      "name": "Start a research task",
      "summary": "Start an asynchronous research agent that browses the web to produce a sourced answer.",
      "kind": "read",
      "method": "POST",
      "path": "/v1/research",
      "params": {
        "q": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "The question to research.",
          "example": "Compare the leading vector databases for 2026"
        },
        "outputType": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "sourcedAnswer or structured.",
          "example": "sourcedAnswer",
          "enum": [
            "sourcedAnswer",
            "structured"
          ]
        },
        "structuredOutputSchema": {
          "in": "body",
          "type": "string",
          "description": "JSON Schema (as a string, root type object) of the output; required when outputType is structured."
        },
        "mode": {
          "in": "body",
          "type": "string",
          "description": "Pin the agent mode; omit to auto-classify.",
          "enum": [
            "auto",
            "answer",
            "investigate",
            "research"
          ]
        },
        "reasoningDepth": {
          "in": "body",
          "type": "string",
          "description": "Reasoning depth S < M < L < XL; default L.",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "includeDomains": {
          "in": "body",
          "type": "array",
          "description": "Domains to search on, up to 100.",
          "example": [
            "microsoft.com"
          ]
        },
        "excludeDomains": {
          "in": "body",
          "type": "array",
          "description": "Domains to leave out."
        },
        "fromDate": {
          "in": "body",
          "type": "string",
          "description": "Earliest date considered, YYYY-MM-DD."
        },
        "toDate": {
          "in": "body",
          "type": "string",
          "description": "Latest date considered, YYYY-MM-DD."
        }
      },
      "notes": [
        "A read over POST: it starts a job that only produces data.",
        "Async: returns a task id at once; poll research.get. Higher reasoning depths take longer and cost more."
      ],
      "job": "research.start",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/research/post.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/research/post.md"
      }
    },
    {
      "id": "linkup.research.get",
      "name": "Get a research task",
      "summary": "Status and result of one research task.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/research/{id}",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Research task id."
        }
      },
      "job": "research.status",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/research/get.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/research/get.md"
      }
    },
    {
      "id": "linkup.research.list",
      "name": "List research tasks",
      "summary": "Your organization's research tasks, paginated.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/research",
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number."
        },
        "pageSize": {
          "in": "query",
          "type": "integer",
          "description": "Tasks per page."
        },
        "sortBy": {
          "in": "query",
          "type": "string",
          "description": "Sort field.",
          "enum": [
            "createdAt",
            "updatedAt"
          ]
        },
        "sortDirection": {
          "in": "query",
          "type": "string",
          "description": "Sort direction.",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "job": "research.list",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/research/list.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/research/list.md"
      }
    },
    {
      "id": "linkup.credits.balance",
      "name": "Get the credit balance",
      "summary": "Credits left in your account.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/credits/balance",
      "job": "account.usage",
      "docs_url": "https://docs.linkup.so/pages/documentation/endpoints/account/balance.md",
      "verified": {
        "docs": "https://docs.linkup.so/pages/documentation/endpoints/account/balance.md"
      }
    }
  ]
}
