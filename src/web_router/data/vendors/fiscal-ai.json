          "in": "query",
          "type": "string",
          "description": "Fiscal.ai stable company identifier instead of ticker."
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "1-based page."
        }
      },
      "job": "company.documents",
      "docs_url": "https://api.fiscal.ai/docs",
      "verified": {
        "docs": "https://api.fiscal.ai/docs"
      }
    },
    {
      "id": "fiscal-ai.news.company",
      "name": "Get company news",
      "summary": "News about one company, filterable by event type and importance.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/company/news",
      "params": {
        "ticker": {
          "in": "query",
          "type": "string",
          "description": "Ticker; alone for US tickers, else with exchange or micCode.",
          "example": "MSFT"
        },
        "exchange": {
          "in": "query",
          "type": "string",
          "description": "Exchange code, with ticker."
        },
        "micCode": {
          "in": "query",
          "type": "string",
          "description": "Market identifier code (MIC), with ticker."
        },
        "companyKey": {
          "in": "query",
          "type": "string",
          "description": "EXCHANGE_TICKER key instead of ticker.",
          "example": "NASDAQ_MSFT"
        },
        "cik": {
          "in": "query",
          "type": "string",
          "description": "SEC CIK instead of ticker."
        },
        "fscl": {
          "in": "query",
          "type": "string",
          "description": "Fiscal.ai stable company identifier instead of ticker."
        },
        "startDate": {
          "in": "query",
          "type": "string",
          "description": "YYYY-MM-DD; defaults to a recent window of about two weeks."
        },
        "endDate": {
          "in": "query",
          "type": "string",
          "description": "YYYY-MM-DD."
        },
        "eventType": {
          "in": "query",
          "type": "string",
          "enum": [
            "earnings",
            "guidance",
            "dividend",
            "stock_split",
            "buyback",
            "ma",
            "partnership",
            "product_launch",
            "expansion",
            "regulatory",
            "legal",
            "executive",
            "restructuring",
            "financing",
            "technology",
            "esg",
            "analyst",
            "market_commentary",
            "other"
          ]
        },
        "importance": {
          "in": "query",
          "type": "integer",
          "description": "1 to 5."
        },
        "directArticle": {
          "in": "query",
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      },
      "job": "news.search",
      "docs_url": "https://api.fiscal.ai/docs",
      "verified": {
        "docs": "https://api.fiscal.ai/docs"
      }
    },
    {
      "id": "fiscal-ai.transcripts.get",
      "name": "Get an earnings call transcript",
      "summary": "Speakers, text, paragraphs and timing of one earnings call.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/company/ir-events/transcript/{eventKey}",
      "params": {
        "eventKey": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "q{quarter}-{year}.",
          "example": "q2-2025"
        },
        "ticker": {
          "in": "query",
          "type": "string",
          "description": "Ticker; alone for US tickers, else with exchange or micCode.",
          "example": "MSFT"
        },
        "exchange": {
          "in": "query",
          "type": "string",
          "description": "Exchange code, with ticker."
        },
        "micCode": {
          "in": "query",
          "type": "string",
          "description": "Market identifier code (MIC), with ticker."
        },
        "companyKey": {
          "in": "query",
          "type": "string",
          "description": "EXCHANGE_TICKER key instead of ticker.",
          "example": "NASDAQ_MSFT"
        },
        "cik": {
          "in": "query",
          "type": "string",
          "description": "SEC CIK instead of ticker."
        },
        "fscl": {
          "in": "query",
          "type": "string",
          "description": "Fiscal.ai stable company identifier instead of ticker."
        }
      },
      "notes": [
        "List a company's events and their keys with /v1/company/ir-events."
      ],
      "docs_url": "https://api.fiscal.ai/docs",
      "verified": {
        "docs": "https://api.fiscal.ai/docs"
      }
    }
  ]
}
