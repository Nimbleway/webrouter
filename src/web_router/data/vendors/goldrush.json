      "job": "crypto.account",
      "docs_url": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-historical-portfolio-value-over-time",
      "verified": {
        "docs": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-historical-portfolio-value-over-time"
      }
    },
    {
