    {
      "id": "goldrush.pricing.historical",
      "name": "Get historical token prices",
      "summary": "Daily prices of one or more tokens between two dates.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/pricing/historical_by_addresses_v2/{chainName}/{quoteCurrency}/{contractAddress}/",
      "params": {
        "chainName": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Chain name, e.g. eth-mainnet, base-mainnet, matic-mainnet, bsc-mainnet (list with goldrush.chains.list).",
          "example": "eth-mainnet"
        },
        "quoteCurrency": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Currency, e.g. USD.",
          "example": "USD"
        },
        "contractAddress": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Token contract, or several separated by commas.",
          "example": "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"
        },
        "from": {
          "in": "query",
          "type": "string",
          "description": "First day, YYYY-MM-DD.",
          "example": "2024-01-01"
        },
        "to": {
          "in": "query",
