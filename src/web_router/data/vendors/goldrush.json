          "wire_name": "page-size"
        },
        "page_number": {
          "in": "query",
          "type": "integer",
          "description": "Page, counted from 0.",
          "wire_name": "page-number"
        }
      },
      "notes": [
        "0.05 credits per item returned."
      ],
      "job": "crypto.transfers",
      "docs_url": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-erc20-token-transfers-for-address",
      "verified": {
        "docs": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-erc20-token-transfers-for-address"
      }
    },
