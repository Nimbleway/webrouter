{
  "vendor": "goldrush",
  "name": "GoldRush (formerly Covalent)",
  "category": "finance",
  "summary": "Multichain wallet and token data from GoldRush, formerly Covalent: balances with prices, portfolio history, transactions, transfers, token holders, approvals, NFTs and historical token prices.",
  "docs_url": "https://goldrush.dev/docs/",
  "pricing_url": "https://goldrush.dev/pricing",
  "base_url": "https://api.covalenthq.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "GOLDRUSH_API_KEY"
        ],
        "description": "A GoldRush API key (goldrush.dev platform). Sent as an Authorization Bearer header."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Calls cost API credits, per call or per item returned (listed per endpoint); an item costs only when it is returned, a call only on a 200.",
    "Plans: 14-day free trial with 25,000 credits a month at 4 requests/second; paid plans raise both.",
    "Responses wrap the payload: check error before reading data; data.items holds the rows.",
    "Pages are counted from 0, up to 100 items each by default.",
    "Balances are raw integer strings; divide by 10^contract_decimals."
  ],
  "sources": [
    "https://goldrush.dev/docs/llms.txt",
    "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-token-balances-for-address",
    "https://goldrush.dev/docs/api-reference/foundational-api/cross-chain/get-allchains-balances",
    "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-historical-portfolio-value-over-time",
    "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-erc20-token-transfers-for-address",
    "https://goldrush.dev/docs/api-reference/foundational-api/transactions/get-recent-transactions-for-address-v3",
    "https://goldrush.dev/docs/api-reference/foundational-api/transactions/get-transaction-summary-for-address",
    "https://goldrush.dev/docs/api-reference/foundational-api/transactions/get-a-transaction",
    "https://goldrush.dev/docs/api-reference/foundational-api/nft/get-nfts-for-address",
    "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-token-holders-as-of-any-block-height-v2",
    "https://goldrush.dev/docs/api-reference/foundational-api/security/get-token-approvals-for-address",
    "https://goldrush.dev/docs/api-reference/foundational-api/cross-chain/get-address-activity",
    "https://goldrush.dev/docs/api-reference/foundational-api/utility/get-historical-token-prices",
    "https://goldrush.dev/docs/api-reference/foundational-api/utility/get-all-chains"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "goldrush.balances.tokens",
      "name": "Get a wallet's token balances",
      "summary": "Native and ERC-20 balances of a wallet with spot prices and USD values.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/{chainName}/address/{walletAddress}/balances_v2/",
      "params": {
        "chainName": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Chain name, e.g. eth-mainnet, base-mainnet, matic-mainnet, bsc-mainnet (list with goldrush.chains.list).",
          "example": "eth-mainnet"
        },
        "walletAddress": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address; ENS, RNS, Lens handles and Unstoppable Domains resolve.",
          "example": "demo.eth"
        },
        "quote_currency": {
          "in": "query",
          "type": "string",
          "description": "Currency for values: USD (default), EUR, GBP, CAD, JPY, CHF, AUD, INR and more.",
          "example": "USD",
          "wire_name": "quote-currency"
        },
        "no_spam": {
          "in": "query",
          "type": "boolean",
          "description": "Drop suspected spam tokens.",
          "wire_name": "no-spam"
        }
      },
      "notes": [
        "1 credit per call.",
        "balance is a raw integer string; divide by 10^contract_decimals."
      ],
      "job": "crypto.account",
      "docs_url": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-token-balances-for-address",
      "verified": {
        "docs": "https://goldrush.dev/docs/api-reference/foundational-api/balances/get-token-balances-for-address"
      }
    },
    {
      "id": "goldrush.balances.all_chains",
      "name": "Get a wallet's balances across chains",
      "summary": "Native and token balances of one address on up to 10 EVM chains in one call.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/allchains/address/{walletAddress}/balances/",
      "params": {
        "walletAddress": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address; domain names are not supported here.",
          "example": "0xfc43f5f9dd45258b3aff31bdbe6561d97e8b71de"
        },
        "chains": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated chain names or IDs; default all foundational chains.",
          "example": "eth-mainnet,base-mainnet"
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Balances per page, at most 100."
        },
        "before": {
          "in": "query",
          "type": "string",
          "description": "Pagination cursor from the previous response."
        },
        "cutoff_timestamp": {
          "in": "query",
          "type": "integer",
          "description": "Balances as of the nearest block before this Unix time.",
          "wire_name": "cutoff-timestamp"
        },
        "quote_currency": {
          "in": "query",
          "type": "string",
          "description": "Currency for values: USD (default), EUR, GBP, CAD, JPY, CHF, AUD, INR and more.",
          "example": "USD",
          "wire_name": "quote-currency"
        }
      },
      "notes": [
        "2.5 credits per call."
      ],
      "job": "crypto.account",
      "docs_url": "https://goldrush.dev/docs/api-reference/foundational-api/cross-chain/get-allchains-balances",
      "verified": {
        "docs": "https://goldrush.dev/docs/api-reference/foundational-api/cross-chain/get-allchains-balances"
      }
    },
    {
      "id": "goldrush.balances.portfolio",
      "name": "Get a wallet's daily portfolio value",
      "summary": "Daily holdings and value of a wallet, by token, over recent days.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/{chainName}/address/{walletAddress}/portfolio_v2/",
      "params": {
        "chainName": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Chain name, e.g. eth-mainnet, base-mainnet, matic-mainnet, bsc-mainnet (list with goldrush.chains.list).",
          "example": "eth-mainnet"
        },
        "walletAddress": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Wallet address; ENS, RNS, Lens handles and Unstoppable Domains resolve.",
          "example": "demo.eth"
        },
        "quote_currency": {
          "in": "query",
          "type": "string",
          "description": "Currency for values: USD (default), EUR, GBP, CAD, JPY, CHF, AUD, INR and more.",
