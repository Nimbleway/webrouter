        },
        "tag": {
          "in": "query",
          "type": "string",
          "description": "latest, or a hex block number within the last 128 blocks.",
          "example": "latest"
        }
      },
      "notes": [
        "Balances are strings in wei."
      ],
      "job": "crypto.account",
      "docs_url": "https://docs.etherscan.io/api-reference/endpoint/balancemulti.md",
      "verified": {
        "docs": "https://docs.etherscan.io/api-reference/endpoint/balancemulti.md"
      }
    },
    {
      "id": "etherscan.account.txlist",
      "name": "List an address's transactions",
      "summary": "Normal (external) transactions sent from or to an address.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/api",
      "params": {
        "chainid": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Chain ID: 1 Ethereum, 137 Polygon, 42161 Arbitrum, 8453 Base, 56 BNB Chain... (supported-chains page; some chains need a paid plan).",
          "example": "1"
        },
        "module": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Always account.",
          "example": "account",
          "enum": [
            "account"
          ]
        },
        "action": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Always txlist.",
          "example": "txlist",
          "enum": [
            "txlist"
          ]
        },
        "address": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Address.",
          "example": "0xc5102fE9359FD9a28f877a67E36B0F050d81a3CC"
        },
        "startblock": {
          "in": "query",
          "type": "integer",
          "description": "First block to search from.",
          "example": 0
        },
        "endblock": {
          "in": "query",
          "type": "integer",
          "description": "Last block to search to.",
          "example": 99999999
        },
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number.",
          "example": 1
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Records per page.",
          "example": 100
        },
        "sort": {
          "in": "query",
          "type": "string",
          "description": "asc (oldest first) or desc (latest first).",
          "example": "desc",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "notes": [
        "value and gasPrice are wei strings; timeStamp is Unix seconds.",
        "Page with page and offset; narrow with startblock/endblock for long histories."
      ],
      "job": "crypto.transactions",
      "docs_url": "https://docs.etherscan.io/api-reference/endpoint/txlist.md",
      "verified": {
        "docs": "https://docs.etherscan.io/api-reference/endpoint/txlist.md"
      }
    },
