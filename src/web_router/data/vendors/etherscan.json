{
  "vendor": "etherscan",
  "name": "Etherscan",
  "category": "finance",
  "summary": "EVM blockchain explorer data across 50+ chains with one key: balances, transactions, token and NFT transfers, token holders, contract source and ABI, event logs and gas prices.",
  "docs_url": "https://docs.etherscan.io/",
  "pricing_url": "https://etherscan.io/apis",
  "base_url": "https://api.etherscan.io",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "ETHERSCAN_API_KEY"
        ],
        "description": "An Etherscan API key (etherscan.io > API Keys). Sent as the apikey query parameter; one key covers every supported chain."
      }
    },
    "inject": [
      {
        "in": "query",
        "name": "apikey",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Every call is GET /v2/api with chainid, module and action; each endpoint here fixes module and action, and chainid picks the chain.",
    "Free plan: 3 calls/second and 100,000 calls/day on the free-tier chains only (Base, BNB Chain, OP, Avalanche and others need a paid plan). Calls past the daily cap are blocked until it resets.",
    "Endpoints marked PRO need the Standard plan or above.",
    "status '0' means an error or simply no records; read message and result.",
    "Amounts are integer strings in the smallest unit: wei for native balances, 10^decimals for tokens."
  ],
  "sources": [
    "https://docs.etherscan.io/endpoint-overview.md",
    "https://docs.etherscan.io/rate-limits.md",
    "https://docs.etherscan.io/supported-chains.md",
    "https://docs.etherscan.io/api-reference/endpoint/balance.md",
    "https://docs.etherscan.io/api-reference/endpoint/balancemulti.md",
    "https://docs.etherscan.io/api-reference/endpoint/txlist.md",
    "https://docs.etherscan.io/api-reference/endpoint/txlistinternal.md",
    "https://docs.etherscan.io/api-reference/endpoint/tokentx.md",
    "https://docs.etherscan.io/api-reference/endpoint/tokennfttx.md",
    "https://docs.etherscan.io/api-reference/endpoint/addresstokenbalance.md",
    "https://docs.etherscan.io/api-reference/endpoint/tokeninfo.md",
    "https://docs.etherscan.io/api-reference/endpoint/tokenholderlist.md",
    "https://docs.etherscan.io/api-reference/endpoint/tokensupply.md",
    "https://docs.etherscan.io/api-reference/endpoint/getsourcecode.md",
    "https://docs.etherscan.io/api-reference/endpoint/getabi.md",
    "https://docs.etherscan.io/api-reference/endpoint/getlogs.md",
    "https://docs.etherscan.io/api-reference/endpoint/getblocknobytime.md",
    "https://docs.etherscan.io/api-reference/endpoint/gasoracle.md",
    "https://docs.etherscan.io/api-reference/endpoint/ethprice.md"
  ],
  "curated": "2026-11-16",
  "endpoints": [
    {
      "id": "etherscan.account.balance",
      "name": "Get an address's native balance",
      "summary": "Native token (ETH, POL...) balance of one address.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/api",
      "params": {
        "chainid": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Chain ID: 1 Ethereum, 137 Polygon, 42161 Arbitrum, 8453 Base, 56 BNB Chain... (supported-chains page; some chains need a paid plan).",
          "example": "1"
        },
        "module": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Always account.",
          "example": "account",
          "enum": [
            "account"
          ]
        },
        "action": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Always balance.",
          "example": "balance",
          "enum": [
            "balance"
          ]
        },
        "address": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Address.",
          "example": "0xde0b295669a9fd93d5f28d9ec85e40f4cb697bae"
        },
        "tag": {
          "in": "query",
          "type": "string",
          "description": "latest, or a hex block number within the last 128 blocks.",
          "example": "latest"
        }
      },
      "notes": [
        "Result is a string in wei; divide by 10^18."
      ],
      "job": "crypto.account",
      "docs_url": "https://docs.etherscan.io/api-reference/endpoint/balance.md",
      "verified": {
        "docs": "https://docs.etherscan.io/api-reference/endpoint/balance.md"
      }
    },
    {
