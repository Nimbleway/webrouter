{
  "vendor": "assemblyai",
  "name": "AssemblyAI",
  "category": "ai",
  "summary": "Speech-to-text for audio and video files by URL, with speaker labels, PII redaction, subtitles and word search.",
  "docs_url": "https://www.assemblyai.com/docs/api-reference/overview",
  "pricing_url": "https://www.assemblyai.com/pricing",
  "base_url": "https://{api_host}",
  "settings": {
    "api_host": {
      "env": [
        "ASSEMBLYAI_API_HOST"
      ],
      "default": "api.assemblyai.com",
      "choices": [
        "api.assemblyai.com",
        "api.eu.assemblyai.com"
      ],
      "description": "api.assemblyai.com processes data in the US; api.eu.assemblyai.com in the EU. A transcript can only be read back on the host that made it."
    }
  },
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "ASSEMBLYAI_API_KEY"
        ],
        "description": "An AssemblyAI API key (assemblyai.com dashboard > API Keys)."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "Transcription is asynchronous: assemblyai.transcript.create returns an id with status queued; poll assemblyai.transcript.get until status is completed or error.",
    "Audio must be reachable at a URL. Uploading a local file (POST /v2/upload, a binary body) is not in this entry.",
    "Limits: parallel transcriptions (5 on a free account, 200+ paid; extra ones queue), 20,000 HTTP requests per 5 minutes per account (403 beyond), and 60 GETs per minute per transcript id.",
    "Billed per hour of audio transcribed, plus per-feature add-ons."
  ],
  "sources": [
    "https://www.assemblyai.com/docs/api-reference/overview",
    "https://www.assemblyai.com/docs/pre-recorded-audio/select-the-region",
    "https://www.assemblyai.com/docs/pre-recorded-audio/rate-limits",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/submit",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/list",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/delete",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-sentences",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-paragraphs",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-subtitles",
    "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/word-search"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "assemblyai.transcript.create",
      "name": "Transcribe an audio file",
      "summary": "Start transcribing the audio or video at a URL, with optional speech-understanding features.",
      "kind": "read",
      "method": "POST",
      "path": "/v2/transcript",
      "params": {
        "audio_url": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "URL of the audio or video file.",
          "example": "https://assembly.ai/wildfires.mp3"
        },
        "speech_models": {
          "in": "body",
          "type": "array",
          "description": "Models in priority order: universal-3-5-pro, universal-2. Default both."
        },
        "language_code": {
          "in": "body",
          "type": "string",
          "description": "Language of the audio, e.g. en_us; see Supported Languages."
        },
        "language_detection": {
          "in": "body",
          "type": "boolean",
          "description": "Detect the spoken language automatically."
        },
        "speaker_labels": {
          "in": "body",
          "type": "boolean",
          "description": "Speaker diarization; needs punctuate true."
        },
        "speakers_expected": {
          "in": "body",
          "type": "integer",
          "description": "How many speakers to look for; needs speaker_labels."
        },
        "multichannel": {
          "in": "body",
          "type": "boolean",
          "description": "Transcribe each audio channel separately."
        },
        "keyterms_prompt": {
          "in": "body",
          "type": "array",
          "description": "Domain words or phrases to boost (up to 200 on Universal-2, 1000 on Universal-3.5 Pro; 6 words each)."
        },
        "prompt": {
          "in": "body",
          "type": "string",
          "description": "Up to 1,500 words of context for the model."
        },
        "punctuate": {
          "in": "body",
          "type": "boolean",
          "description": "Automatic punctuation."
        },
        "format_text": {
          "in": "body",
          "type": "boolean",
          "description": "Text formatting."
        },
        "disfluencies": {
          "in": "body",
          "type": "boolean",
          "description": "Keep filler words such as umm."
        },
        "filter_profanity": {
          "in": "body",
          "type": "boolean",
          "description": "Filter profanity from the text."
        },
        "redact_pii": {
          "in": "body",
          "type": "boolean",
          "description": "Redact PII from the text; needs format_text true."
        },
        "redact_pii_policies": {
          "in": "body",
          "type": "array",
          "description": "PII redaction policies to apply."
        },
        "entity_detection": {
          "in": "body",
          "type": "boolean",
          "description": "Detect named entities."
        },
        "sentiment_analysis": {
          "in": "body",
          "type": "boolean",
          "description": "Sentiment per sentence; needs punctuate true."
        },
        "auto_highlights": {
          "in": "body",
          "type": "boolean",
          "description": "Extract key phrases."
        },
        "iab_categories": {
          "in": "body",
          "type": "boolean",
          "description": "Topic detection."
        },
        "content_safety": {
          "in": "body",
          "type": "boolean",
          "description": "Content moderation."
        },
        "audio_start_from": {
          "in": "body",
          "type": "integer",
          "description": "Start transcribing at this offset, in milliseconds."
        },
        "audio_end_at": {
          "in": "body",
          "type": "integer",
          "description": "Stop transcribing at this offset, in milliseconds."
        },
        "webhook_url": {
          "in": "body",
          "type": "string",
          "description": "URL AssemblyAI calls when the transcript completes or fails."
        }
      },
      "notes": [
        "A read over POST that starts a billed job; poll assemblyai.transcript.get with the returned id.",
        "Offsets and word timestamps are in milliseconds."
      ],
      "job": "ai.transcribe",
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/submit",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/submit"
      }
    },
    {
      "id": "assemblyai.transcript.get",
      "name": "Get a transcript",
      "summary": "Status, and once completed the text, words with timestamps and any requested feature results.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        }
      },
      "notes": [
        "status is queued, processing, completed or error; at most 60 polls per minute per transcript."
      ],
      "job": "jobs.status",
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get"
      }
    },
    {
      "id": "assemblyai.transcript.list",
      "name": "List transcripts",
      "summary": "Transcripts from the last 30 days, newest first.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript",
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Transcripts per page, 1 to 200, default 10."
        },
        "status": {
          "in": "query",
          "type": "string",
          "description": "Filter by status.",
          "enum": [
            "queued",
            "processing",
            "completed",
            "error"
          ]
        },
        "created_on": {
          "in": "query",
          "type": "string",
          "description": "Only transcripts created on this date (YYYY-MM-DD)."
        },
        "before_id": {
          "in": "query",
          "type": "string",
          "description": "Only transcripts created before this transcript id."
        },
        "after_id": {
          "in": "query",
          "type": "string",
          "description": "Only transcripts created after this transcript id."
        }
      },
      "notes": [
        "Page with page_details.prev_url (older) and next_url (newer)."
      ],
      "job": "jobs.list",
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/list",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/list"
      }
    },
    {
      "id": "assemblyai.transcript.sentences",
      "name": "Get transcript sentences",
      "summary": "A completed transcript split into sentences with timestamps.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}/sentences",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        }
      },
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-sentences",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-sentences"
      }
    },
    {
      "id": "assemblyai.transcript.paragraphs",
      "name": "Get transcript paragraphs",
      "summary": "A completed transcript split into paragraphs with timestamps.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}/paragraphs",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        }
      },
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-paragraphs",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-paragraphs"
      }
    },
    {
      "id": "assemblyai.transcript.subtitles",
      "name": "Get subtitles",
      "summary": "A completed transcript as SRT or VTT captions.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}/{subtitle_format}",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        },
        "subtitle_format": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "srt or vtt.",
          "enum": [
            "srt",
            "vtt"
          ]
        },
        "chars_per_caption": {
          "in": "query",
          "type": "integer",
          "description": "Most characters per caption."
        }
      },
      "notes": [
        "Answers plain text, not JSON."
      ],
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-subtitles",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/get-subtitles"
      }
    },
    {
      "id": "assemblyai.transcript.word_search",
      "name": "Search words in a transcript",
      "summary": "Where given words occur in a completed transcript, with counts and timestamps.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}/word-search",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        },
        "words": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Keywords to search for, comma-separated (one parameter, not repeated).",
          "example": "smoke,fire"
        }
      },
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/word-search",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/word-search"
      }
    },
    {
      "id": "assemblyai.transcript.delete",
      "name": "Delete a transcript",
      "summary": "Remove a transcript's text and data from AssemblyAI.",
      "kind": "write",
      "method": "DELETE",
      "path": "/v2/transcript/{transcript_id}",
      "params": {
        "transcript_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Transcript id."
        }
      },
      "job": "jobs.delete",
      "docs_url": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/delete",
      "verified": {
        "docs": "https://www.assemblyai.com/docs/pre-recorded-audio/api-reference/transcripts/delete"
      }
    }
  ]
}
