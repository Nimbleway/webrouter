{
  "vendor": "signalbase",
  "name": "Signalbase",
  "category": "company-data",
  "summary": "Funding, acquisition, hiring and job-change signals, investors, companies and people.",
  "docs_url": "https://docs.trysignalbase.com",
  "pricing_url": "https://www.trysignalbase.com/pricing",
  "base_url": "https://www.trysignalbase.com/api/v2",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "SIGNALBASE_API_KEY"
        ],
        "description": "A Signalbase API key (ff_live_..., from trysignalbase.com/workspace/api). Sent as a Bearer token."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Responses report creditsUsed and creditsRemaining; count=true on any search returns only the total and is free.",
    "Paging is page + limit (max 100 per page).",
    "List filters are comma-separated strings, except categories, which is pipe-separated.",
    "company_domain and company_linkedin_url are strict: no match gives an empty result, never a fuzzy one. Prefer them over company_name.",
    "No email addresses or phone numbers are returned; job-change person names are GDPR-masked (first name and last initial).",
    "Webhooks, monitors and CSV enrichment are not in this entry."
  ],
  "sources": [
    "https://docs.trysignalbase.com",
    "https://docs.trysignalbase.com/index.md",
    "https://docs.trysignalbase.com/api-reference/openapi.json"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "signalbase.funding.search",
      "name": "Search funding rounds",
      "summary": "Companies that raised, with round type, amount and investors.",
      "kind": "read",
      "method": "GET",
      "path": "/signals/funding",
      "params": {
        "page": {
          "in": "query",
          "type": "integer",
          "description": "Page number, default 1."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Results per page, default 20, max 100."
        },
        "dateFrom": {
          "in": "query",
          "type": "string",
          "description": "From this date, YYYY-MM-DD.",
          "example": "2026-10-01"
        },
        "dateTo": {
          "in": "query",
          "type": "string",
          "description": "Up to this date, YYYY-MM-DD."
        },
        "date_preset": {
          "in": "query",
          "type": "string",
          "description": "Relative date range; wins over dateFrom/dateTo.",
          "enum": [
            "today",
            "yesterday",
            "last_7d",
            "last_14d",
            "last_30d",
            "last_60d",
            "last_90d",
            "last_6m",
            "last_1y",
            "last_2y",
            "this_week",
            "this_month",
            "this_quarter",
            "this_year",
            "last_week",
            "last_month",
            "last_quarter",
            "last_year"
          ]
        },
        "company_domain": {
          "in": "query",
          "type": "string",
          "description": "Company website domain, strict match (no fuzzy fallback).",
          "example": "novartis.com"
        },
        "company_linkedin_url": {
          "in": "query",
          "type": "string",
          "description": "LinkedIn company URL, strict match."
        },
        "company_name": {
          "in": "query",
          "type": "string",
          "description": "Company name, partial match."
        },
        "countries": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated country codes."
        },
        "exclude_countries": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated country names or codes to exclude."
        },
        "categories": {
          "in": "query",
          "type": "string",
          "description": "Pipe-separated company categories."
        },
        "round": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated round types, e.g. Series A (case-insensitive exact; an unknown value is a 400)."
        },
        "search": {
          "in": "query",
          "type": "string",
          "description": "Company name or industry keywords."
        },
        "investor_name": {
          "in": "query",
          "type": "string",
          "description": "Investor name, partial match."
        },
        "amount_min": {
          "in": "query",
          "type": "integer",
          "description": "Minimum amount, whole units of the deal currency (not cents)."
        },
        "amount_max": {
          "in": "query",
          "type": "integer",
          "description": "Maximum amount, whole units of the deal currency."
        },
        "currency": {
          "in": "query",
          "type": "string",
          "description": "ISO 4217 currency of the deal; most are USD.",
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "CHF",
            "JPY",
            "INR",
            "CAD",
            "AUD",
            "SEK",
            "CNY",
            "NZD",
            "KRW",
            "SGD",
            "DKK",
            "BRL"
          ]
        },
        "employee_count_min": {
          "in": "query",
          "type": "integer",
          "description": "Minimum employee count."
        },
        "employee_count_max": {
          "in": "query",
          "type": "integer",
          "description": "Maximum employee count."
        },
        "sort_by": {
          "in": "query",
          "type": "string",
          "description": "Sort field, default occurred_at.",
          "enum": [
            "occurred_at",
            "discovered_at",
            "amount",
            "employee_count",
            "founded_year"
          ]
        },
        "sort_order": {
          "in": "query",
          "type": "string",
          "description": "Default desc.",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "count": {
          "in": "query",
          "type": "string",
          "description": "\"true\" returns only totalCount with no rows, and charges no credits.",
          "enum": [
            "true"
          ]
        }
      },
      "job": "company.funding",
      "docs_url": "https://docs.trysignalbase.com/api-reference/funding-signals/endpoint/get",
      "verified": {
        "docs": "https://docs.trysignalbase.com/api-reference/funding-signals/endpoint/get"
      }
    },
