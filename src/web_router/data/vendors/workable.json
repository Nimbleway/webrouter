{
  "vendor": "workable",
  "name": "Workable",
  "category": "company-data",
  "summary": "Published jobs, locations and departments from a company's public Workable careers page.",
  "docs_url": "https://help.workable.com/hc/en-us/articles/115012771647",
  "base_url": "https://www.workable.com/api",
  "notes": [
    "Keyless. subdomain is the company's Workable account subdomain (the <subdomain> in <subdomain>.workable.com or apply.workable.com/<subdomain>).",
    "Only published jobs, one company per call; there is no search across companies.",
    "Workable's authenticated SPI v3 (account-owned jobs, candidates) lives on a per-account host and is not in this entry."
  ],
  "sources": [
    "https://help.workable.com/hc/en-us/articles/115012771647"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "workable.jobs.list",
      "name": "List a company's published jobs",
      "summary": "Every published job on the account's careers page.",
      "kind": "read",
      "method": "GET",
      "path": "/accounts/{subdomain}",
      "params": {
        "subdomain": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Account subdomain."
        },
        "details": {
          "in": "query",
          "type": "boolean",
          "description": "true adds each job's description."
        }
      },
      "job": "jobs.search",
      "docs_url": "https://help.workable.com/hc/en-us/articles/115012771647",
      "verified": {
        "docs": "https://help.workable.com/hc/en-us/articles/115012771647"
      }
    },
    {
      "id": "workable.locations.list",
      "name": "List locations of published jobs",
      "summary": "Locations the account's published jobs are in.",
      "kind": "read",
      "method": "GET",
      "path": "/accounts/{subdomain}/locations",
      "params": {
        "subdomain": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Account subdomain."
        }
      },
      "job": "jobs.locations",
      "docs_url": "https://help.workable.com/hc/en-us/articles/115012771647",
      "verified": {
        "docs": "https://help.workable.com/hc/en-us/articles/115012771647"
      }
    },
    {
      "id": "workable.departments.list",
      "name": "List departments of published jobs",
      "summary": "Departments the account's published jobs belong to.",
      "kind": "read",
      "method": "GET",
      "path": "/accounts/{subdomain}/departments",
      "params": {
        "subdomain": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Account subdomain."
        }
      },
      "job": "jobs.departments",
      "docs_url": "https://help.workable.com/hc/en-us/articles/115012771647",
      "verified": {
        "docs": "https://help.workable.com/hc/en-us/articles/115012771647"
      }
    }
  ]
}
