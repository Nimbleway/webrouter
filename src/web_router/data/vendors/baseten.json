{
  "vendor": "baseten",
  "name": "Baseten",
  "category": "ai",
  "data": "service",
  "summary": "Inference for open-source LLMs through Baseten Model APIs (OpenAI-compatible chat), plus your Baseten models and token usage.",
  "docs_url": "https://docs.baseten.co/reference/inference-api/overview",
  "pricing_url": "https://www.baseten.co/pricing/",
  "base_url": "https://api.baseten.co",
  "hosts": {
    "inference": "https://inference.baseten.co"
  },
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "BASETEN_API_KEY"
        ],
        "description": "A Baseten API key (app.baseten.co > Settings > API keys)."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Two hosts: chat runs on inference.baseten.co; the management API (models, Model API catalog, usage) on api.baseten.co. The same key works on both.",
    "Model APIs are billed per input and output token at each model's price.",
    "Calling a model you deployed yourself goes to a per-model host (model-<id>.api.baseten.co), which this entry does not cover."
  ],
  "sources": [
    "https://docs.baseten.co/reference/inference-api/overview",
    "https://docs.baseten.co/reference/inference-api/chat-completions",
    "https://docs.baseten.co/reference/inference-api/llm-openapi-spec.json",
    "https://docs.baseten.co/reference/management-api/model-apis/gets-all-model-apis",
    "https://docs.baseten.co/reference/management-api/model-apis/gets-model-apis-token-usage",
    "https://docs.baseten.co/reference/management-api/models/gets-all-models",
    "https://docs.baseten.co/reference/management-api/models/gets-a-model-by-id"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "baseten.chat.complete",
      "name": "Create a chat completion",
      "summary": "Send a conversation to a Model API LLM and get the reply (OpenAI-compatible).",
      "kind": "read",
      "method": "POST",
      "path": "/v1/chat/completions",
      "params": {
        "model": {
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Model slug, e.g. deepseek-ai/DeepSeek-V4.1-Flash-1017; list them with baseten.model_apis.list.",
          "example": "deepseek-ai/DeepSeek-V4.1-Flash-1017"
        },
        "messages": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "Conversation as {role, content} messages; roles system, user, assistant, tool.",
          "example": [
            {
              "role": "user",
              "content": "Hello!"
            }
          ]
        },
        "max_tokens": {
          "in": "body",
          "type": "integer",
          "description": "Most tokens to generate; truncated if input plus max_tokens exceeds the context length."
        },
        "temperature": {
          "in": "body",
          "type": "number",
          "description": "Sampling randomness."
        },
        "top_p": {
          "in": "body",
          "type": "number",
          "description": "Nucleus sampling."
        },
        "top_k": {
          "in": "body",
          "type": "integer",
          "description": "Sample from the top K tokens; -1 disables."
        },
        "seed": {
          "in": "body",
          "type": "integer",
          "description": "Seed; determinism not guaranteed across hardware or versions."
        },
        "stop": {
          "in": "body",
          "type": "array",
          "description": "Up to 32 stop sequences."
        },
        "frequency_penalty": {
          "in": "body",
          "type": "number",
          "description": "Penalize frequent tokens; support varies by model."
        },
        "presence_penalty": {
          "in": "body",
          "type": "number",
          "description": "Penalize tokens already present; support varies by model."
        },
        "response_format": {
          "in": "body",
          "type": "object",
          "description": "{\"type\": \"json_object\"} or {\"type\": \"json_schema\", \"json_schema\": {...}}."
        },
        "tools": {
          "in": "body",
          "type": "array",
          "description": "Function tools the model may call."
        },
        "tool_choice": {
          "in": "body",
          "type": "string",
          "description": "none, auto or required."
        },
        "reasoning_effort": {
          "in": "body",
          "type": "string",
          "description": "Reasoning effort for reasoning-capable models, e.g. low, medium, high."
        }
      },
      "notes": [
        "A read over POST, billed per token.",
        "Do not set stream: true; this client returns one JSON body.",
        "n and best_of only accept 1."
      ],
      "job": "ai.chat",
      "host": "inference",
      "docs_url": "https://docs.baseten.co/reference/inference-api/chat-completions",
      "verified": {
        "docs": "https://docs.baseten.co/reference/inference-api/chat-completions"
      }
    },
    {
      "id": "baseten.model_apis.list",
      "name": "List Model APIs",
      "summary": "The managed LLMs you can call through Model APIs, with their slugs.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/model_apis",
      "params": {
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Items per page, 1 to 1000, default 100."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Cursor from the previous page."
        },
        "added_only": {
          "in": "query",
          "type": "boolean",
          "description": "Only Model APIs added by your teams."
        }
      },
      "job": "ai.models",
      "docs_url": "https://docs.baseten.co/reference/management-api/model-apis/gets-all-model-apis",
      "verified": {
        "docs": "https://docs.baseten.co/reference/management-api/model-apis/gets-all-model-apis"
      }
    },
    {
      "id": "baseten.model_apis.usage",
      "name": "Get Model APIs token usage",
      "summary": "Your organization's Model APIs token usage in contiguous time buckets.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/model_apis/usage",
      "params": {
        "start_time": {
          "in": "query",
          "type": "string",
          "description": "Range start, ISO 8601 UTC, inclusive; required on the first page.",
          "example": "2026-11-01T00:00:00Z"
        },
        "end_time": {
          "in": "query",
          "type": "string",
          "description": "Range end, ISO 8601 UTC, exclusive; default now."
        },
        "bucket_width": {
          "in": "query",
          "type": "string",
          "description": "Bucket width, default 1d.",
          "enum": [
            "1m",
            "1h",
            "1d"
          ]
        },
        "group_by": {
          "in": "query",
          "type": "array",
          "description": "Dimensions to break usage down by: api_key, user, model, team. Default model."
        },
        "models": {
          "in": "query",
          "type": "array",
          "description": "Only usage for these models."
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Buckets to return: 1d default 7 max 31; 1h default 24 max 168; 1m default 60 max 1440."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "pagination.cursor from the previous response."
        }
      },
      "notes": [
        "Usage is kept 92 days. Empty buckets are included. Non-admins may see lower totals."
      ],
      "job": "account.usage",
      "docs_url": "https://docs.baseten.co/reference/management-api/model-apis/gets-model-apis-token-usage",
      "verified": {
        "docs": "https://docs.baseten.co/reference/management-api/model-apis/gets-model-apis-token-usage"
      }
    },
    {
      "id": "baseten.models.list",
      "name": "List models",
      "summary": "The models deployed in your Baseten organization.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/models",
      "params": {
        "name": {
          "in": "query",
          "type": "string",
          "description": "Only models with exactly this name."
        }
      },
      "docs_url": "https://docs.baseten.co/reference/management-api/models/gets-all-models",
      "verified": {
        "docs": "https://docs.baseten.co/reference/management-api/models/gets-all-models"
      }
    },
    {
      "id": "baseten.models.get",
      "name": "Get a model",
      "summary": "One deployed model by id.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/models/{model_id}",
      "params": {
        "model_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Model id."
        }
      },
      "docs_url": "https://docs.baseten.co/reference/management-api/models/gets-a-model-by-id",
      "verified": {
        "docs": "https://docs.baseten.co/reference/management-api/models/gets-a-model-by-id"
      }
    }
  ]
}
