{
  "vendor": "companyenrich",
  "name": "CompanyEnrich",
  "category": "company-data",
  "summary": "Company and people search, enrichment, workforce insights, lookalikes and work-email lookup from CompanyEnrich.",
  "docs_url": "https://docs.companyenrich.com",
  "pricing_url": "https://companyenrich.com/pricing",
  "base_url": "https://api.companyenrich.com",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "COMPANYENRICH_API_KEY"
        ],
        "description": "a CompanyEnrich API token from the dashboard (https://companyenrich.com)"
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "Credit-based; every response carries x-credit-balance, x-credit-cost and x-credit-remaining headers. account.me shows the balance.",
    "Search endpoints page with an opaque cursor returned in the response; pass it back with the same filters. Count and preview endpoints are free.",
    "Search and enrichment return a company or person ID usable with the get-by-ID endpoints."
  ],
  "sources": [
    "https://docs.companyenrich.com/llms.txt",
    "https://docs.companyenrich.com/docs/credits.md",
    "https://docs.companyenrich.com/docs/rate-limit.md",
    "https://docs.companyenrich.com/reference/post_v2-companies-search.md",
    "https://docs.companyenrich.com/reference/post_v2-people-search.md",
    "https://docs.companyenrich.com/reference/post_v2-companies-enrich.md"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "companyenrich.company.get",
      "name": "Get a company by ID",
      "summary": "1 credit plus paid expansions.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/companies/{companyId}",
      "params": {
        "companyId": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "CompanyEnrich company ID."
        },
        "expand": {
          "in": "query",
          "type": "array",
          "description": "Paid expansions: financial, keywords, naicsCodes, technologies (1 credit each per company) or workforce (5 credits)."
        }
      },
      "job": "company.enrich",
      "docs_url": "https://docs.companyenrich.com/reference/get_v2-companies-companyid.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/get_v2-companies-companyid.md"
      }
    },
    {
      "id": "companyenrich.company.enrich",
      "name": "Enrich a company by domain",
      "summary": "1 credit per successful enrichment plus paid expansions.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/companies/enrich",
      "params": {
        "domain": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Company domain."
        },
        "expand": {
          "in": "query",
          "type": "array",
          "description": "Paid expansions: financial, keywords, naicsCodes, technologies (1 credit each per company) or workforce (5 credits)."
        },
        "waitForEnrichment": {
          "in": "query",
          "type": "boolean",
          "description": "Wait for on-demand enrichment of companies not stored yet (default true)."
        }
      },
      "job": "company.enrich",
      "docs_url": "https://docs.companyenrich.com/reference/get_v2-companies-enrich.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/get_v2-companies-enrich.md"
      }
    },
    {
      "id": "companyenrich.company.enrich_by_properties",
      "name": "Enrich a company by name or profile URL",
      "kind": "read",
      "method": "POST",
      "path": "/v2/companies/enrich",
      "params": {
        "name": {
          "in": "body",
          "type": "string",
          "description": "Company name."
        },
        "linkedinUrl": {
          "in": "body",
          "type": "string",
          "description": "Company LinkedIn URL."
        },
        "linkedinId": {
          "in": "body",
          "type": "string",
          "description": "Company LinkedIn ID."
        },
        "twitterUrl": {
          "in": "body",
          "type": "string",
          "description": "Company Twitter/X URL."
        },
        "facebookUrl": {
          "in": "body",
          "type": "string",
          "description": "Company Facebook URL."
        },
        "instagramUrl": {
          "in": "body",
          "type": "string",
          "description": "Company Instagram URL."
        },
        "youtubeUrl": {
          "in": "body",
          "type": "string",
          "description": "Company YouTube URL."
        },
        "expand": {
          "in": "body",
          "type": "array",
          "description": "Paid expansions: financial, keywords, naicsCodes, technologies (1 credit each per company) or workforce (5 credits)."
        }
      },
      "notes": [
        "A read over POST: it only queries or looks up data."
      ],
      "job": "company.enrich",
      "docs_url": "https://docs.companyenrich.com/reference/post_v2-companies-enrich.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/post_v2-companies-enrich.md"
      }
    },
    {
      "id": "companyenrich.company.enrich_batch",
      "name": "Enrich up to 50 companies by domain",
      "summary": "1 credit per unique company returned plus paid expansions.",
      "kind": "read",
      "method": "POST",
      "path": "/v2/companies/enrich/batch",
      "params": {
        "domains": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "1 to 50 domains; duplicates enriched once."
        },
        "expand": {
          "in": "body",
          "type": "array",
          "description": "Paid expansions: financial, keywords, naicsCodes, technologies (1 credit each per company) or workforce (5 credits)."
        },
        "waitForEnrichment": {
          "in": "body",
          "type": "boolean",
          "description": "Wait for on-demand enrichment; when false, unstored companies come back pending."
        }
      },
      "notes": [
        "A read over POST: it only queries or looks up data."
      ],
      "job": "company.enrich",
      "docs_url": "https://docs.companyenrich.com/reference/post_v2-companies-enrich-batch.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/post_v2-companies-enrich-batch.md"
      }
    },
    {
      "id": "companyenrich.company.autocomplete",
      "name": "Autocomplete companies by domain",
      "summary": "Up to 10 companies; free.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/companies/autocomplete",
      "params": {
        "query": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Domain prefix or URL, max 100 characters."
        }
      },
      "job": "company.search",
      "docs_url": "https://docs.companyenrich.com/reference/get_v2-companies-autocomplete.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/get_v2-companies-autocomplete.md"
      }
    },
    {
      "id": "companyenrich.company.workforce",
      "name": "Get company workforce insights",
      "summary": "Employee count, range, department headcounts and 12 months of history.",
      "kind": "read",
      "method": "GET",
      "path": "/v2/companies/workforce",
      "params": {
        "id": {
          "in": "query",
          "type": "string",
          "description": "CompanyEnrich company ID. Give exactly one of id or domain."
        },
        "domain": {
          "in": "query",
          "type": "string",
          "description": "Company domain. Give exactly one of id or domain."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "nextCursor from a previous response, for earlier history; omit for the latest 12 months."
        }
      },
      "notes": [
        "5 credits per page, including each earlier year of history."
      ],
      "job": "company.employees",
      "docs_url": "https://docs.companyenrich.com/reference/get_v2-companies-workforce.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/get_v2-companies-workforce.md"
      }
    },
    {
      "id": "companyenrich.company.search",
      "name": "Search companies",
      "summary": "Filters, a natural-language query or lookalike seeds.",
      "kind": "read",
      "method": "POST",
      "path": "/v2/companies/search",
      "params": {
        "pageSize": {
          "in": "body",
          "type": "integer",
          "description": "Maximum items to return."
        },
        "cursor": {
          "in": "body",
          "type": "string",
          "description": "Opaque cursor from the previous response; omit for the first page."
        },
        "expand": {
          "in": "body",
          "type": "array",
          "description": "Paid expansions: financial, keywords, naicsCodes, technologies (1 credit each per company) or workforce (5 credits)."
        },
        "filter": {
          "in": "body",
          "type": "object",
          "description": "Company filters: query, domain, keywords, technologies, region, country, state, city, type, employees, revenue, workforceGrowth, naicsCodes, categories, foundedYear, fundingRounds and more.",
          "example": {
            "country": [
              "US"
            ],
            "technologies": [
              "Salesforce"
            ]
          }
        },
        "semantic": {
          "in": "body",
          "type": "object",
          "description": "{query, weight, autoFilter}: a natural-language description of the companies.",
          "example": {
            "query": "Solar startups that raised a Series B"
          }
        },
        "lookalike": {
          "in": "body",
          "type": "object",
          "description": "{domains, weight, minScore}: seed company domains to find lookalikes of.",
          "example": {
            "domains": [
              "stripe.com"
            ]
          }
        }
      },
      "notes": [
        "A read over POST: it only queries or looks up data.",
        "Credits per returned company: standard 1, semantic 2, lookalike 5, plus expansions."
      ],
      "job": "company.search",
      "docs_url": "https://docs.companyenrich.com/reference/post_v2-companies-search.md",
      "verified": {
        "docs": "https://docs.companyenrich.com/reference/post_v2-companies-search.md"
      }
    },
