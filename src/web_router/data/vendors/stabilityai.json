{
  "vendor": "stabilityai",
  "name": "Stability AI",
  "category": "media-generation",
  "data": "service",
  "summary": "Stable Diffusion image generation, async generation results, engines and credit balance.",
  "docs_url": "https://docs.stability.ai/api-reference",
  "pricing_url": "https://docs.stability.ai/pricing",
  "base_url": "https://api.stability.ai",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "STABILITY_API_KEY"
        ],
        "description": "A Stability AI API key (platform.stability.ai/dashboard/api-keys). Sent as a Bearer token."
      }
    },
    "inject": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {api_key}"
      }
    ]
  },
  "notes": [
    "The current /v2beta generation and editing endpoints (Stable Image Ultra, Core, SD3.5, edit, upscale, control, Stable Audio, 3D) accept only multipart/form-data, which this catalog cannot send, so they are not listed; only the v1 JSON SDXL endpoint generates here. Their async results can still be fetched with the results endpoints below.",
    "1 credit = $0.01; 25 free credits at signup. A 402 means not enough credits.",
    "Rate limit: 150 requests per 10 seconds; exceeding it returns 429 and blocks requests for 60 seconds.",
    "Async results are kept 24 hours and must be fetched with the same key that started the generation (otherwise 404)."
  ],
  "sources": [
    "https://docs.stability.ai/llms.txt",
    "https://platform.stability.ai/llms.txt",
    "https://docs.stability.ai/api-reference/index.md",
    "https://docs.stability.ai/api-reference/sdxl-10/text-to-image.md",
    "https://docs.stability.ai/api-reference/results/fetch-async-generation-result.md",
    "https://docs.stability.ai/api-reference/audio-results/fetch-audio-result.md",
    "https://docs.stability.ai/api-reference/engines/list-engines.md",
    "https://docs.stability.ai/api-reference/user/account-balance.md",
    "https://docs.stability.ai/api-reference/user/account-details.md"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "stabilityai.image.generate",
      "name": "Generate an image with SDXL 1.0",
      "summary": "Text-to-image on the v1 API; returns base64 images in JSON (or a PNG).",
      "kind": "read",
      "method": "POST",
      "path": "/v1/generation/{engine_id}/text-to-image",
      "params": {
        "engine_id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Engine id; stable-diffusion-xl-1024-v1-0 for SDXL 1.0.",
          "example": "stable-diffusion-xl-1024-v1-0"
        },
        "text_prompts": {
          "in": "body",
          "type": "array",
          "required": true,
          "description": "[{text, weight}]; text up to 2000 characters, negative weight for a negative prompt.",
          "example": [
            {
              "text": "A lighthouse on a cliff",
              "weight": 1
            }
          ]
        },
        "height": {
          "in": "body",
          "type": "integer",
          "description": "Pixels, multiple of 64. SDXL takes 1024x1024 (default), 1152x896, 896x1152, 1216x832, 1344x768, 768x1344, 1536x640 or 640x1536."
        },
        "width": {
          "in": "body",
          "type": "integer",
          "description": "Pixels, multiple of 64; see height for SDXL combinations."
        },
        "cfg_scale": {
          "in": "body",
          "type": "number",
          "description": "Prompt adherence, 0 to 35; default 7."
        },
        "sampler": {
          "in": "body",
          "type": "string",
          "description": "Diffusion sampler; chosen automatically when omitted.",
          "enum": [
            "DDIM",
            "DDPM",
            "K_DPMPP_2M",
            "K_DPMPP_2S_ANCESTRAL",
            "K_DPM_2",
            "K_DPM_2_ANCESTRAL",
            "K_EULER",
            "K_EULER_ANCESTRAL",
            "K_HEUN",
            "K_LMS"
          ]
        },
        "samples": {
          "in": "body",
          "type": "integer",
          "description": "Images to generate, 1 to 10; default 1."
        },
        "seed": {
          "in": "body",
          "type": "integer",
          "description": "Random seed; 0 for random."
        },
        "steps": {
          "in": "body",
          "type": "integer",
          "description": "Diffusion steps, 10 to 50; default 30. More than 30 costs more."
        },
        "style_preset": {
          "in": "body",
          "type": "string",
          "description": "Style preset name."
        },
        "accept": {
          "in": "header",
          "type": "string",
          "wire_name": "Accept",
          "description": "application/json (default, base64 images) or image/png.",
          "enum": [
            "application/json",
            "image/png"
          ]
        }
      },
      "notes": [
        "A read over POST that spends credits: 0.9 credit per image at 30 steps or fewer, else 0.9 * steps / 30. Check each artifact's finishReason (CONTENT_FILTERED means blurred)."
      ],
      "job": "ai.image.generate",
      "docs_url": "https://docs.stability.ai/api-reference/sdxl-10/text-to-image",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/sdxl-10/text-to-image.md"
      }
    },
    {
      "id": "stabilityai.results.get",
      "name": "Fetch an async image or 3D result",
      "summary": "The result of an async v2beta image or 3D generation; 202 while still running.",
      "kind": "read",
      "method": "GET",
      "path": "/v2beta/results/{id}",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Generation id returned when the job was started."
        },
        "accept": {
          "in": "header",
          "type": "string",
          "wire_name": "Accept",
          "description": "application/json for base64 in JSON, or image/* for raw bytes.",
          "example": "application/json"
        }
      },
      "notes": [
        "202 means in progress; 200 returns the result. Results are deleted after 24 hours."
      ],
      "job": "jobs.result",
      "docs_url": "https://docs.stability.ai/api-reference/results/fetch-async-generation-result",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/results/fetch-async-generation-result.md"
      }
    },
    {
      "id": "stabilityai.audio_results.get",
      "name": "Fetch an async Stable Audio result",
      "summary": "The result of a Stable Audio 3.0 generation; 202 while still running.",
      "kind": "read",
      "method": "GET",
      "path": "/v2beta/audio/results/{id}",
      "params": {
        "id": {
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Generation id returned when the job was started."
        },
        "accept": {
          "in": "header",
          "type": "string",
          "wire_name": "Accept",
          "description": "application/json for base64 in JSON, or audio/* for raw bytes.",
          "example": "application/json"
        }
      },
      "job": "jobs.result",
      "docs_url": "https://docs.stability.ai/api-reference/audio-results/fetch-audio-result",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/audio-results/fetch-audio-result.md"
      }
    },
    {
      "id": "stabilityai.engines.list",
      "name": "List engines",
      "summary": "v1 engines available to the account.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/engines/list",
      "job": "ai.models",
      "docs_url": "https://docs.stability.ai/api-reference/engines/list-engines",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/engines/list-engines.md"
      }
    },
    {
      "id": "stabilityai.account.balance",
      "name": "Get credit balance",
      "summary": "Credits left on the account or organization behind the key.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/user/balance",
      "job": "account.usage",
      "docs_url": "https://docs.stability.ai/api-reference/user/account-balance",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/user/account-balance.md"
      }
    },
    {
      "id": "stabilityai.account.get",
      "name": "Get account details",
      "summary": "The account and organizations associated with the key.",
      "kind": "read",
      "method": "GET",
      "path": "/v1/user/account",
      "job": "account.validate",
      "docs_url": "https://docs.stability.ai/api-reference/user/account-details",
      "verified": {
        "docs": "https://docs.stability.ai/api-reference/user/account-details.md"
      }
    }
  ]
}
