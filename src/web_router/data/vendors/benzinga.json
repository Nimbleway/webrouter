          "wire_name": "parameters[updated]"
        },
        "date_sort": {
          "in": "query",
          "type": "string",
          "description": "Which date the date filters apply to.",
          "wire_name": "parameters[date_sort]",
          "enum": [
            "announced",
            "ex",
            "payable",
            "record"
          ]
        },
        "dividend_yield_operation": {
          "in": "query",
          "type": "string",
          "description": "Comparison for dividend_yield.",
          "wire_name": "parameters[dividend_yield_operation]",
          "enum": [
            "gt",
            "gte",
            "eq",
            "lte",
            "lt"
          ]
        },
        "dividend_yield": {
          "in": "query",
          "type": "number",
          "description": "Dividend yield to compare against.",
          "wire_name": "parameters[dividend_yield]"
        }
      },
      "job": "events.list",
      "docs_url": "https://docs.benzinga.com/api-reference/calendar-api/get-dividends.md",
      "verified": {
        "docs": "https://docs.benzinga.com/api-reference/calendar-api/get-dividends.md"
