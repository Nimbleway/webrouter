        "start": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "YYYYMMDD."
        },
        "end": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "YYYYMMDD."
        },
        "format": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Response format.",
          "enum": [
            "JSON",
            "CSV",
            "ASCII",
            "NETCDF"
          ]
        },
        "time-standard": {
          "in": "query",
          "type": "string",
          "description": "UTC or LST (the default).",
          "enum": [
            "UTC",
            "LST"
          ]
        }
      },
      "job": "weather.history",
      "docs_url": "https://power.larc.nasa.gov/docs/services/api/temporal/daily/",
      "verified": {
        "docs": "https://power.larc.nasa.gov/docs/services/api/temporal/daily/"
      }
    },
