{
  "vendor": "fdic",
  "name": "FDIC BankFind Suite",
  "category": "finance",
  "summary": "FDIC data on every US insured bank: institutions, branches, quarterly Call Report financials, failures since 1934, structure changes, deposits by branch and yearly industry totals.",
  "docs_url": "https://api.fdic.gov/banks/docs",
  "base_url": "https://api.fdic.gov/banks",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "FDIC_API_KEY"
        ],
        "required": false,
        "description": "An optional api.fdic.gov key; the FDIC recommends one but does not currently require it."
      }
    },
    "inject": [
      {
        "in": "query",
        "name": "api_key",
        "value": "{api_key}",
        "optional": true
      }
    ]
  },
  "notes": [
    "Keyless today; a key is recommended. The API moved from banks.data.fdic.gov to api.fdic.gov/banks.",
    "Every field name and filter value is UPPERCASE. Join tables on CERT (the FDIC certificate number).",
    "Amounts such as DEP are in thousands of dollars (DEP:[50000 TO *] means over $50 million).",
    "limit defaults to 10 (100 on failures and history) and tops out at 10,000; page with offset. meta.total gives the match count."
  ],
  "sources": [
    "https://api.fdic.gov/banks/docs",
    "https://api.fdic.gov/banks/docs/swagger.yaml"
  ],
  "curated": "2026-11-09",
  "endpoints": [
    {
      "id": "fdic.institutions.search",
      "name": "Search institutions",
      "summary": "Banks and savings institutions with location, status, assets, deposits and returns.",
      "kind": "read",
      "method": "GET",
      "path": "/institutions",
      "params": {
        "filters": {
          "in": "query",
          "type": "string",
          "description": "Elasticsearch query-string filter, field names in UPPERCASE, e.g. STALP:IA AND ACTIVE:1, DEP:[50000 TO *], DATEUPDT:[\"2010-01-01\" TO \"2010-12-31\"].",
          "example": "STALP:IA AND ACTIVE:1"
        },
        "fields": {
          "in": "query",
          "type": "string",
          "description": "Comma-separated UPPERCASE fields to return."
        },
        "sort_by": {
          "in": "query",
          "type": "string",
          "description": "UPPERCASE field to sort by, default NAME."
        },
        "sort_order": {
          "in": "query",
          "type": "string",
          "description": "ASC (default) or DESC.",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Records to return, max 10,000."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Records to skip."
        },
        "search": {
          "in": "query",
          "type": "string",
          "description": "Fuzzy name search, e.g. NAME: Island."
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "json or csv.",
          "enum": [
            "json",
            "csv"
          ]
        }
      },
      "job": "company.search",
      "docs_url": "https://api.fdic.gov/banks/docs/swagger.yaml",
      "verified": {
        "docs": "https://api.fdic.gov/banks/docs/swagger.yaml"
      }
    },
