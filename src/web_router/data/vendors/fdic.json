        "sort_by": {
          "in": "query",
          "type": "string",
          "description": "UPPERCASE field to sort by, default REPDTE."
        },
        "sort_order": {
          "in": "query",
          "type": "string",
          "description": "ASC (default) or DESC.",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "description": "Records to return, max 10,000, or 500 when more than 250 fields are requested."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Records to skip."
        },
        "agg_by": {
          "in": "query",
          "type": "string",
          "description": "UPPERCASE field to aggregate by."
        },
        "agg_term_fields": {
          "in": "query",
          "type": "string",
          "description": "UPPERCASE field(s) whose unique terms are counted per aggregation."
        },
        "agg_limit": {
          "in": "query",
          "type": "integer",
          "description": "Most aggregated results to show."
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "json or csv.",
          "enum": [
            "json",
            "csv"
          ]
        },
        "agg_sum_fields": {
          "in": "query",
          "type": "string",
          "description": "UPPERCASE field(s) summed per aggregation."
        }
      },
      "job": "company.financials",
