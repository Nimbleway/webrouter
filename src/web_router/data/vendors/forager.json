        "Charged per call at the plan's organization-search rate."
      ],
      "job": "company.search",
      "docs_url": "https://docs.forager.ai/openapi/organizations/datastorage_organization_search_create.md",
      "verified": {
        "docs": "https://docs.forager.ai/openapi/organizations/datastorage_organization_search_create.md"
      }
    },
