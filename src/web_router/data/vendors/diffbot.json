{
  "vendor": "diffbot",
  "name": "Diffbot",
  "category": "company-data",
  "data": "public",
  "summary": "Diffbot Knowledge Graph: search organizations, people and articles with DQL, and enhance records from partial data.",
  "docs_url": "https://www.diffbot.com/docs/",
  "pricing_url": "https://www.diffbot.com/pricing/",
  "base_url": "https://kg.diffbot.com/kg/v3",
  "auth": {
    "credentials": {
      "api_key": {
        "env": [
          "DIFFBOT_TOKEN",
          "DIFFBOT_API_KEY"
        ],
        "description": "a Diffbot API token (Diffbot dashboard home > token details)"
      }
    },
    "inject": [
      {
        "in": "query",
        "name": "token",
        "value": "{api_key}"
      }
    ]
  },
  "notes": [
    "The token goes in the token query parameter on every call, including POSTs.",
    "Diffbot's other APIs (Extract, Crawl, Natural Language, Account) live on api.diffbot.com and are not in this entry.",
    "The docs moved from docs.diffbot.com to www.diffbot.com/docs."
  ],
  "sources": [
    "https://www.diffbot.com/docs/authentication",
    "https://www.diffbot.com/docs/dql/get",
    "https://www.diffbot.com/docs/dql/post",
    "https://www.diffbot.com/docs/enhance/get",
    "https://www.diffbot.com/docs/enhance/post"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "diffbot.kg.search",
      "name": "Search the Knowledge Graph with DQL",
      "summary": "Organizations, people, articles and other entities matching a DQL query.",
      "kind": "read",
      "method": "GET",
      "path": "/dql",
      "params": {
        "query": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "DQL query.",
          "example": "type:Organization locations.city.name:\"San Francisco\" nbEmployees>5000"
        },
        "type": {
          "in": "query",
          "type": "string",
          "description": "Query type (default query); crawl searches your custom crawl collections.",
          "enum": [
            "query",
            "crawl"
          ]
        },
        "col": {
          "in": "query",
          "type": "string",
          "description": "Comma-delimited custom crawl collections, or all; only with type=crawl."
        },
        "from": {
          "in": "query",
          "type": "integer",
          "description": "Offset; from+size must be at most 10,000 for facet queries. Deprecated for Article queries."
        },
        "size": {
          "in": "query",
          "type": "integer",
          "description": "Maximum results (default 50, -1 for all)."
        },
        "format": {
          "in": "query",
          "type": "string",
          "description": "Output format (default json).",
          "enum": [
            "json",
            "jsonl",
            "csv",
            "xls",
            "xlsx"
          ]
        },
        "filter": {
          "in": "query",
          "type": "string",
          "description": "Semicolon-separated paths to keep in the response, e.g. $.name;$.homepageUri."
        },
        "filterExclude": {
          "in": "query",
          "type": "string",
          "description": "Semicolon-separated paths to drop from the response."
        },
        "jsonmode": {
          "in": "query",
          "type": "string",
          "description": "extended returns origin information for facts; id returns only diffbotIds and origins.",
          "enum": [
            "extended",
            "id"
          ]
        },
        "nonCanonicalFacts": {
          "in": "query",
          "type": "boolean",
          "description": "Also return non-canonical facts."
        },
        "noDedupArticles": {
          "in": "query",
          "type": "boolean",
          "description": "Return all articles without deduplication."
        },
        "cluster": {
          "in": "query",
          "type": "string",
          "description": "Articles only: all, best or dedupe.",
          "enum": [
            "all",
            "best",
            "dedupe"
          ]
        },
        "report": {
          "in": "query",
          "type": "boolean",
          "description": "Generate a coverage report."
        }
      },
      "notes": [
        "Queries use Diffbot Query Language, e.g. type:Organization nbEmployees>5000. Check the DQL reference for current field names."
      ],
      "job": "company.search",
      "docs_url": "https://www.diffbot.com/docs/dql/get",
      "verified": {
        "docs": "https://www.diffbot.com/docs/dql/get"
      }
    },
    {
      "id": "diffbot.kg.search_post",
      "name": "Search the Knowledge Graph with DQL (POST)",
