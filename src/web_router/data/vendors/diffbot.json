          "description": "Semicolon-separated paths to drop from the response."
        },
        "jsonmode": {
          "in": "body",
          "type": "string",
          "description": "extended returns origin information for facts; id returns only diffbotIds and origins.",
          "enum": [
            "extended",
            "id"
          ]
        },
        "nonCanonicalFacts": {
          "in": "body",
