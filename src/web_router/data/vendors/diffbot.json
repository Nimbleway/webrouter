          "description": "Generate a coverage report."
        }
      },
      "notes": [
        "A read over POST: it only queries."
      ],
      "job": "company.search",
      "docs_url": "https://www.diffbot.com/docs/dql/post",
      "verified": {
        "docs": "https://www.diffbot.com/docs/dql/post"
      }
    },
    {
      "id": "diffbot.kg.enhance",
      "name": "Enhance a person or organization from partial data",
      "summary": "Finds the best matching Person or Organization record for partial input and returns it with a score.",
      "kind": "read",
      "method": "GET",
      "path": "/enhance",
      "params": {
        "type": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Entity type.",
          "enum": [
            "Person",
            "Organization"
          ]
        },
        "id": {
          "in": "query",
          "type": "string",
          "description": "DiffbotId of the entity."
        },
        "name": {
          "in": "query",
          "type": "array",
          "description": "Entity name(s)."
        },
        "url": {
          "in": "query",
          "type": "array",
          "description": "Homepage or origin URL(s)."
        },
        "phone": {
          "in": "query",
          "type": "string",
          "description": "Phone."
        },
        "email": {
          "in": "query",
          "type": "array",
          "description": "Email(s); Person only."
        },
        "employer": {
          "in": "query",
          "type": "string",
          "description": "Employer; Person only."
        },
        "title": {
          "in": "query",
          "type": "string",
          "description": "Job title; Person only."
        },
        "school": {
          "in": "query",
          "type": "string",
          "description": "School; Person only."
        },
        "location": {
          "in": "query",
          "type": "string",
          "description": "Location."
        },
        "description": {
          "in": "query",
          "type": "string",
          "description": "Description."
        },
        "ip": {
          "in": "query",
          "type": "string",
          "description": "IP address."
        },
        "customId": {
          "in": "query",
          "type": "string",
          "description": "Your own ID for correlation."
        },
        "size": {
          "in": "query",
          "type": "integer",
          "description": "Maximum results (default 1)."
        },
        "threshold": {
          "in": "query",
          "type": "number",
          "description": "Similarity threshold."
        },
        "refresh": {
          "in": "query",
          "type": "boolean",
          "description": "Recrawl the entity origins and rebuild the entity."
        },
        "search": {
          "in": "query",
          "type": "boolean",
          "description": "Also search the web for origins and merge them in."
        },
        "nonCanonicalFacts": {
          "in": "query",
          "type": "boolean",
          "description": "Also return non-canonical facts."
        },
        "jsonmode": {
          "in": "query",
          "type": "string",
          "description": "extended returns origin information for facts.",
          "enum": [
            "extended"
          ]
        },
        "filter": {
          "in": "query",
          "type": "string",
          "description": "Semicolon-separated paths to keep."
        },
        "filterExclude": {
          "in": "query",
          "type": "string",
          "description": "Semicolon-separated paths to drop."
        }
      },
      "notes": [
        "Works for both company and person lookups: set type to Organization or Person."
      ],
      "job": "company.enrich",
      "docs_url": "https://www.diffbot.com/docs/enhance/get",
      "verified": {
        "docs": "https://www.diffbot.com/docs/enhance/get"
      }
    },
