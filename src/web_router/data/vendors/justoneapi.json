{
  "vendor": "justoneapi",
  "name": "Just One API",
  "category": "social",
  "summary": "Social and e-commerce data from Chinese and global platforms: Xiaohongshu, Weibo, TikTok, Instagram and YouTube profiles, posts, comments and search.",
  "docs_url": "https://docs.justoneapi.com/en/usage",
  "base_url": "https://api.justoneapi.com",
  "auth": {
    "credentials": {
      "token": {
        "env": [
          "JUSTONEAPI_TOKEN"
        ],
        "description": "A Just One API access token (dashboard.justoneapi.com)"
      }
    },
    "inject": [
      {
        "in": "query",
        "name": "token",
        "value": "{token}"
      }
    ]
  },
  "notes": [
    "Every call is a GET with the token as a query parameter.",
    "Check the code field of the response body, not the HTTP status: 0 is success, 100 invalid token, 302 rate limit, 303 daily quota exceeded, 400 invalid parameters, 601 insufficient balance.",
    "Docs recommend a client timeout of 120 seconds (at least 60).",
    "Paging differs per endpoint: page, cursor, offset, paginationToken or nextToken.",
    "The full catalog has hundreds of endpoints (Douyin, Taobao, Bilibili and more); this file names the social ones."
  ],
  "sources": [
    "https://docs.justoneapi.com/en/usage",
    "https://docs.justoneapi.com/openapi.json"
  ],
  "curated": "2026-11-08",
  "endpoints": [
    {
      "id": "justoneapi.tiktok.profile",
      "name": "Get a TikTok profile",
      "summary": "Profile by username or secUid.",
      "kind": "read",
      "method": "GET",
      "path": "/api/tiktok/get-user-detail/v1",
      "params": {
        "uniqueId": {
          "in": "query",
          "type": "string",
          "description": "Public TikTok username."
        },
        "secUid": {
          "in": "query",
          "type": "string",
          "description": "TikTok's opaque user id (secUid), returned by the profile call."
        }
      },
      "job": "social.profile",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
    },
    {
      "id": "justoneapi.tiktok.posts",
      "name": "List a TikTok user's posts",
      "summary": "Posts by secUid, latest or most popular, paged by cursor.",
      "kind": "read",
      "method": "GET",
      "path": "/api/tiktok/get-user-post/v1",
      "params": {
        "secUid": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "TikTok's opaque user id (secUid), returned by the profile call."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Cursor from the previous response; '0' for the first page."
        },
        "sort": {
          "in": "query",
          "type": "string",
          "description": "Sort order.",
          "enum": [
            "LATEST",
            "MOST_POPULAR"
          ]
        }
      },
      "job": "social.posts",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
    },
    {
      "id": "justoneapi.tiktok.post",
      "name": "Get a TikTok post",
      "summary": "Details of one post by id.",
      "kind": "read",
      "method": "GET",
      "path": "/api/tiktok/get-post-detail/v1",
      "params": {
        "postId": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "TikTok post id."
        }
      },
      "job": "social.posts",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
    },
    {
      "id": "justoneapi.tiktok.comments",
      "name": "List comments on a TikTok post",
      "summary": "Comments of a post, paged by cursor.",
      "kind": "read",
      "method": "GET",
      "path": "/api/tiktok/get-post-comment/v1",
      "params": {
        "awemeId": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "TikTok post id."
        },
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Cursor from the previous response; '0' for the first page."
        }
      },
      "job": "social.comments",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
    },
    {
      "id": "justoneapi.tiktok.search",
      "name": "Search TikTok posts",
      "summary": "Posts by keyword with sort, time and region.",
      "kind": "read",
      "method": "GET",
      "path": "/api/tiktok/search-post/v1",
      "params": {
        "keyword": {
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Search keyword."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "description": "Offset, from 0 in steps of 20."
        },
        "sortType": {
          "in": "query",
          "type": "string",
          "description": "Sort order.",
          "enum": [
            "RELEVANCE",
            "MOST_LIKED"
          ]
        },
        "publishTime": {
          "in": "query",
          "type": "string",
          "description": "Publish-time filter.",
          "enum": [
            "ALL",
            "ONE_DAY",
            "ONE_WEEK",
            "ONE_MONTH",
            "THREE_MONTHS",
            "HALF_YEAR"
          ]
        },
        "region": {
          "in": "query",
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code."
        }
      },
      "job": "social.search",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
    },
