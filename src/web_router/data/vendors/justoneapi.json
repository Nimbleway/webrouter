    {
      "id": "justoneapi.youtube.search",
      "name": "Search YouTube videos",
      "summary": "Videos by keyword with language, date, duration and sort filters.",
      "kind": "read",
      "method": "GET",
      "path": "/api/youtube/search/v1",
      "params": {
        "keyword": {
          "in": "query",
          "type": "string",
          "description": "Search keyword."
        },
        "lang": {
          "in": "query",
          "type": "string",
          "description": "IETF language tag, e.g. en-US."
        },
        "uploadDate": {
          "in": "query",
          "type": "string",
          "description": "Upload-date filter.",
          "enum": [
            "all",
            "lastHour",
            "today",
            "thisWeek",
            "thisMonth",
            "thisYear"
          ]
        },
        "duration": {
          "in": "query",
          "type": "string",
          "description": "Duration filter.",
          "enum": [
            "all",
            "short",
            "medium",
            "long"
          ]
        },
        "sortBy": {
          "in": "query",
          "type": "string",
          "description": "Sort order.",
          "enum": [
            "relevance",
            "uploadDate",
            "viewCount",
            "rating"
          ]
        },
        "nextToken": {
          "in": "query",
          "type": "string",
          "description": "Token from the previous response; when set, keyword and filters are ignored."
        }
      },
      "job": "social.search",
      "docs_url": "https://docs.justoneapi.com/openapi.json",
      "verified": {
        "docs": "https://docs.justoneapi.com/openapi.json"
      }
